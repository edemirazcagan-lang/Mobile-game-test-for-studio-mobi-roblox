<ProtectedString name="Source"><![CDATA[-- Place this script inside a Script within your Boss character/model (ServerScript)
 
local character = script.Parent
local humanoid = character:WaitForChild("Humanoid")
local rootPart = character:WaitForChild("HumanoidRootPart")
 
--------------------------------------------------------------------------
-- CONFIGURATION (Change your damage numbers, Badge ID, and Range here!)
--------------------------------------------------------------------------
local BADGE_ID = 3687933751937139 -- Replace with your actual Roblox Badge ID
local AGGRO_RANGE = 45    -- How close players need to be for the boss to attack
 
-- Phase 1 Damage Values
local P1_DASH_THROW_DMG = 25
local P1_COAL_DMG = 15
local P1_STOMP_DMG = 35
 
-- Phase 2 Damage Values
local P2_MULTIPLE_DASH_DMG = 25
local P2_SNOW_DMG = 35
--------------------------------------------------------------------------
 
local maxHealth = humanoid.MaxHealth
local currentPhase = 1
 
-- Helper function to find the nearest player and return both the part and distance
local function getNearestPlayerInfo()
    local nearestPlayer = nil
    local shortestDistance = math.huge
    
    for _, player in ipairs(game.Players:GetPlayers()) do
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
            local distance = (rootPart.Position - char.HumanoidRootPart.Position).Magnitude
            if distance < shortestDistance then
                shortestDistance = distance
                nearestPlayer = char.HumanoidRootPart
            end
        end
    end
    
    return nearestPlayer, shortestDistance
end
 
-- Forced damage helper function
local function dealDamage(enemyHumanoid, damageAmount)
    if enemyHumanoid and enemyHumanoid.Health > 0 then
        enemyHumanoid:TakeDamage(damageAmount)
        print("Successfully dealt " .. damageAmount .. " damage!")
    end
end
 
-- Helper function to deal damage when parts touch players
local function applyDamageOnTouch(part, damage)
    local touchedConnection
    touchedConnection = part.Touched:Connect(function(hit)
        local enemyChar = hit.Parent
        local enemyHumanoid = enemyChar:FindFirstChild("Humanoid")
        
        if enemyHumanoid and enemyChar ~= character and not enemyChar:FindFirstChild("IsMinion") then
            dealDamage(enemyHumanoid, damage)
            if touchedConnection then
                touchedConnection:Disconnect()
            end
            part:Destroy()
        end
    end)
end
 
-- PHASE 1 ATTACKS
local function phase1DashAndThrow(target)
    print("Boss: Dash and Throw Part")
    if not target then return end
    
    local startPos = rootPart.Position
    local targetPos = Vector3.new(target.Position.X, rootPart.Position.Y, target.Position.Z)
    local direction = (targetPos - startPos).Unit
    
    for i = 1, 25 do
        rootPart.CFrame = rootPart.CFrame + (direction * 3)
        task.wait(0.02)
    end
    
    task.wait(0.3)
    local part = Instance.new("Part")
    part.Size = Vector3.new(2, 2, 2)
    part.Position = rootPart.Position + Vector3.new(0, 2, 0)
    part.BrickColor = BrickColor.new("Dark stone grey")
    part.CanCollide = true
    part.Parent = workspace
    
    applyDamageOnTouch(part, P1_DASH_THROW_DMG)
    
    local lookDir = (target.Position - part.Position).Unit
    local bv = Instance.new("BodyVelocity")
    bv.Velocity = (lookDir * 70) + Vector3.new(0, 5, 0)
    bv.MaxForce = Vector3.new(40000, 40000, 40000)
    bv.Parent = part
    
    game:GetService("Debris"):AddItem(part, 3)
end
 
local function phase1ThrowCoal(target)
    print("Boss: Throwing Coal")
    if not target then return end
    
    for i = 1, 3 do
        local coal = Instance.new("Part")
        coal.Size = Vector3.new(1.5, 1.5, 1.5)
        coal.Position = rootPart.Position + Vector3.new(0, 3, 0)
        coal.Material = Enum.Material.Slate
        coal.BrickColor = BrickColor.new("Black")
        coal.Shape = Enum.PartType.Ball
        coal.CanCollide = true
        coal.Parent = workspace
        
        applyDamageOnTouch(coal, P1_COAL_DMG)
        
        if target and target.Parent then
            local lookDir = (target.Position - coal.Position).Unit
            local bv = Instance.new("BodyVelocity")
            bv.Velocity = (lookDir * 60) + Vector3.new(0, 8, 0)
            bv.MaxForce = Vector3.new(30000, 30000, 30000)
            bv.Parent = coal
        end
        
        game:GetService("Debris"):AddItem(coal, 3)
        task.wait(0.3)
    end
end
 
local function phase1Stomp()
    print("Boss: Stomp Shockwave")
    local wave = Instance.new("Part")
    wave.Size = Vector3.new(4, 0.5, 4)
    wave.Position = rootPart.Position - Vector3.new(0, 2, 0)
    wave.Anchored = true
    wave.CanCollide = false
    wave.Transparency = 0.3
    wave.BrickColor = BrickColor.new("Medium blue")
    wave.Shape = Enum.PartType.Cylinder
    wave.Orientation = Vector3.new(0, 0, 90)
    wave.Parent = workspace
    
    local damagedPlayers = {}
    
    for i = 1, 30 do
        wave.Size = wave.Size + Vector3.new(0, 1.5, 1.5)
        
        for _, player in ipairs(game.Players:GetPlayers()) do
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
                if not damagedPlayers[player] then
                    local dist = (Vector3.new(wave.Position.X, 0, wave.Position.Z) - Vector3.new(char.HumanoidRootPart.Position.X, 0, char.HumanoidRootPart.Position.Z)).Magnitude
                    local currentRadius = wave.Size.Y / 2
                    if dist <= currentRadius + 2 then
                        dealDamage(char.Humanoid, P1_STOMP_DMG)
                        damagedPlayers[player] = true
                    end
                end
            end
        end
        
        task.wait(0.03)
    end
    wave:Destroy()
end
 
-- PHASE 2 ATTACKS
local function phase2MultipleDash()
    print("Boss: Multiple Dashes!")
    for i = 1, 3 do
        local target, _ = getNearestPlayerInfo()
        if target then
            local targetPos = Vector3.new(target.Position.X, rootPart.Position.Y, target.Position.Z)
            local direction = (targetPos - rootPart.Position).Unit
            for step = 1, 15 do
                rootPart.CFrame = rootPart.CFrame + (direction * 4)
                
                for _, player in ipairs(game.Players:GetPlayers()) do
                    local char = player.Character
                    if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
                        if (rootPart.Position - char.HumanoidRootPart.Position).Magnitude < 4 then
                            dealDamage(char.Humanoid, P2_MULTIPLE_DASH_DMG)
                        end
                    end
                end
                
                task.wait(0.01)
            end
        end
        task.wait(0.2)
    end
end
 
local function phase2SummonMinions()
    print("Boss: Summoning Minions")
    for i = 1, 2 do
        local minion = Instance.new("Part")
        minion.Size = Vector3.new(2, 4, 2)
        minion.Position = rootPart.Position + Vector3.new(math.random(-6, 6), 0, math.random(-6, 6))
        minion.BrickColor = BrickColor.new("Bright blue")
        
        local tag = Instance.new("BoolValue")
        tag.Name = "IsMinion"
        tag.Parent = minion
        
        local minionHumanoid = Instance.new("Humanoid")
        minionHumanoid.MaxHealth = 30
        minionHumanoid.Health = 30
        
        minion.Parent = workspace
        minionHumanoid.Parent = minion
    end
end
 
local function phase2ThrowSnow(target)
    print("Boss: Throwing Piled Snow")
    if not target then return end
    
    local snow = Instance.new("Part")
    snow.Size = Vector3.new(4, 3, 4)
    snow.Position = rootPart.Position + Vector3.new(0, 2, 0)
    snow.Material = Enum.Material.Snow
    snow.BrickColor = BrickColor.new("Institutional white")
    snow.CanCollide = true
    snow.Parent = workspace
    
    applyDamageOnTouch(snow, P2_SNOW_DMG)
    
    local lookDir = (target.Position - snow.Position).Unit
    local bv = Instance.new("BodyVelocity")
    bv.Velocity = (lookDir * 45) + Vector3.new(0, 4, 0)
    bv.MaxForce = Vector3.new(40000, 40000, 40000)
    bv.Parent = snow
    
    game:GetService("Debris"):AddItem(snow, 4)
end
 
-- BADGE REWARD FUNCTION
local BadgeService = game:GetService("BadgeService")
 
local function awardBadgeToPlayers()
    for _, player in ipairs(game.Players:GetPlayers()) do
        pcall(function()
            if not BadgeService:UserHasBadgeAsync(player.UserId, BADGE_ID) then
                BadgeService:AwardBadge(player.UserId, BADGE_ID)
                print("Awarded badge to " .. player.Name)
            end
        end)
    end
end
 
-- BOSS FIGHT LOOP WITH AGGRO RANGE CHECK
task.spawn(function()
    while humanoid.Health > 0 do
        local target, distance = getNearestPlayerInfo()
        
        -- Check if a player is within range before attacking
        if target and distance <= AGGRO_RANGE then
            if currentPhase == 1 and humanoid.Health <= (maxHealth / 2) then
                currentPhase = 2
                print("BOSS HAS ENTERED PHASE 2!")
                humanoid.WalkSpeed = humanoid.WalkSpeed + 4
            end
            
            if currentPhase == 1 then
                local choice = math.random(1, 3)
                if choice == 1 then
                    phase1DashAndThrow(target)
                elseif choice == 2 then
                    phase1ThrowCoal(target)
                else
                    phase1Stomp()
                end
                task.wait(3)
            else
                local choice = math.random(1, 3)
                if choice == 1 then
                    phase2MultipleDash()
                elseif choice == 2 then
                    phase2SummonMinions()
                else
                    phase2ThrowSnow(target)
                end
                task.wait(2)
            end
        else
            -- Boss waits until a player steps into the aggro range
            task.wait(1)
        end
    end
    
    print("Boss Defeated!")
    awardBadgeToPlayers()
    character:Destroy()
end)

]]></ProtectedString>
