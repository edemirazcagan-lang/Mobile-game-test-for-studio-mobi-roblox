<string name="Name">TouchDamageOrHealScript</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[----------------------------------------------------------------------------------------
--TouchDamageOrHealScript  -  When this script's parent part is touched, the player   --
--     will either lose or gain health by the amount you put in the script below.     --
--                                            By ScottSpiritWalker, 02/03/2023.       --
----------------------------------------------------------------------------------------
 
local Debris = game:GetService("Debris")  --Roblox utility to destroy unneeded objects.  
 
script.Parent.Touched:connect(function(hit)    --The code below is triggered when a player touches the parent part. 
    
    local player = game.Players:GetPlayerFromCharacter(hit.Parent)
    if player and player.Character then
        if not player:FindFirstChild("AlreadyTouchedHealth") then
            local db = Instance.new("StringValue")    --Create a value object in the player to indicate that this player already touched it.
            db.Name = "AlreadyTouchedHealth"          --This will prevent another touch by the same player before the current code is finished.
            db.Parent = player                        --We remove this object at the end of this code so the player can touch again.
            local humanoid = hit.Parent:WaitForChild("Humanoid",1)
            if humanoid then
                humanoid.Health = humanoid.Health  -20   --Add 20 to the player's health (100 is considered full health).
            end                                          --Or you can subtract 20 (or some other amount) to take damage.
            Debris:AddItem(db,4)     --Four second cooldown before this player can touch it again.
        end
    end
end)

]]></ProtectedString>
