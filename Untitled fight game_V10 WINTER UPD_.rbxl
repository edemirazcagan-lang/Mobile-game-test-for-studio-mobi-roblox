<Item class="Script" referent="RBX66C1625455D04AC580D8114653513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">BadgeWord</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local BadgeService = game:GetService("BadgeService")
local SoundService = game:GetService("SoundService")
 
local BADGE_ID = 1307618877192600
local SOUND_ID = "rbxassetid://83415010798718"
local TRIGGER_WORD = "Proceed"
 
-- Create the sound in SoundService
local chatSound = Instance.new("Sound")
chatSound.SoundId = SOUND_ID
chatSound.Parent = SoundService
 
Players.PlayerAdded:Connect(function(player)
    player.Chatted:Connect(function(message)
        -- Print to Output so you can verify it detects your message
        print(player.Name .. " said: " .. message)
        
        if message:lower() == TRIGGER_WORD:lower() then
            print("Trigger word matched! Playing sound and awarding badge...")
            
            -- 1. Play the sound
            chatSound:Play()
            
            -- 2. Award the badge safely
            local success, err = pcall(function()
                BadgeService:AwardBadge(player.UserId, BADGE_ID)
            end)
            
            if not success then
                warn("Badge error: " .. tostring(err))
            end
        end
    end)
end)

]]></ProtectedString>
