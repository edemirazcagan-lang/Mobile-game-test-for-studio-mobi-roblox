<Item class="Script" referent="RBX66C1625455D04AC580D8100071513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local proximityPrompt = script.Parent:WaitForChild("ProximityPrompt")

local isActivated = false
local deletedPartsStorage = {} -- Temporary storage to hold parts so they can be restored
local deletionConnection = nil

-- Configuration
local DAMAGE_INTERVAL = 5 -- How often NPCs take damage (in seconds)
local DAMAGE_AMOUNT = 1000000    -- How much damage NPCs take per interval
local DELETION_INTERVAL = 0.2 -- How fast parts get deleted

-- Function to handle damaging everything EXCEPT players
local function damageNonPlayers()
    while isActivated do
        for _, object in ipairs(workspace:GetDescendants()) do
            -- Check if the object is a Humanoid (belongs to a character/NPC)
            if object:IsA("Humanoid") then
                local character = object.Parent
                -- Ensure this humanoid does not belong to a real player
                if character and not game.Players:GetPlayerFromCharacter(character) then
                    object:TakeDamage(DAMAGE_AMOUNT)
                end
            end
        end
        task.wait(DAMAGE_INTERVAL)
    end
end

-- Function to continuously delete random parts of the map
local function startDeletingParts()
    deletionConnection = task.spawn(function()
        while isActivated do
            local potentialParts = {}
            
            -- Gather all eligible parts in the workspace
            for _, object in ipairs(workspace:GetDescendants()) do
                if object:IsA("BasePart") 
                    and not object:IsDescendantOf(script.Parent) -- Don't delete the trigger button
                    and not object.Parent:FindFirstChildOfClass("Humanoid") -- Don't delete player/NPC body parts
                    and object.CanCollide -- Optional: Only delete structural parts, ignoring effects/spawns
                    then
                    table.insert(potentialParts, object)
                end
            end
            
            -- If there are parts left to delete, pick a random one
            if #potentialParts > 0 then
                local randomPart = potentialParts[math.random(1, #potentialParts)]
                
                -- Save its original parent so we can put it back later
                deletedPartsStorage[randomPart] = randomPart.Parent
                randomPart.Parent = nil -- Hidden/Deleted safely without destroying the instance
            end
            
            task.wait(DELETION_INTERVAL)
        end
    end)
end

-- Function to restore all deleted parts
local function restoreParts()
    for part, originalParent in pairs(deletedPartsStorage) do
        if part and originalParent then
            part.Parent = originalParent
        end
    end
    table.clear(deletedPartsStorage) -- Clear the cache
end

-- Main trigger event
proximityPrompt.Triggered:Connect(function(player)
    isActivated = not isActivated -- Toggle the state
    
    if isActivated then
        proximityPrompt.ActionText = "Stop Destruction"
        
        -- Start the damaging loop in a separate thread
        task.spawn(damageNonPlayers)
        -- Start the deletion loop
        startDeletingParts()
    else
        proximityPrompt.ActionText = "Start Destruction"
        
        -- Setting isActivated to false breaks the loops, now we restore the map
        if deletionConnection then
            task.cancel(deletionConnection)
        end
        restoreParts()
    end
end)

]]></ProtectedString>
