<Item class="Script" referent="RBX66C1625455D04AC580D8117441513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local AttackEvent = Tool:WaitForChild("AttackEvent")
 
-- Configuration
local DAMAGE = 240
local STUN_DURATION = 3.5
local REACH_DISTANCE = 10 -- How far the attack reaches
local ATTACK_COOLDOWN = 3
 
-- Track cooldowns on the server to prevent exploits
local serverCooldowns = {}
 
-- Function to stun a character
local function applyStun(humanoid)
    -- Store original stats
    local originalSpeed = humanoid.WalkSpeed
    local originalJump = humanoid.JumpPower
    local usedJumpPower = humanoid.UseJumpPower -- Check if game uses JumpHeight or JumpPower
    
    -- Apply Stun
    humanoid.WalkSpeed = 0
    if usedJumpPower then
        humanoid.JumpPower = 0
    else
        humanoid.JumpHeight = 0
    end
    
    -- Wait and Restore
    task.delay(STUN_DURATION, function()
        if humanoid and humanoid.Parent then
            humanoid.WalkSpeed = originalSpeed
            if usedJumpPower then
                humanoid.JumpPower = originalJump
            else
                humanoid.JumpHeight = originalJump
            end
        end
    end)
end
 
-- Listen for the client attack trigger
AttackEvent.OnServerEvent:Connect(function(player)
    local character = player.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    
    if not hrp then return end
    
    -- Server-side cooldown validation
    local currentTime = os.clock()
    if serverCooldowns[player] and (currentTime - serverCooldowns[player] < ATTACK_COOLDOWN - 0.1) then
        return
    end
    serverCooldowns[player] = currentTime
    
    -- Create a simple spatial hitbox in front of the player
    local overlapParams = OverlapParams.new()
    overlapParams.FilterDescendantsInstances = {character} -- Don't hit yourself
    overlapParams.FilterType = Enum.RaycastFilterType.Exclude
    
    -- Position the hitbox slightly in front of the player
    local hitboxPosition = hrp.Position + (hrp.CFrame.LookVector * (REACH_DISTANCE / 2))
    local hitParts = game.Workspace:GetPartBoundsInBox(CFrame.new(hitboxPosition), Vector3.new(REACH_DISTANCE, 5, REACH_DISTANCE), overlapParams)
    
    -- Track characters hit this swing so we don't multi-hit the same target
    local hitCharacters = {}
    
    for _, part in ipairs(hitParts) do
        local targetChar = part.Parent
        local targetHumanoid = targetChar:FindFirstChildOfClass("Humanoid")
        
        if targetHumanoid and targetHumanoid.Health > 0 and not hitCharacters[targetChar] then
            hitCharacters[targetChar] = true
            
            -- Apply Damage
            targetHumanoid:TakeDamage(DAMAGE)
            
            -- Apply Stun
            applyStun(targetHumanoid)
            
            -- Break if you only want to hit one target per click
            break 
        end
    end
end)
 
-- Clean up cooldown table when players leave
game.Players.PlayerRemoving:Connect(function(player)
    serverCooldowns[player] = nil
end)

]]></ProtectedString>
