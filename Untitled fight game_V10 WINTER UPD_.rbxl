<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454115447AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">LocalScript3</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local tool = script.Parent

local ACTION_NAME = "TimeStopAction"
local IS_TIME_STOPPED = false
local COOLDOWN = false
local COOLDOWN_TIME = 10 -- Seconds before you can use it again
local DURATION = 5 -- How long the time stop lasts

-- Store anchors states to restore them properly later
local anchoredParts = {}

-- Function to apply visual effects (Color Correction)
local function applyVisualEffect(isStopping)
    local lighting = game:GetService("Lighting")
    local cc = lighting:FindFirstChild("TimeStopCC") or Instance.new("ColorCorrectionEffect")
    cc.Name = "TimeStopCC"
    cc.Parent = lighting
    
    local targetSaturation = isStopping and -1 or 0
    local targetContrast = isStopping and 0.5 or 0
    
    local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tween = TweenService:Create(cc, tweenInfo, {
    Saturation = targetSaturation,
    Contrast = targetContrast
    })
    tween:Play()
end

-- Core Time Stop Logic
local function toggleTimeStop()
    if COOLDOWN then return end
    COOLDOWN = true
    IS_TIME_STOPPED = true
    
    applyVisualEffect(true)
    
    -- Freeze all parts in the workspace except the local player
    for _, desc in ipairs(Workspace:GetDescendants()) do
        if desc:IsA("BasePart") and not desc:IsDescendantOf(player.Character) then
            -- Save original anchored state if not already saved
            if anchoredParts[desc] == nil then
                anchoredParts[desc] = desc.Anchored
            end
            desc.Anchored = true
        end
    end
    
    -- Wait for duration
    task.wait(DURATION)
    
    -- Resume Time
    IS_TIME_STOPPED = false
    applyVisualEffect(false)
    
    for part, originalAnchored in pairs(anchoredParts) do
        if part and part.Parent then
            part.Anchored = originalAnchored
        end
    end
    table.clear(anchoredParts)
    
    -- Cooldown period
    task.wait(COOLDOWN_TIME)
    COOLDOWN = false
end

-- Handle the input across all devices
local function handleAction(actionName, inputState, inputObject)
    if inputState == Enum.UserInputState.Begin then
        toggleTimeStop()
    end
end

-- Bind action when tool is equipped
tool.Equipped:Connect(function()
    -- This binds Key 'E', Controller Button 'B', and automatically creates a Mobile Button
    ContextActionService:BindAction(
    ACTION_NAME, 
    handleAction, 
    true, -- true creates an on-screen button for mobile users
    Enum.KeyCode.E, 
    Enum.KeyCode.ButtonB
    )
    
    -- Optional: Style the mobile button
    local button = ContextActionService:GetButton(ACTION_NAME)
    if button then
        button.Title = "Time Stop"
        button.Size = UDim2.new(0, 60, 0, 60)
    end
end)

-- Unbind action when tool is unequipped
tool.Unequipped:Connect(function()
    ContextActionService:UnbindAction(ACTION_NAME)
end)

]]></ProtectedString>
<UniqueId name="UniqueId">7bdf20b295fbe64d068941544800437f</UniqueId>
</Properties>
