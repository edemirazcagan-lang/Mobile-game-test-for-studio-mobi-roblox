<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454115037AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">LocalScript</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SpikeEvent = Tool:WaitForChild("SpikeEvent")
 
local ACTION_NAME = "SummonSpikesAbility"
 
-- This function runs when the player presses the key/button
local function onActivate(actionName, inputState, inputObject)
    if inputState == Enum.UserInputState.Begin then
        SpikeEvent:FireServer() -- Tell the server to activate the ability
    end
end
 
-- Bind the action when equipped
Tool.Equipped:Connect(function()
    -- Binds to 'E' on PC, ButtonR2 on Console, and creates a virtual button for Mobile
    ContextActionService:BindAction(
    ACTION_NAME, 
    onActivate, 
    true, -- Creates a touch button for mobile automatically
    Enum.KeyCode.E, 
    Enum.KeyCode.ButtonR2
    )
    
    -- Optional: Customize the mobile button text
    ContextActionService:SetTitle(ACTION_NAME, "Spikes")
end)
 
-- Unbind the action when unequipped so it doesn't trigger accidentally
Tool.Unequipped:Connect(function()
    ContextActionService:UnbindAction(ACTION_NAME)
end)

]]></ProtectedString>
