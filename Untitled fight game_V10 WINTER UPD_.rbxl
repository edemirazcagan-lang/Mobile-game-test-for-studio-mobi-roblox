<Item class="Script" referent="RBX66C1625455D04AC580D8114631513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">ks</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local BadgeService = game:GetService("BadgeService")
local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")

-- CONFIGURATION: Change these to match your game
local BADGE_ID = 2349048670284733 -- Replace with your actual Badge ID
local TOOL_NAME = "Killstreak Sword" -- Replace with the exact name of your Tool in ServerStorage

-- Function to safely check badge ownership and give the tool
local function checkAndGiveTool(player)
    -- Safely call BadgeService using pcall so network errors don't crash the script
    local success, hasBadge = pcall(function()
        return BadgeService:UserHasBadgeAsync(player.UserId, BADGE_ID)
    end)
    
    if success and hasBadge then
        local toolTemplate = ServerStorage:FindFirstChild(TOOL_NAME)
        
        if toolTemplate then
            -- Wait for the player's Backpack to load before cloning the tool
            local backpack = player:WaitForChild("Backpack")
            local toolClone = toolTemplate:Clone()
            toolClone.Parent = backpack
        else
            warn("Tool named '" .. TOOL_NAME .. "' was not found in ServerStorage!")
        end
    elseif not success then
        warn("Failed to check badge for " .. player.Name .. ": " .. tostring(hasBadge))
    end
end

-- Run the check every time a player's character spawns/respawns
Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function()
        checkAndGiveTool(player)
    end)
end)

]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8146320041fa</UniqueId>
</Properties>
</Item>
<Item class="Script" referent="RBX66C1625455D04AC580D8114633513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Oghead</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[-- Place this Script in ServerScriptService
 
local Players = game:GetService("Players")
 
local function applyClassicHead(character)
    -- Wait for the head to exist
    local head = character:WaitForChild("Head", 5)
    if not head then return end
 
    -- Remove Dynamic Head meshes / WrapLayer instances inside the head
    for _, child in ipairs(head:GetChildren()) do
        if child:IsA("MeshPart") or child:IsA("WrapLayer") or child:IsA("SpecialMesh") then
            child:Destroy()
        end
    end
 
    -- Optional: If the Head itself is a MeshPart (common for dynamic heads),
    -- you can replace it or clear its MeshId/TextureID to restore classic shape.
    -- For custom rigs/characters, attaching a standard SpecialMesh ensures a classic shape:
    if not head:FindFirstChildOfClass("SpecialMesh") then
        local mesh = Instance.new("SpecialMesh")
        mesh.MeshType = Enum.MeshType.Head
        mesh.Scale = Vector3.new(1.25, 1.25, 1.25) -- Standard Roblox head scale
        mesh.Parent = head
    end
end
 
local function onPlayerAdded(player)
    player.CharacterAdded:Connect(function(character)
        applyClassicHead(character)
    end)
    
    -- In case the character loaded before the script ran
    if player.Character then
        applyClassicHead(player.Character)
    end
end
 
Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in ipairs(Players:GetPlayers()) do
    onPlayerAdded(player)
end

]]></ProtectedString>
