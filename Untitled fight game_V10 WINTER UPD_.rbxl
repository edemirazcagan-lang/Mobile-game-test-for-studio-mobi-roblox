<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local BadgeService = game:GetService("BadgeService")
local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")

-- Replace with the badge ID from the other game
local targetBadgeId = 966922810841584 
-- Replace with the exact name of your tool located in ServerStorage
local rewardToolName = "Killstreak Sword" 

Players.PlayerAdded:Connect(function(player)
    -- Use pcall to safely handle any API connection errors
    local success, hasBadge = pcall(function()
        return BadgeService:UserHasBadgeAsync(player.UserId, targetBadgeId)
    end)
    
    if success and hasBadge then
        local toolTemplate = ServerStorage:FindFirstChild(rewardToolName)
        if toolTemplate then
            -- Give the tool to the player's backpack
            local clonedTool = toolTemplate:Clone()
            clonedTool.Parent = player.Backpack
            
            -- Optional: Add it to StarterGear so they keep it when they respawn
            local starterGear = player:FindFirstChild("StarterGear")
            if starterGear then
                toolTemplate:Clone().Parent = starterGear
            end
        else
            warn("Reward tool not found in ServerStorage: " .. rewardToolName)
        end
    elseif not success then
        warn("Failed to check badge ownership for player: " .. player.Name)
    end
end)

]]></ProtectedString>
