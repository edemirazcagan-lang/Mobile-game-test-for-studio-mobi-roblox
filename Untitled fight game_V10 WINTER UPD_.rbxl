<Item class="Script" referent="RBX66C1625455D04AC580D8115043513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script2</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[-- Server Script inside the Tool (Separate from the trail script)
local Tool = script.Parent
local Players = game:GetService("Players")

-- CONFIGURATION
local TANK_THRESHOLD = 450    -- The max damage the tool can completely "tank" (block)
local SPEED_REWARD = 37      -- How fast the player becomes if hit harder than the threshold
local SPEED_DURATION = 10     -- How many seconds the speed boost lasts
local DEFAULT_SPEED = 19     -- Normal Roblox walking speed

local isHolding = false
local humanoidConnection = nil
local speedActive = false

-- Function to handle the custom damage logic
local function setupDefense(character)
    local humanoid = character:WaitForChild("Humanoid")
    
    -- Disconnect any old connections just in case
    if humanoidConnection then humanoidConnection:Disconnect() end
    
    -- We track the player's health manually to intercept damage
    local lastHealth = humanoid.Health
    
    humanoidConnection = humanoid.HealthChanged:Connect(function(currentHealth)
        -- Only run if the tool is being held and health actually decreased
        if isHolding and currentHealth < lastHealth then
            local damageTaken = lastHealth - currentHealth
            
            if damageTaken <= TANK_THRESHOLD then
                -- TANKED: Restore the lost health completely
                humanoid.Health = lastHealth
            else
                -- OVER THRESHOLD: Player takes the damage, but gets a speed reward
                if not speedActive then
                    task.spawn(function()
                        speedActive = true
                        humanoid.WalkSpeed = SPEED_REWARD
                        
                        task.wait(SPEED_DURATION)
                        
                        -- Reset to default speed if they are still alive/holding it
                        if humanoid and humanoid.Parent then
                            humanoid.WalkSpeed = DEFAULT_SPEED
                        end
                        speedActive = false
                    end)
                end
            end
        end
        -- Keep track of the current health for the next hit
        lastHealth = humanoid.Health
    end)
end

-- Detect when the tool is equipped
Tool.Equipped:Connect(function()
    local character = Tool.Parent
    if character then
        isHolding = true
        setupDefense(character)
    end
end)

-- Detect when the tool is unequipped
Tool.Unequipped:Connect(function()
    isHolding = false
    
    -- Clean up connection
    if humanoidConnection then
        humanoidConnection:Disconnect()
        humanoidConnection = nil
    end
    
    -- Reset speed if they unequip while the buff is active
    local character = Tool.Parent.Parent:FindFirstChild(Tool.Parent.Name) or Tool.Parent
    if character then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.WalkSpeed = DEFAULT_SPEED
        end
    end
end)

]]></ProtectedString>
