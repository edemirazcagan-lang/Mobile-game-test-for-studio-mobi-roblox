<Item class="Script" referent="RBX66C1625455D04AC580D8101345513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local billboardGui = script.Parent
local bossModel = billboardGui.Parent.Parent -- Adjust if your Gui is placed differently
local humanoid = bossModel:WaitForChild("Humanoid")

local background = billboardGui:WaitForChild("Background")
local healthBar = background:WaitForChild("HealthBar")
local percentText = billboardGui:WaitForChild("PercentText")

-- Define your colors here (RGB format)
local COLOR_HIGH   = Color3.fromRGB(0, 255, 0)   -- Green (above 75%)
local COLOR_MED    = Color3.fromRGB(255, 200, 0) -- Yellow/Orange (below 75%)
local COLOR_LOW    = Color3.fromRGB(255, 100, 0) -- Dark Orange (below 50%)
local COLOR_CRIT   = Color3.fromRGB(255, 0, 0)   -- Red (below 25%)

local function updateHealthBar()
    -- Calculate health ratio (0 to 1) and percentage (0 to 100)
    local healthRatio = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
    local percent = math.floor(healthRatio * 100)
    
    -- Update the text display
    percentText.Text = percent .. "%"
    
    -- Determine the color based on health percentage thresholds
    local targetColor = COLOR_HIGH
    if percent <= 25 then
        targetColor = COLOR_CRIT
    elseif percent <= 50 then
        targetColor = COLOR_LOW
    elseif percent <= 75 then
        targetColor = COLOR_MED
    end
    
    -- Smoothly animate the health bar size change
    healthBar:TweenSize(
    UDim2.new(healthRatio, 0, 1, 0),
    Enum.EasingDirection.Out,
    Enum.EasingStyle.Quad,
    0.2,
    true
    )
    
    -- Update the bar color instantly (or you can use TweenService if you want the color to fade)
    healthBar.BackgroundColor3 = targetColor
end

-- Listen for health updates
humanoid.HealthChanged:Connect(updateHealthBar)

-- Run once at start to initialize UI
updateHealthBar()

]]></ProtectedString>
