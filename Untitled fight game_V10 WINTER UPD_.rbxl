<Item class="Script" referent="RBX66C1625455D04AC580D8112409513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script3</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[-- Settings
local DETECTION_RANGE = 30 -- How close the player needs to be (in studs)
local DASH_SPEED = 120      -- Speed of the dash
local DASH_DURATION = 0.25  -- How long the dash lasts (seconds)
local COOLDOWN_TIME = 4.0   -- Time between attacks (seconds)
local SWORD_OFFSET = 4      -- How many studs in front of the boss the sword spawns

-- Object References
local bossModel = script.Parent
local rootPart = bossModel:WaitForChild("HumanoidRootPart")
local humanoid = bossModel:WaitForChild("Humanoid")
local swordTemplate = game.Workspace:WaitForChild("BossSword")

-- State Variables
local isCoolingDown = false

-- Function to find the nearest player within range and line-of-sight
local function findTargetPlayer()
    local nearestPlayer = nil
    local shortestDistance = DETECTION_RANGE
    
    for _, player in ipairs(game.Players:GetPlayers()) do
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local targetRoot = player.Character.HumanoidRootPart
            local distance = (rootPart.Position - targetRoot.Position).Magnitude
            
            if distance < shortestDistance then
                -- Optional: Raycast to ensure line of sight (not shooting through walls)
                local raycastParams = RaycastParams.new()
                raycastParams.FilterDescendantsInstances = {bossModel}
                raycastParams.FilterType = Enum.RaycastFilterType.Exclude
                
                local rayDirection = (targetRoot.Position - rootPart.Position)
                local raycastResult = game.Workspace:Raycast(rootPart.Position, rayDirection, raycastParams)
                
                -- If it hits nothing or hits the player's character directly
                if not raycastResult or raycastResult.Instance:IsDescendantOf(player.Character) then
                    shortestDistance = distance
                    nearestPlayer = player.Character
                end
            end
        end
    end
    return nearestPlayer
end

-- Function to handle the sword throwing mechanics
local function throwSword(facingDirection)
    -- Clone the premade sword from Workspace
    local swordClone = swordTemplate:Clone()
    
    -- Calculate position slightly in front of the boss to prevent getting stuck
    local spawnPosition = rootPart.Position + (facingDirection * SWORD_OFFSET)
    
    -- Position and orient the sword
    if swordClone:IsA("Model") then
        if not swordClone.PrimaryPart then
            swordClone.PrimaryPart = swordClone:FindFirstChildWhichIsA("BasePart")
        end
        swordClone:SetPrimaryPartCFrame(CFrame.lookAt(spawnPosition, spawnPosition + facingDirection))
    elseif swordClone:IsA("BasePart") then
        swordClone.CFrame = CFrame.lookAt(spawnPosition, spawnPosition + facingDirection)
    end
    
    swordClone.Parent = game.Workspace
    
    -- Add movement to the sword (Using LinearVelocity for physics-based movement)
    local mainPart = swordClone:IsA("Model") and swordClone.PrimaryPart or swordClone
    
    local attachment = Instance.new("Attachment")
    attachment.Parent = mainPart
    
    local linearVelocity = Instance.new("LinearVelocity")
    linearVelocity.MaxForce = math.huge
    linearVelocity.VectorVelocity = facingDirection * 80 -- Sword speed
    linearVelocity.Attachment0 = attachment
    linearVelocity.Parent = mainPart
    
    -- Clean up the sword after 5 seconds if it doesn't hit anything
    game:GetService("Debris"):AddItem(swordClone, 5)
end

-- Function to handle the dash and attack sequence
local function performAttackSequence()
    isCoolingDown = true
    
    -- Determine the direction the boss is currently facing
    local facingDirection = rootPart.CFrame.LookVector
    
    -- 1. Throw the sword
    throwSword(facingDirection)
    
    -- 2. Execute the Dash using LinearVelocity
    local attachment = Instance.new("Attachment")
    attachment.Parent = rootPart
    
    local dashVelocity = Instance.new("LinearVelocity")
    dashVelocity.MaxForce = math.huge
    dashVelocity.VectorVelocity = facingDirection * DASH_SPEED
    dashVelocity.Attachment0 = attachment
    dashVelocity.Parent = rootPart
    
    -- Wait for the dash duration to finish, then stop the force
    task.wait(DASH_DURATION)
    dashVelocity:Destroy()
    attachment:Destroy()
    
    -- 3. Handle Cooldown
    task.wait(COOLDOWN_TIME - DASH_DURATION)
    isCoolingDown = false
end

-- Main AI Loop
task.spawn(function()
    while true do
        task.wait(0.1) -- Small delay to prevent crashing the script
        
        if not isCoolingDown and humanoid.Health > 0 then
            local target = findTargetPlayer()
            
            if target then
                -- Rotate boss to face target briefly before locking in the dash direction
                local targetRoot = target:FindFirstChild("HumanoidRootPart")
                if targetRoot then
                    local targetPosition = Vector3.new(targetRoot.Position.X, rootPart.Position.Y, targetRoot.Position.Z)
                    rootPart.CFrame = CFrame.lookAt(rootPart.Position, targetPosition)
                    
                    -- Trigger attack
                    performAttackSequence()
                end
            end
        end
    end
end)

]]></ProtectedString>
