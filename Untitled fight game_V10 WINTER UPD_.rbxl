<Item class="Script" referent="RBX66C1625455D04AC580D8100791513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">true</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local waterPart = script.Parent

-- Configuration
local DROWN_TIME = 10 -- Seconds a player can stay submerged before drowning
local DROWN_DAMAGE = 15 -- Damage dealt per tick
local SWIM_SPEED = 16 -- How fast they move in water
local BUOYANCY_FORCE = 1.2 -- Higher = float faster, Lower = sink more

-- Keep track of players currently in the water
local playersInWater = {}

local function onTouch(otherPart)
    local character = otherPart.Parent
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    
    if humanoid and rootPart and not playersInWater[character] then
        playersInWater[character] = true
        
        -- Slow down normal walking speed for swimming
        humanoid.WalkSpeed = SWIM_SPEED
        humanoid:ChangeState(Enum.HumanoidStateType.Swimming)
        
        -- Create an attachment for the force if it doesn't exist
        local attachment = rootPart:FindFirstChild("WaterAttachment") or Instance.new("Attachment")
        attachment.Name = "WaterAttachment"
        attachment.Parent = rootPart
        
        -- Create LinearVelocity to give them a floaty, swimming physics feel
        local linearVelocity = Instance.new("LinearVelocity")
        linearVelocity.Name = "WaterVelocity"
        linearVelocity.Attachment0 = attachment
        linearVelocity.MaxForce = math.huge
        linearVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
        linearVelocity.VectorVelocity = Vector3.new(0, BUOYANCY_FORCE, 0)
        linearVelocity.Parent = rootPart
        
        -- Start the drowning and swimming logic loop
        task.spawn(function()
            local airTimer = 0
            
            while playersInWater[character] and humanoid.Health > 0 do
                task.wait(1)
                
                local head = character:FindFirstChild("Head")
                if head then
                    -- Check if head is below water surface
                    local isSubmerged = head.Position.Y < (waterPart.Position.Y + (waterPart.Size.Y / 2))
                    
                    if isSubmerged then
                        airTimer = airTimer + 1
                        if airTimer >= DROWN_TIME then
                            humanoid:TakeDamage(DROWN_DAMAGE)
                        end
                    else
                        airTimer = 0 -- Reset timer if they surface
                    end
                end
            end
        end)
    end
end

local function onTouchEnded(otherPart)
    local character = otherPart.Parent
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    
    if humanoid and playersInWater[character] then
        playersInWater[character] = nil
        
        -- Reset speed back to default Roblox speed (usually 16)
        humanoid.WalkSpeed = 16
        humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        
        -- Clean up the physics forces so they fall/walk normally again
        if rootPart then
            local velocity = rootPart:FindFirstChild("WaterVelocity")
            local attachment = rootPart:FindFirstChild("WaterAttachment")
            if velocity then velocity:Destroy() end
            if attachment then attachment:Destroy() end
        end
    end
end

waterPart.Touched:Connect(onTouch)
waterPart.TouchEnded:Connect(onTouchEnded)

]]></ProtectedString>
