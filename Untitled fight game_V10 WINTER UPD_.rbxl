<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local boss = script.Parent
local humanoid = boss:WaitForChild("Humanoid")
 
-- Configuration
local HEAL_AMOUNT = 45      -- How much health to restore each time
local HEAL_INTERVAL = 1     -- How many seconds between each heal
local HEAL_THRESHOLD = 0.8  -- Starts healing only when below 80% max health
 
while true do
    task.wait(HEAL_INTERVAL)
    
    -- Check if the boss is still alive
    if humanoid.Health > 0 then
        -- Optional: Only heal if health drops below a certain percentage
        if humanoid.Health < (humanoid.MaxHealth * HEAL_THRESHOLD) then
            
            -- Calculate new health, ensuring it doesn't exceed MaxHealth
            local newHealth = humanoid.Health + HEAL_AMOUNT
            humanoid.Health = math.min(newHealth, humanoid.MaxHealth)
            
            
        end
    else
        -- Stop the script if the boss is defeated
        break
    end
end

]]></ProtectedString>
