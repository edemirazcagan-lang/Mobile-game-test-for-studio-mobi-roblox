<Item class="Script" referent="RBX66C1625455D04AC580D8114643513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">ParryToolScript</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[-- Script inside ServerScriptService
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ParryEvent = ReplicatedStorage:WaitForChild("ParryEvent")

-- Table to track which players are currently in their parry window
local activeParries = {}

-- Handle Parry Window States from Clients
ParryEvent.OnServerEvent:Connect(function(player, state)
    if state == "StartParry" then
        activeParries[player.UserId] = true
    elseif state == "StopParry" then
        activeParries[player.UserId] = nil
    end
end)

-- CUSTOM DAMAGE FUNCTION
-- Replace your NPC's standard "Humanoid:TakeDamage()" logic with this function
local function dealDamageToPlayer(targetPlayer, damageAmount, attackingNPC)
    local character = targetPlayer.Character
    if not character then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local npcHumanoid = attackingNPC:FindFirstChildOfClass("Humanoid")
    local npcRoot = attackingNPC:FindFirstChild("HumanoidRootPart")
    
    if not humanoid or not npcHumanoid or not npcRoot then return end
    
    -- Check if the player is successfully parrying
    if activeParries[targetPlayer.UserId] then
        -- 1. Visual/Sound effect for a successful parry
        local sound = Instance.new("Sound")
        sound.SoundId = "rbxassetid://560838333" -- Standard metal clash sound
        sound.Parent = character.PrimaryPart
        sound.PlayOnRemove = true
        sound.Volume = 1
        sound.TimePosition = 0.1
        sound.PlaybackSpeed = 1.2
        sound:Destroy()
        
        -- 2. Reverse the damage back to the NPC
        npcHumanoid:TakeDamage(damageAmount * 1.5) -- Deals 1.5x damage back to NPC
        
        -- 3. Stun the NPC
        task.spawn(function()
            local originalWalkSpeed = npcHumanoid.WalkSpeed
            npcHumanoid.WalkSpeed = 0 -- Freeze the NPC
            
            -- Optional: Play a stun effect (change color temporarily)
            local highlight = Instance.new("Highlight")
            highlight.FillColor = Color3.fromRGB(255, 255, 0) -- Yellow tint
            highlight.Parent = attackingNPC
            
            task.wait(2.5) -- Duration of the stun
            
            highlight:Destroy()
            npcHumanoid.WalkSpeed = originalWalkSpeed -- Unfreeze NPC
        end)
        
        -- Remove parry status immediately so they can't spam it infinitely from one hit
        activeParries[targetPlayer.UserId] = nil
        print(targetPlayer.Name .. " successfully parried " .. attackingNPC.Name)
    else
        -- Player failed to parry, take damage normally
        humanoid:TakeDamage(damageAmount)
    end
end

-- Global global exposure so your NPC script can access it easily
_G.DealParryableDamage = dealDamageToPlayer

]]></ProtectedString>
