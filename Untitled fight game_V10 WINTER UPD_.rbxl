<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local tool = script.Parent
local player = Players.LocalPlayer

-- Create a RemoteEvent in ReplicatedStorage named "SummonCylinder" if it doesn't exist
local remoteEvent = ReplicatedStorage:WaitForChild("SummonCylinder")

local ACTION_NAME = "SummonCylinderAction"

-- Function that runs when the tool is activated
local function onActivate(actionName, inputState, inputObject)
    if inputState == Enum.UserInputState.Begin then
        -- Tell the server to spawn the cylinder, passing the player's current look direction
        local character = player.Character
        if character and character:FindFirstChild("HumanoidRootPart") then
            local lookDirection = character.HumanoidRootPart.CFrame.LookVector
            remoteEvent:FireServer(lookDirection)
        end
    end
end

-- Bind the action when the tool is equipped (Works for Mobile, PC, and Console)
tool.Equipped:Connect(function()
    ContextActionService:BindAction(
    ACTION_NAME, 
    onActivate, 
    true, -- Creates a touch button on mobile devices automatically
    Enum.UserInputType.MouseButton1, -- PC Click
    Enum.KeyCode.ButtonR2 -- Console Trigger
    )
    -- Optional: Customize the mobile button text
    ContextActionService:SetTitle(ACTION_NAME, "Summon")
end)

-- Unbind the action when the tool is unequipped so the button disappears
tool.Unequipped:Connect(function()
    ContextActionService:UnbindAction(ACTION_NAME)
end)

]]></ProtectedString>
