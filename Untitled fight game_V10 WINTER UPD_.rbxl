<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454117443AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">LocalScript</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local AttackEvent = Tool:WaitForChild("AttackEvent")
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
 
local player = Players.LocalPlayer
local ACTION_NAME = "ToolM1Attack"
local ATTACK_COOLDOWN = 1 -- Time between attacks in seconds
local lastAttack = 0
 
-- Function called when the user inputs the attack command
local function onAttack(actionName, inputState, inputObject)
    if inputState ~= Enum.UserInputState.Begin then return end
    
    -- Cooldown check
    local currentTime = os.clock()
    if currentTime - lastAttack < ATTACK_COOLDOWN then return end
    lastAttack = currentTime
    
    -- Fire to the server to handle the hit detection
    AttackEvent:FireServer()
end
 
-- Bind the action when the tool is equipped (Works for PC, Mobile, and Console)
Tool.Equipped:Connect(function()
    ContextActionService:BindAction(
    ACTION_NAME, 
    onAttack, 
    true, -- Creates a mobile button automatically
    Enum.UserInputType.MouseButton1, -- PC Click
    Enum.UserInputType.Touch,        -- Mobile Tap
    Enum.KeyCode.ButtonR2            -- Console Trigger
    )
    
    -- Optional: Customize the mobile button text
    local button = ContextActionService:GetButton(ACTION_NAME)
    if button then
        button.Title = "Attack"
    end
end)
 
-- Unbind the action when unequipped so it doesn't trigger accidentally
Tool.Unequipped:Connect(function()
    ContextActionService:UnbindAction(ACTION_NAME)
end)

]]></ProtectedString>
