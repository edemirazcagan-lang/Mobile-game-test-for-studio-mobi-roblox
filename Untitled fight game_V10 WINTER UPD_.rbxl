<Item class="Script" referent="RBX66C1625455D04AC580D8112849513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">true</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script4</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local npc = script.Parent
local humanoid = npc:WaitForChild("Humanoid")

humanoid.DamageEnforcement = "None" -- Optional setting

-- This function runs whenever the NPC takes damage
humanoid.HealthChanged:Connect(function()
    -- We look for who is hitting the NPC
    -- Most Roblox weapons put a "Creator" tag on the NPC they hit
    local tag = npc.Humanoid:FindFirstChild("creator")
    
    if tag and tag.Value then
        local playerWhoHit = tag.Value
        -- Check if the player's name is in the NPC's name (since we named it PlayerName_NPC)
        if string.find(npc.Name, playerWhoHit.Name) then
            humanoid.Health = humanoid.MaxHealth -- Instantly heal them back
        end
    end
end)


]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8128500041fa</UniqueId>
</Properties>
</Item>
