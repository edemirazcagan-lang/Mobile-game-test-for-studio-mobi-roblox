<ProtectedString name="Source"><![CDATA[local BadgeService = game:GetService("BadgeService")
local Tool = game:GetService("ServerStorage"):WaitForChild("IlluminaOfSkys") -- Change tool to the name of your tool in replicated storage!
local BadgeId = 1309215334036268

game.Players.PlayerAdded:Connect(function(player)
