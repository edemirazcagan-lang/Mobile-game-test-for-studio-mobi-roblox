<Item class="Script" referent="RBX66C1625455D04AC580D8114665513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">KillsScript</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local BadgeService = game:GetService("BadgeService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
 
local KillDataStore = DataStoreService:GetDataStore("KillSystemDataStore_v4")
 
-- !!! FOLDER CONFIGURATION !!!
local NPC_FOLDER_NAME = "Noobs" 
 
-- !!! GAMEPASS CONFIGURATION !!!
local GAMEPASS_LOW_MULTIPLIER =  1893245794
local GAMEPASS_HIGH_MULTIPLIER = 1890851893
 
local LOW_MULT_VAL = 2.5
local HIGH_MULT_VAL = 4
 
 
-- !!! BADGE CONFIGURATION !!!
-- NPC Badge is based on TOTAL LIFETIME KILLS
local NPC_TOTAL_REQUIREMENT = 1000
local NPC_TOTAL_BADGE_ID = 1309215334036268 -- <--- PUT YOUR TOTAL NPC KILLS BADGE ID HERE
 
-- Player Badge is based on a KILLSTREAK (In a row)
local PLAYER_STREAK_REQUIREMENT = 10
local PLAYER_STREAK_BADGE_ID = 2349048670284733 -- <--- PUT YOUR PLAYER STREAK BADGE ID HERE
 
 
-- Session table to track continuous player-vs-player killstreaks
local playerKillstreaks = {}
 
-- Tracked humanoids to prevent double-binding or duplicate kill rewards
local trackedHumanoids = {}
 
-- Function to calculate total kill multiplier
local function getKillMultiplier(player)
    local multiplier = 1
    
    local successLow, hasLow = pcall(function()
        return MarketplaceService:UserOwnsGamePassAsync(player.UserId, GAMEPASS_LOW_MULTIPLIER)
    end)
    if successLow and hasLow then
        multiplier = multiplier + (LOW_MULT_VAL - 1)
    end
    
    local successHigh, hasHigh = pcall(function()
        return MarketplaceService:UserOwnsGamePassAsync(player.UserId, GAMEPASS_HIGH_MULTIPLIER)
    end)
    if successHigh and hasHigh then
        multiplier = multiplier + (HIGH_MULT_VAL - 1)
    end
    
    return multiplier
end
 
-- Helper function to safely award a badge
local function awardBadge(player, badgeId)
    if not badgeId or badgeId == 0 then return end 
        
        local success, hasBadge = pcall(function()
            return BadgeService:UserHasBadgeAsync(player.UserId, badgeId)
        end)
        
        if success and not hasBadge then
            pcall(function()
                BadgeService:AwardBadge(player.UserId, badgeId)
            end)
        end
    end
    
    -- Award kills logic based on tool ownership
    local function awardKill(victimCharacter, killType)
        for _, player in ipairs(Players:GetPlayers()) do
            if player.Character and player.Character ~= victimCharacter then
                local tool = player.Character:FindFirstChildOfClass("Tool")
                
                if tool then
                    local leaderstats = player:FindFirstChild("leaderstats")
                    if leaderstats then
                        local stat = leaderstats:FindFirstChild(killType)
                        if stat then
                            local mult = getKillMultiplier(player)
                            stat.Value = stat.Value + (1 * mult)
                            
                            -- Badge Logic based on your rules:
                            if killType == "Player Kills" then
                                -- Players use a Killstreak (Flat +1 per kill, resets on death)
                                playerKillstreaks[player] = (playerKillstreaks[player] or 0) + 1
                                if playerKillstreaks[player] >= PLAYER_STREAK_REQUIREMENT then
                                    awardBadge(player, PLAYER_STREAK_BADGE_ID)
                                end
                                
                            elseif killType == "NPC Kills" then
                                -- NPCs use TOTAL KILLS (Checks the leaderboard value directly)
                                if stat.Value >= NPC_TOTAL_REQUIREMENT then
                                    awardBadge(player, NPC_TOTAL_BADGE_ID)
                                end
                            end
                            
                            break 
                        end
                    end
                end
            end
        end
    end
    
    -- Tracks NPCs safely without duplicating connections
    local function setupNpcTracking(object)
        if object:IsA("Model") and not Players:GetPlayerFromCharacter(object) then
            local humanoid = object:FindFirstChildOfClass("Humanoid")
            if humanoid and not trackedHumanoids[humanoid] then
                trackedHumanoids[humanoid] = true
                
                humanoid.Died:Connect(function()
                    awardKill(object, "NPC Kills")
                    trackedHumanoids[humanoid] = nil 
                end)
            end
        end
    end
    
    -- Player Setup (Leaderboards & PVP Deaths)
    Players.PlayerAdded:Connect(function(player)
        playerKillstreaks[player] = 0
        
        local leaderstats = Instance.new("Folder")
        leaderstats.Name = "leaderstats"
        leaderstats.Parent = player
        
        local playerKills = Instance.new("IntValue")
        playerKills.Name = "Player Kills"
        playerKills.Value = 0
        playerKills.Parent = leaderstats
        
        local npcKills = Instance.new("IntValue")
        npcKills.Name = "NPC Kills"
        npcKills.Value = 0
        npcKills.Parent = leaderstats
        
        -- Load Data
        local playerKey = "Player_" .. player.UserId
        local success, savedData = pcall(function()
            return KillDataStore:GetAsync(playerKey)
        end)
        if success and savedData then
            playerKills.Value = savedData.PlayerKills or 0
            npcKills.Value = savedData.NPCKills or 0
            
            -- Retroactive check: If they loaded in and already have enough total NPC kills, award badge
            if npcKills.Value >= NPC_TOTAL_REQUIREMENT then
                task.defer(function()
                    awardBadge(player, NPC_TOTAL_BADGE_ID)
                end)
            end
        end
        
        -- Player PVP Death Tracking
        player.CharacterAdded:Connect(function(character)
            local humanoid = character:WaitForChild("Humanoid")
            humanoid.Died:Connect(function()
                -- Only resets the player-vs-player killstreak
                playerKillstreaks[player] = 0
                
                awardKill(character, "Player Kills")
            end)
        end)
    end)
    
    Players.PlayerRemoving:Connect(function(player)
        playerKillstreaks[player] = nil
    end)
    
    -- --- METHOD 1: Track Main Workspace ---
    for _, object in ipairs(Workspace:GetChildren()) do
        setupNpcTracking(object)
    end
    Workspace.ChildAdded:Connect(setupNpcTracking)
    
    -- --- METHOD 2: Track Specific Survival Folder ---
    task.spawn(function()
        local npcFolder = Workspace:WaitForChild(NPC_FOLDER_NAME, 10)
        if npcFolder then
            for _, object in ipairs(npcFolder:GetChildren()) do
                setupNpcTracking(object)
            end
            npcFolder.ChildAdded:Connect(setupNpcTracking)
        else
            warn("Kill System Warning: Folder '" .. NPC_FOLDER_NAME .. "' not found within 10 seconds. Tracking main Workspace only.")
        end
    end)
    
    -- Save Data Functions
    local function saveData(player)
        local leaderstats = player:FindFirstChild("leaderstats")
        if leaderstats then
            local playerKills = leaderstats:FindFirstChild("Player Kills")
            local npcKills = leaderstats:FindFirstChild("NPC Kills")
            
            if playerKills and npcKills then
                local dataToSave = {
                PlayerKills = playerKills.Value,
                NPCKills = npcKills.Value
                }
                local playerKey = "Player_" .. player.UserId
                pcall(function()
                    KillDataStore:SetAsync(playerKey, dataToSave)
                end)
            end
        end
    end
    
    Players.PlayerRemoving:Connect(saveData)
    game:BindToClose(function()
        for _, player in ipairs(Players:GetPlayers()) do
            saveData(player)
        end
    end)

]]></ProtectedString>
