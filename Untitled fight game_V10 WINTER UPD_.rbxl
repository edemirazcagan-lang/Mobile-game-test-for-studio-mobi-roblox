</Item>
<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454114183AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">LocalScript2</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local Character = script.Parent
local Humanoid = Character:WaitForChild("Humanoid")
local Animator = Humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", Humanoid)
local Animations = {
Idle = Instance.new("Animation"),
Walk = Instance.new("Animation"),
Jump = Instance.new("Animation")
}
 
Animations.Idle.AnimationId = "rbxassetid://167272039"
Animations.Walk.AnimationId = "rbxassetid://80979216"
Animations.Jump.AnimationId = "rbxassetid://187951261"
local Tracks = {
Idle = Animator:LoadAnimation(Animations.Idle),
Walk = Animator:LoadAnimation(Animations.Walk),
Jump = Animator:LoadAnimation(Animations.Jump)
}

local Sounds = {
Walk = Instance.new("Sound"),
Jump = Instance.new("Sound")
}
 
Sounds.Walk.SoundId = "rbxassetid://2428506935"
Sounds.Jump.SoundId = "rbxassetid://2428506580"
Sounds.Walk.Looped = true

Sounds.Walk.Parent = Character
Sounds.Jump.Parent = Character
local function StopAllAnimations()
    Tracks.Idle:Stop()
    Tracks.Walk:Stop()
    Tracks.Jump:Stop()
    Sounds.Walk:Stop()
    Sounds.Jump:Stop()
end

local function UpdateAnimation()
    if Humanoid:GetState() == Enum.HumanoidStateType.Jumping or Humanoid:GetState() == Enum.HumanoidStateType.Freefall then
        if not Tracks.Jump.IsPlaying then
            StopAllAnimations()
            Tracks.Jump:Play()
            Sounds.Jump:Play()
        end
    elseif Humanoid.MoveDirection.Magnitude > 0 then
        if not Tracks.Walk.IsPlaying then
            StopAllAnimations()
            Tracks.Walk:Play()
            Sounds.Walk:Play()
        end
    else
        if not Tracks.Idle.IsPlaying then
            StopAllAnimations()
            Tracks.Idle:Play()
        end
    end
end

Humanoid.Running:Connect(function(speed)
    if speed > 0 then
        StopAllAnimations()
        Tracks.Walk:Play()
        Sounds.Walk:Play()
    else
        StopAllAnimations()
        Tracks.Idle:Play()
    end
end)
Humanoid.Jumping:Connect(function()
    StopAllAnimations()
    Tracks.Jump:Play()
    Sounds.Jump:Play()
end)
 
Humanoid.FreeFalling:Connect(function()
    StopAllAnimations()
    Tracks.Jump:Play()
    Sounds.Jump:Play()
end)
Tracks.Idle:Play()

]]></ProtectedString>
