<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454114177AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">LocalScript</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local TextChatService = game:GetService("TextChatService")
local Players = game:GetService("Players")
 
TextChatService.OnIncomingMessage = function(message)
    local properties = Instance.new("TextChatMessageProperties")
    
    if message.TextSource then
        local userId = message.TextSource.UserId
        local player = Players:GetPlayerByUserId(userId)
        
        if player then
            local tier = player:GetAttribute("ChatTier") or 0
            
            local tagText = ""
            local tagColor = ""
            
            if tier == 2 then
                tagText = "[VIP Gold]"
                tagColor = "#FFD700" -- Gold Hex
            elseif tier == 1 then
                tagText = "[VIP Cyan]"
                tagColor = "#00FFFF" -- Cyan Hex
            end
            
            -- Only apply formatting if they actually have a valid tier tag
            if tier > 0 then
                -- This keeps the original username/color intact and prepends the colored tag
                properties.PrefixText = string.format("%s %s", tagColor, tagText, message.PrefixText)
            end
        end
    end
    
    return properties
end

]]></ProtectedString>
