<Item class="Script" referent="RBX66C1625455D04AC580D8116795513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script3</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SpawnBombEvent = ReplicatedStorage:WaitForChild("SpawnBombEvent")
 
-- Configuration
local BOMB_LIFETIME = 15 -- Despawns if no one steps on it
local EXPLOSION_DAMAGE = 50
local EXPLOSION_RADIUS = 10
 
local function createBomb(player)
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    -- 1. Create the Bomb Part
    local bomb = Instance.new("Part")
    bomb.Name = "BombTrap"
    bomb.Size = Vector3.new(2, 2, 2)
    bomb.Shape = Enum.PartType.Ball
    bomb.BrickColor = BrickColor.new("Really Black")
    bomb.Material = Enum.Material.Neon
    bomb.Anchored = false
    bomb.CanCollide = true
    
    -- Position it slightly in front of the player's feet
    local hrp = character.HumanoidRootPart
    bomb.Position = hrp.Position + (hrp.CFrame.LookVector * 3) - Vector3.new(0, 1, 0)
    bomb.Parent = workspace
    
    -- 2. Handle the Trap Detonation
    local hasExploded = false
    
    local function detonate()
        if hasExploded then return end
        hasExploded = true
        
        -- Create the visual explosion
        local explosion = Instance.new("Explosion")
        explosion.BlastRadius = EXPLOSION_RADIUS
        explosion.BlastPressure = 500000 -- Knocks unanchored parts away
        explosion.Position = bomb.Position
        
        -- Deal damage to humanoids caught in the blast
        explosion.Hit:Connect(function(part, distance)
            local targetChar = part.Parent
            local targetHumanoid = targetChar:FindFirstChildOfClass("Humanoid")
            
            if targetHumanoid and targetChar ~= character then
                -- Calculate scaling damage based on distance
                local damageFactor = 1 - (distance / EXPLOSION_RADIUS)
                local finalDamage = EXPLOSION_DAMAGE * damageFactor
                targetHumanoid:TakeDamage(finalDamage)
            end
        end)
        
        explosion.Parent = workspace
        bomb:Destroy() -- Delete the bomb part
    end
    
    -- Detonate if touched by another player
    bomb.Touched:Connect(function(hit)
        local hitChar = hit.Parent
        local hitHumanoid = hitChar:FindFirstChildOfClass("Humanoid")
        
        -- Only detonate if it touches a living character that isn't the creator
        if hitHumanoid and hitChar ~= character and hitHumanoid.Health > 0 then
            detonate()
        end
    end)
    
    -- Automatically clean up/despawn the bomb if no one steps on it
    task.delay(BOMB_LIFETIME, function()
        if bomb and bomb.Parent then
            detonate() -- You can change this to bomb:Destroy() if you don't want it to explode automatically
        end
    end)
end
 
SpawnBombEvent.OnServerEvent:Connect(createBomb)

]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8167960041fa</UniqueId>
</Properties>
</Item>
<Item class="Script" referent="RBX66C1625455D04AC580D8116797513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script4</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local tool = script.Parent
local handle = tool:WaitForChild("Handle")

-- Configurable Settings
local BASE_DAMAGE = 750
local CRIT_DAMAGE = 950
local CRIT_CHANCE = 0.70 -- 70% chance to do a powerful slash
local ATTACK_COOLDOWN = 0.8

local canAttack = true
local hasHitTable = {} -- Prevents damaging the same target multiple times *in one swing*

-- Function to handle dealing damage
local function onTouch(otherPart)
    local character = otherPart.Parent
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    -- Ensure it's a valid target, alive, and not the wielder of the sword
    if humanoid and humanoid.Health > 0 and character ~= tool.Parent then
        -- Check if we haven't hit this specific enemy during this swing yet
        if not hasHitTable[character] then
            hasHitTable[character] = true -- Lock this enemy out for the rest of THIS swing
            
            -- Roll for a random powerful slash
            local isCrit = math.random() <= CRIT_CHANCE
            
            if isCrit then
                humanoid:TakeDamage(CRIT_DAMAGE)
                print("Critical Slash on " .. character.Name .. "! Dealt " .. CRIT_DAMAGE .. " damage.")
                
                -- Visual cue (Spawned in a separate thread so it doesn't pause the swing cooldown)
                task.spawn(function()
                    local originalColor = handle.BrickColor
                    handle.BrickColor = BrickColor.new("Bright red")
                    task.wait(0.2)
                    handle.BrickColor = originalColor
                end)
            else
                humanoid:TakeDamage(BASE_DAMAGE)
                print("Normal Slash on " .. character.Name .. ". Dealt " .. BASE_DAMAGE .. " damage.")
            end
        end
    end
end

-- Function triggered when the player clicks/activates the tool
local function onActivated()
    if not canAttack then return end
    canAttack = false
    
    table.clear(hasHitTable) -- Clear the table so ALL enemies can be hit again for this new swing
    
    -- Connect the touch detection
    local touchConnection = handle.Touched:Connect(onTouch)
    
    task.wait(ATTACK_COOLDOWN) -- Duration of the hitbox/swing phase
    
    touchConnection:Disconnect() -- Turn off hitbox
    canAttack = true
end

tool.Activated:Connect(onActivated)


]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8167980041fa</UniqueId>
</Properties>
</Item>
<Item class="Script" referent="RBX66C1625455D04AC580D8116799513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script2</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[-- Configuration Settings
local AURA_RADIUS = 15       -- How close the NPC needs to be (in studs)
local DAMAGE_PER_SEC = 10    -- How much damage the NPC takes per second
local SLOW_SPEED = 6        -- The NPC's WalkSpeed when slowed
local CHECK_INTERVAL = 0.5   -- How often the script checks (in seconds)
 
local affectedNPCs = {}
 
local function checkAura()
    local Workspace = game:GetService("Workspace")
    local Players = game:GetService("Players")
    local currentAffected = {}
    
    for _, player in ipairs(Players:GetPlayers()) do
        local character = player.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        
        if rootPart then
            for _, object in ipairs(Workspace:GetChildren()) do
                local humanoid = object:FindFirstChildOfClass("Humanoid")
                local npcRoot = object:FindFirstChild("HumanoidRootPart")
                local isPlayer = Players:GetPlayerFromCharacter(object)
                
                if humanoid and npcRoot and not isPlayer and humanoid.Health > 0 then
                    local distance = (rootPart.Position - npcRoot.Position).Magnitude
                    
                    if distance <= AURA_RADIUS then
                        currentAffected[object] = {
                        Humanoid = humanoid,
                        PlayerSource = player
                        }
                    end
                end
            end
        end
    end
    
    -- Apply damage and slow effect
    for npc, data in pairs(currentAffected) do
        local humanoid = data.Humanoid
        
        if not affectedNPCs[npc] then
            affectedNPCs[npc] = {
            OriginalSpeed = humanoid.WalkSpeed
            }
            humanoid.WalkSpeed = SLOW_SPEED
        end
        
        -- FIX: Direct health reduction in case :TakeDamage() is blocked by ForceFields or custom scripts
        local damageTick = DAMAGE_PER_SEC * CHECK_INTERVAL
        humanoid.Health = math.max(0, humanoid.Health - damageTick) 
    end
    
    -- Restore NPCs leaving aura
    for npc, data in pairs(affectedNPCs) do
        if not currentAffected[npc] then
            if npc and npc.Parent and npc:FindFirstChildOfClass("Humanoid") then
                npc:FindFirstChildOfClass("Humanoid").WalkSpeed = data.OriginalSpeed
            end
            affectedNPCs[npc] = nil
        end
    end
end
 
task.spawn(function()
    while true do
        checkAura()
        task.wait(CHECK_INTERVAL)
    end
end)

]]></ProtectedString>
