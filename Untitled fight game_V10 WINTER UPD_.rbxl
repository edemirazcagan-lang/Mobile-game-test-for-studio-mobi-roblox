<Item class="StringValue" referent="RBX7945CF6F30E24205807BB1648530F26E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<string name="Name">dance3</string>
<UniqueId name="UniqueId">179a555039d7b72a0689f164860042b7</UniqueId>
<string name="Value"></string>
</Properties>
