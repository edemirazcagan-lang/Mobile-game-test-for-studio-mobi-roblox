<Item class="Script" referent="RBX66C1625455D04AC580D8116789513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LaserEvent = ReplicatedStorage:WaitForChild("LaserEvent")

local DAMAGE_AMOUNT = 460
local PULL_FORCE = 40
local MAX_DISTANCE = 100

local activeLasers = {}

-- Function to clean up laser effects
local function removeLaser(player)
    if activeLasers[player] then
        if activeLasers[player].Beam then activeLasers[player].Beam:Destroy() end
        if activeLasers[player].Attachment then activeLasers[player].Attachment:Destroy() end
        if activeLasers[player].Velocity then activeLasers[player].Velocity:Destroy() end
        activeLasers[player] = nil
    end
end

LaserEvent.OnServerEvent:Connect(function(player, action, targetPos)
    local character = player.Character
    local handle = Tool:FindFirstChild("Handle")
    
    if action == "Stop" or not character or not handle then
        removeLaser(player)
        return
    end
    
    if action == "Fire" and targetPos then
        removeLaser(player) -- Clear any old laser first
        
        local origin = handle.Position
        local direction = (targetPos - origin).Unit
        
        -- Raycast to find what the laser hit
        local raycastParams = RaycastParams.new()
        raycastParams.FilterDescendantsInstances = {character}
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude
        
        local raycastResult = workspace:Raycast(origin, direction * MAX_DISTANCE, raycastParams)
        
        if raycastResult and raycastResult.Instance then
            local hitPart = raycastResult.Instance
            local hitModel = hitPart:FindFirstAncestorOfClass("Model")
            local targetHumanoid = hitModel and hitModel:FindFirstChildOfClass("Humanoid")
            local targetRoot = hitModel and hitModel:FindFirstChild("HumanoidRootPart")
            
            -- Create Visual Beam Attachment on Weapon
            local att0 = handle:FindFirstChild("LaserAttachment") or Instance.new("Attachment", handle)
            att0.Name = "LaserAttachment"
            
            -- Create Visual Beam Attachment on Target Impact Point
            local att1 = Instance.new("Attachment", hitPart)
            att1.WorldPosition = raycastResult.Position
            
            -- Create the Laser Beam Visual
            local beam = Instance.new("Beam")
            beam.Attachment0 = att0
            beam.Attachment1 = att1
            beam.Width0 = 0.2
            beam.Width1 = 0.2
            beam.Color = ColorSequence.new(Color3.fromRGB(255, 0, 0)) -- Red laser
            beam.LightEmission = 1
            beam.Parent = handle
            
            -- Track the elements to delete them later
            activeLasers[player] = {Beam = beam, Attachment = att1}
            
            -- If we hit a player/NPC, pull them and deal damage
            if targetHumanoid and targetRoot and targetHumanoid.Health > 0 then
                targetHumanoid:TakeDamage(DAMAGE_AMOUNT)
                
                -- Setup modern physics force to pull target
                local velocity = Instance.new("LinearVelocity")
                velocity.MaxForce = math.huge
                velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
                
                -- Pull direction: From target to the player firing
                local myRoot = character:FindFirstChild("HumanoidRootPart")
                if myRoot then
                    local pullDirection = (myRoot.Position - targetRoot.Position).Unit
                    velocity.VectorVelocity = pullDirection * PULL_FORCE
                    
                    -- Attach physics force to target
                    local targetAtt = Instance.new("Attachment", targetRoot)
                    velocity.Attachment0 = targetAtt
                    velocity.Parent = targetRoot
                    
                    activeLasers[player].Velocity = velocity
                    activeLasers[player].TargetAttachment = targetAtt
                    
                    -- Auto clean up physics after 0.5 seconds so they aren't stuck forever
                    task.delay(0.5, function()
                        if velocity then velocity:Destroy() end
                        if targetAtt then targetAtt:Destroy() end
                    end)
                end
            end
        end
    end
end)

Tool.Unequipped:Connect(function()
    -- Find player holding it to clear their effects
    local character = Tool.Parent
    if character then
        local player = game:GetService("Players"):GetPlayerFromCharacter(character)
        if player then removeLaser(player) end
    end
end)



]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8167900041fa</UniqueId>
</Properties>
