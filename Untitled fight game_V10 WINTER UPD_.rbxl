<string name="Name">hpheal</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local humanoid = script.Parent:WaitForChild("Humanoid")
 
-- 1. Setup the high health correctly
humanoid.MaxHealth = 20000
humanoid.Health = 20000
 
-- 2. Healing logic
while true do
    task.wait(1)
    
    local halfHealth = humanoid.MaxHealth / 2
    
    -- Only heal if above 7,500 HP (half of 15k)
    if humanoid.Health > halfHealth and humanoid.Health < humanoid.MaxHealth then
        humanoid.Health = humanoid.Health + 30 -- Increased heal amount for 15k HP
    end
end
 

]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8141700041fa</UniqueId>
</Properties>
</Item>
