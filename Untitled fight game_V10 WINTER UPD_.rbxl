<Item class="Script" referent="RBX66C1625455D04AC580D8115039513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script3</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local SpikeEvent = Tool:WaitForChild("SpikeEvent")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")
 
-- CONFIGURATION
local DAMAGE_AMOUNT = 235       -- Damage dealt by spikes
local SPIKE_LIFETIME = 16       -- How long spikes stay on map
local FREEZE_DURATION = 1.5    -- How long the player is stopped for
local COOLDOWN = 21             -- Cooldown between uses
 
local onCooldown = false
 
SpikeEvent.OnServerEvent:Connect(function(player)
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    local spikeTemplate = ReplicatedStorage:FindFirstChild("SpikeModel")
    
    -- Check conditions and cooldown
    if onCooldown or not humanoid or humanoid.Health <= 0 or not rootPart or not spikeTemplate then return end
    
    onCooldown = true
    
    -- 1. STOP THE PLAYER
    local oldWalkSpeed = humanoid.WalkSpeed
    humanoid.WalkSpeed = 0
    
    -- 2. WAIT BEFORE SUMMONING
    task.wait(FREEZE_DURATION)
    
    -- Restore player's movement right as spikes appear
    if humanoid and humanoid.Parent then
        humanoid.WalkSpeed = oldWalkSpeed
    end
    
    -- 3. SUMMON SPIKES (Spawns a cluster of 3 spikes in front of player)
    local spawnPositions = {
    rootPart.CFrame * CFrame.new(0, -2, -5),  -- Close front
    rootPart.CFrame * CFrame.new(-3, -2, -8), -- Left front
    rootPart.CFrame * CFrame.new(3, -2, -8)   -- Right front
    }
    
    for _, cframe in ipairs(spawnPositions) do
        local spikeClone = spikeTemplate:Clone()
        
        -- Pivot the model to the target position
        if spikeClone:IsA("Model") then
            spikeClone:PivotTo(cframe)
        elseif spikeClone:IsA("BasePart") then
            spikeClone.CFrame = cframe
            spikeClone.Anchored = true
            spikeClone.CanCollide = false
        end
        
        spikeClone.Parent = workspace
        Debris:AddItem(spikeClone, SPIKE_LIFETIME)
        
        -- Add damage detection to the spike(s)
        local partsToConnect = spikeClone:IsA("Model") and spikeClone:GetDescendants() or {spikeClone}
        
        for _, part in ipairs(partsToConnect) do
            if part:IsA("BasePart") then
                part.Touched:Connect(function(hit)
                    local hitCharacter = hit.Parent
                    if hitCharacter and hitCharacter:IsA("Model") and hitCharacter ~= character then
                        local hitHumanoid = hitCharacter:FindFirstChildOfClass("Humanoid")
                        if hitHumanoid then
                            hitHumanoid:TakeDamage(DAMAGE_AMOUNT)
                        end
                    end
                end)
            end
        end
    end
    
    -- 4. COOLDOWN MANAGEMENT
    task.wait(COOLDOWN - FREEZE_DURATION)
    onCooldown = false
end)

]]></ProtectedString>
