<ProtectedString name="Source"><![CDATA[local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
 
local tool = script.Parent
local toolOwner = nil
 
-- Create Remote Events dynamically
local stopRemote = Instance.new("RemoteEvent")
stopRemote.Name = "ToggleStop"
stopRemote.Parent = tool
 
local reverseRemote = Instance.new("RemoteEvent")
reverseRemote.Name = "TriggerReverse"
reverseRemote.Parent = tool
 
-- State variables
local isTimeStopped = false
local historyLog = {} -- Stores positions of other players for reversal
local MAX_HISTORY_SECONDS = 5
local TICK_RATE = 0.1 -- Record positions every 0.1 seconds
 
----------------------------------------
-- CORE MECHANICS: TRACKING & REVERSAL
----------------------------------------
 
-- Continuously track player positions
task.spawn(function()
    while true do
        task.wait(TICK_RATE)
        if not isTimeStopped then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= toolOwner and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local hrp = p.Character.HumanoidRootPart
                    if not historyLog[p] then historyLog[p] = {} end
                    
                    table.insert(historyLog[p], 1, hrp.CFrame) -- Insert at beginning
                    
                    -- Trim history to max limit
                    if #historyLog[p] > (MAX_HISTORY_SECONDS / TICK_RATE) then
                        table.remove(historyLog[p])
                    end
                end
            end
        end
    end
end)
 
local function reverseTime()
    if isTimeStopped then return end -- Prevent reversing while stopped
        
        for player, cframes in pairs(historyLog) do
            if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = player.Character.HumanoidRootPart
                
                task.spawn(function()
                    -- Smoothly tween backwards through the stored path
                    for i = #cframes, 1, -1 do
                        local tween = TweenService:Create(hrp, TweenInfo.new(TICK_RATE, Enum.EasingStyle.Linear), {CFrame = cframes[i]})
                        tween:Play()
                        task.wait(TICK_RATE)
                    end
                    table.clear(cframes) -- Reset history after tracking
                end)
            end
        end
    end
    
    ----------------------------------------
    -- CORE MECHANICS: TIME STOP
    ----------------------------------------
    
    local function toggleTimeStop()
        isTimeStopped = not isTimeStopped
        
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= toolOwner and p.Character then
                for _, part in ipairs(p.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Anchored = isTimeStopped
                    end
                end
                local humanoid = p.Character:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    humanoid.WalkSpeed = isTimeStopped and 0 or 16
                    humanoid.JumpPower = isTimeStopped and 0 or 50
                end
            end
        end
    end
    
    ----------------------------------------
    -- CONNECTIONS
    ----------------------------------------
    
    tool.Equipped:Connect(function()
        toolOwner = Players:GetPlayerFromCharacter(tool.Parent)
    end)
    
    tool.Unequipped:Connect(function()
        if isTimeStopped then
            toggleTimeStop() -- Force resume if tool dropped/unequipped
        end
        toolOwner = nil
    end)
    
    stopRemote.OnServerEvent:Connect(function(player)
        if player == toolOwner then
            toggleTimeStop()
        end
    end)
    
    reverseRemote.OnServerEvent:Connect(function(player)
        if player == toolOwner then
            reverseTime()
        end
    end)

]]></ProtectedString>
