<ProtectedString name="Source"><![CDATA[local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")

local tool = script.Parent
local player = Players.LocalPlayer

local STOP_ACTION = "TimeStopAction"
local REVERSE_ACTION = "TimeReverseAction"

-- Wait for server script to create the remotes
local stopRemote = tool:WaitForChild("ToggleStop")
local reverseRemote = tool:WaitForChild("TriggerReverse")

-- Input handler for all devices
local function handleAction(actionName, inputState, inputObject)
    if inputState ~= Enum.UserInputState.Begin then return end
    
    if actionName == STOP_ACTION then
        stopRemote:FireServer()
    elseif actionName == REVERSE_ACTION then
        reverseRemote:FireServer()
    end
end

-- Bind actions when tool is equipped
tool.Equipped:Connect(function()
    -- Bind Time Stop: F key (PC), X Button (Console), creates On-Screen Button (Mobile)
    ContextActionService:BindAction(STOP_ACTION, handleAction, true, Enum.KeyCode.F, Enum.KeyCode.ButtonX)
    ContextActionService:SetTitle(STOP_ACTION, "Time Stop")
    
    -- Bind Time Reverse: G key (PC), Y Button (Console), creates On-Screen Button (Mobile)
    ContextActionService:BindAction(REVERSE_ACTION, handleAction, true, Enum.KeyCode.G, Enum.KeyCode.ButtonY)
    ContextActionService:SetTitle(REVERSE_ACTION, "Reverse")
end)

-- Unbind actions when tool is unequipped to clean up UI
tool.Unequipped:Connect(function()
    ContextActionService:UnbindAction(STOP_ACTION)
    ContextActionService:UnbindAction(REVERSE_ACTION)
end)

]]></ProtectedString>
