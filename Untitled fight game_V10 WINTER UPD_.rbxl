<Item class="SpecialMesh" referent="RBX6F50FFBAEE15417BA7F7412331370A17">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<Content name="MeshId"><url>http://www.roblox.com/asset/?id=31309506</url></Content>
<token name="MeshType">5</token>
