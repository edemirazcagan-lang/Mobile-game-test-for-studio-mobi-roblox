<Item class="Script" referent="RBX66C1625455D04AC580D8100081513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local BadgeService = game:GetService("BadgeService")
local Players = game:GetService("Players")
 
local part = script.Parent
local badgeId = 1307618877192600 -- Replace with your actual Badge ID number
 
local debounce = {}
 
part.Touched:Connect(function(hit)
    local character = hit.Parent
    local player = Players:GetPlayerFromCharacter(character)
    
    -- Check if a player touched it and prevent spamming the touch event
    if player and not debounce[player] then
        debounce[player] = true
        
        -- Check if the player already has the badge before trying to award it
        local success, hasBadge = pcall(function()
            return BadgeService:UserHasBadgeAsync(player.UserId, badgeId)
        end)
        
        if success and not hasBadge then
            pcall(function()
                BadgeService:AwardBadge(player.UserId, badgeId)
            end)
        end
        
        -- Cooldown so the event doesn't fire multiple times instantly
        task.wait(2)
        debounce[player] = nil
    end
end)

]]></ProtectedString>
