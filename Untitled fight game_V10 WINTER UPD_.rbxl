<ProtectedString name="Source"><![CDATA[local BadgeService = game:GetService("BadgeService")
local Tool = game:GetService("ServerStorage"):WaitForChild("MiniatureSun") -- Change tool to the name of your tool in replicated storage!
local BadgeId = 1137650227955060

game.Players.PlayerAdded:Connect(function(player)
    if BadgeService:UserHasBadgeAsync(player.UserId,BadgeId) then
        Tool:Clone().Parent = player.Backpack
        Tool:Clone().Parent = player.StarterGear
    end
end)

]]></ProtectedString>
