<Item class="Script" referent="RBX66C1625455D04AC580D8115445513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script2</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local tool = script.Parent
local handle = tool:WaitForChild("Handle")

-- Configuration
local DAMAGE_AMOUNT = 9000
local ATTACK_COOLDOWN = 0.8

local isAttacking = false

-- Function that runs when the sword hits something
local function onTouch(otherPart)
    -- Only deal damage if the player is actively swinging/attacking
    if not isAttacking then return end
    
    -- Check if the hit object belongs to a character (Character -> Humanoid)
    local character = otherPart.Parent
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    -- Make sure we found a humanoid and it's not the player holding the sword
    local playerCharacter = tool.Parent
    if humanoid and character ~= playerCharacter then
        -- Deal damage
        humanoid:TakeDamage(DAMAGE_AMOUNT)
        
        -- Turn off attacking so we don't hit multiple times in one swing
        isAttacking = false
    end
end

-- Function that runs when the player clicks/activates the tool
local function onActivated()
    if isAttacking then return end -- Don't allow spamming during cooldown
        
        isAttacking = true
        
        -- Optional: You would play your swing animation here
        
        -- Wait for the cooldown duration before allowing another attack
        task.wait(ATTACK_COOLDOWN)
        isAttacking = false
    end
    
    -- Connect the events
    handle.Touched:Connect(onTouch)
    tool.Activated:Connect(onActivated)

]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8154460041fa</UniqueId>
