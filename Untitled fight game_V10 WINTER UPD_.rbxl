<Item class="Script" referent="RBX66C1625455D04AC580D8100241513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script2</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[ 
local ServerStorage = game:GetService("ServerStorage")
local cooldown = 6.5
local bombDuration = 10
local damage  385
 
while true do
    task.wait(cooldown)
    
    -- 1. Find the nearest player
    local target = nil
    for _, player in pairs(game.Players:GetPlayers()) do
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            target = player.Character.HumanoidRootPart
            break
        end
    end
    
    if target then
        -- 2. Create the bomb
        local bomb = ServerStorage.Bomb:Clone()
        bomb.Position = script.Parent.HumanoidRootPart.Position + Vector3.new(0, 5, 0)
        bomb.Parent = game.Workspace
        
        -- 3. Make it follow the player
        local startTime = tick()
        while tick() - startTime < bombDuration do
            local direction = (target.Position - bomb.Position).Unit
            bomb.AssemblyLinearVelocity = direction * 50 -- Speed of the bomb
            task.wait(0.1)
        end
        
        -- 4. Explode!
        local explosion = Instance.new("Explosion")
        explosion.Position = bomb.Position
        explosion.BlastRadius = 10
        explosion.BlastPressure = 0 -- Keeps the player from flying away
        
        -- Custom damage logic (so it doesn't kill instantly)
        explosion.Hit:Connect(function(part)
            local hum = part.Parent:FindFirstChild("Humanoid")
            if hum then
                hum:TakeDamage(damage)
            end
        end)
        
        explosion.Parent = game.Workspace
        bomb:Destroy()
    end
end
 

]]></ProtectedString>
