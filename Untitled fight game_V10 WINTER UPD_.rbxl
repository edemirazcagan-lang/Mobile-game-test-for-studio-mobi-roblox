<Item class="Script" referent="RBX66C1625455D04AC580D8114651513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">ogspawneffect</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")

local function onCharacterAdded(character)
    character:WaitForChild("HumanoidRootPart")
    
    -- Optional: Add a hidden ForceField for classic invincibility behavior
    local forceField = Instance.new("ForceField")
    forceField.Visible = false 
        forceField.Parent = character
            
            local selectionBoxes = {}
            
            -- Attach a SelectionBox to every BasePart on the character
            for _, child in ipairs(character:GetDescendants()) do
                -- CHECK: Only target BaseParts, and make sure they are NOT inside an Accessory (like hair or hats)
                if child:IsA("BasePart") and not child:FindFirstAncestorOfClass("Accessory") then
                    local selBox = Instance.new("SelectionBox")
                    selBox.Adornee = child
                    selBox.LineThickness = 0.08
                    selBox.SurfaceTransparency = 1
                    selBox.Color3 = Color3.fromRGB(255, 0, 0)
                    selBox.Parent = child
                    table.insert(selectionBoxes, selBox)
                end
            end
            
            -- Cycle colors smoothly for 2 seconds
            local duration = 2
            local startTime = tick()
            
            local connection
            connection = game:GetService("RunService").Stepped:Connect(function()
                local elapsed = tick() - startTime
                if elapsed >= duration then
                    connection:Disconnect()
                    -- Clean up selection boxes and forcefield
                    for _, box in ipairs(selectionBoxes) do
                        if box and box.Parent then
                            box:Destroy()
                        end
                    end
                    if forceField and forceField.Parent then
                        forceField:Destroy()
                        end
                        else
                            -- Rainbow hue shift over time
                            local hue = (elapsed / 0.5) % 1
                            local currentColor = Color3.fromHSV(hue, 1, 1)
                            for _, box in ipairs(selectionBoxes) do
                                if box and box.Parent then
                                    box.Color3 = currentColor
                                end
                            end
                        end
                    end)
                end
                
                Players.PlayerAdded:Connect(function(player)
                    player.CharacterAdded:Connect(onCharacterAdded)
                end)

]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8146520041fa</UniqueId>
