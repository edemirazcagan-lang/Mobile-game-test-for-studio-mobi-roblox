<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local tool = script.Parent
local replicatedStorage = game:GetService("ReplicatedStorage")
local gunEvent = replicatedStorage:WaitForChild("GunEvent")
 
local DAMAGE = 45
local RANGE = 300
local MAX_AMMO = 7
local currentAmmo = MAX_AMMO
local isReloading = false
local lastShotTime = 0
local FIRE_COOLDOWN = 0.25 -- Prevents glitchy double-triggers
 
gunEvent.OnServerEvent:Connect(function(player, action, data)
    -- Verify this event is for the player currently holding this specific tool
    if tool.Parent ~= player.Character then return end
 
    if action == "Shoot" and not isReloading then
        local now = os.clock()
        if now - lastShotTime < FIRE_COOLDOWN then return end
        
        if currentAmmo > 0 and typeof(data) == "table" and typeof(data.Origin) == "Vector3" and typeof(data.Direction) == "Vector3" then
            lastShotTime = now
            currentAmmo -= 1
            
            local raycastParams = RaycastParams.new()
            raycastParams.FilterDescendantsInstances = {player.Character, tool}
            raycastParams.FilterType = Enum.RaycastFilterType.Exclude
            raycastParams.IgnoreWater = true
            
            local result = workspace:Raycast(data.Origin, data.Direction.Unit * RANGE, raycastParams)
            
            if result then
                local hitPart = result.Instance
                -- FindFirstAncestorOfClass finds the Character even if you hit a Hat/Accessory
                local hitModel = hitPart:FindFirstAncestorOfClass("Model")
                local humanoid = hitModel and hitModel:FindFirstChildOfClass("Humanoid")
                
                if humanoid and humanoid.Health > 0 then
                    humanoid:TakeDamage(DAMAGE)
                end
            end
        end
    elseif action == "Reload" and not isReloading then
        isReloading = true
        task.wait(2)
        currentAmmo = MAX_AMMO
        isReloading = false
    end
end)

]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8150740041fa</UniqueId>
