<Item class="Script" referent="RBX66C1625455D04AC580D8114649513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Gamemodes</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

-- Configuration
local TIME_BETWEEN_EVENTS = 110 -- Seconds between disasters
local ZOMBIE_COUNT = 100
local RAID_DURATION = 70

local LAVA_RISE_HEIGHT = 150
local LAVA_RISE_TIME = 15
local LAVA_HOLD_TIME = 55

local WIND_DURATION = 55
local WIND_FORCE = 42          
local TORNADO_COUNT = 12       

local BLOOD_NIGHT_DURATION = 70
local BLOOD_ZOMBIE_COUNT = 150

local INVISIBLE_DURATION = 65  -- Duration for the Invisible Stalkers event
local INVISIBLE_ZOMBIE_COUNT = 95

-- References
local zombieTemplate = ServerStorage:WaitForChild("Zombie")
local zombieSpawns = Workspace:WaitForChild("ZombieSpawns"):GetChildren()
local lavaPart = Workspace:WaitForChild("LavaPart")
local eventStatus = ReplicatedStorage:WaitForChild("EventStatus")

-- Save default Lighting & Lava settings
local defaultClockTime = Lighting.ClockTime
local defaultFogEnd = Lighting.FogEnd
local defaultFogStart = Lighting.FogStart
local defaultFogColor = Lighting.FogColor
local defaultAmbient = Lighting.Ambient

lavaPart.Anchored = true
lavaPart.CanCollide = false
lavaPart.Transparency = 1
local originalLavaPos = lavaPart.Position
local lavaActive = false

-- Lava Kill Logic
lavaPart.Touched:Connect(function(hit)
    if not lavaActive then return end
    local humanoid = hit.Parent and hit.Parent:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health > 0 then
        humanoid.Health = 0
    end
end)

-- Helper: Countdown timer that updates the top banner every second
local function runTimer(label, seconds)
    for i = seconds, 1, -1 do
        eventStatus.Value = label .. " (" .. i .. "s)"
        task.wait(1)
    end
end

-- ==========================================
-- EVENT 1: ZOMBIE RAID
-- ==========================================
local function startZombieRaid()
    lavaActive = false
    lavaPart.Transparency = 1
    local spawnedZombies = {}
    
    task.spawn(function()
        for i = 1, ZOMBIE_COUNT do
            local randomSpawn = zombieSpawns[math.random(1, #zombieSpawns)]
            local clone = zombieTemplate:Clone()
            clone:PivotTo(randomSpawn.CFrame + Vector3.new(0, 3, 0))
            clone.Parent = Workspace
            table.insert(spawnedZombies, clone)
            task.wait(0.4)
        end
    end)
    
    runTimer("ZOMBIE RAID! Survive the horde!", RAID_DURATION)
    
    for _, z in ipairs(spawnedZombies) do
        if z and z.Parent then z:Destroy() end
    end
end

-- ==========================================
-- EVENT 2: LAVA RISE
-- ==========================================
local function startLavaRise()
    lavaPart.Position = originalLavaPos
    lavaPart.Transparency = 0
    lavaActive = true
    
    local targetPos = originalLavaPos + Vector3.new(0, LAVA_RISE_HEIGHT, 0)
    local riseTween = TweenService:Create(lavaPart, TweenInfo.new(LAVA_RISE_TIME, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Position = targetPos})
    riseTween:Play()
    runTimer("LAVA IS RISING! Get to high ground!", LAVA_RISE_TIME)
    
    runTimer("LAVA AT PEAK! Stay high!", LAVA_HOLD_TIME)
    
    local lowerTime = math.floor(LAVA_RISE_TIME / 2)
    local lowerTween = TweenService:Create(lavaPart, TweenInfo.new(lowerTime, Enum.EasingStyle.Sine, Enum.EasingDirection.In), {Position = originalLavaPos})
    lowerTween:Play()
    runTimer("Lava is receding...", lowerTime)
    
    lavaActive = false
    lavaPart.Transparency = 1
end

-- ==========================================
-- EVENT 3: WINDSTORM & TORNADOS
-- ==========================================
local function startWindstorm()
    lavaActive = false
    lavaPart.Transparency = 1
    
    local stormActive = true
    local tornados = {}
    local windDirection = Vector3.new(1, 0, 0.4).Unit
    
    for i = 1, TORNADO_COUNT do
        local spawnRef = zombieSpawns[math.random(1, #zombieSpawns)]
        local tornado = Instance.new("Part")
        tornado.Name = "Tornado"
        tornado.Shape = Enum.PartType.Cylinder
        tornado.Size = Vector3.new(65, 16, 16)
        tornado.CFrame = CFrame.new(spawnRef.Position + Vector3.new(0, 30, 0)) * CFrame.Angles(0, 0, math.rad(90))
        tornado.Anchored = true
        tornado.CanCollide = false
        tornado.Material = Enum.Material.ForceField
        tornado.Color = Color3.fromRGB(190, 210, 225)
        tornado.Transparency = 0.35
        tornado.Parent = Workspace
        table.insert(tornados, tornado)
        
        tornado.Touched:Connect(function(hit)
            if not stormActive then return end
            local root = hit.Parent and hit.Parent:FindFirstChild("HumanoidRootPart")
            if root then
                root.AssemblyLinearVelocity = Vector3.new(math.random(-60, 60), 75, math.random(-60, 60))
            end
        end)
    end
    
    local windConnection = RunService.Heartbeat:Connect(function(dt)
        if not stormActive then return end
        local angle = tick() * 0.25
        windDirection = Vector3.new(math.cos(angle), 0, math.sin(angle)).Unit
        
        for _, model in ipairs(Workspace:GetChildren()) do
            local hum = model:FindFirstChildOfClass("Humanoid")
            local root = model:FindFirstChild("HumanoidRootPart")
            if hum and root and hum.Health > 0 then
                root.AssemblyLinearVelocity = Vector3.new(
                windDirection.X * WIND_FORCE,
                root.AssemblyLinearVelocity.Y,
                windDirection.Z * WIND_FORCE
                )
            end
        end
        
        for idx, tornado in ipairs(tornados) do
            local moveAngle = (tick() * 0.8) + (idx * 2)
            local drift = Vector3.new(math.cos(moveAngle) * 28 * dt, 0, math.sin(moveAngle) * 28 * dt)
            tornado.CFrame = (tornado.CFrame + drift) * CFrame.Angles(5 * dt, 0, 0)
        end
    end)
    
    runTimer("HEAVY WINDSTORM! Watch out for tornados!", WIND_DURATION)
    
    stormActive = false
    windConnection:Disconnect()
    for _, t in ipairs(tornados) do
        if t and t.Parent then t:Destroy() end
    end
end

-- ==========================================
-- EVENT 4: BLOOD NIGHT
-- ==========================================
local function startBloodNight()
    lavaActive = false
    lavaPart.Transparency = 1
    local bloodActive = true
    local spawnedZombies = {}
    
    Lighting.ClockTime = 0
    Lighting.FogColor = Color3.fromRGB(130, 10, 10)
    Lighting.Ambient = Color3.fromRGB(110, 20, 20)
    Lighting.FogStart = 10
    Lighting.FogEnd = 85
    
    task.spawn(function()
        for i = 1, BLOOD_ZOMBIE_COUNT do
            if not bloodActive then break end
            local randomSpawn = zombieSpawns[math.random(1, #zombieSpawns)]
            local clone = zombieTemplate:Clone()
            clone:PivotTo(randomSpawn.CFrame + Vector3.new(0, 3, 0))
            
            local hum = clone:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.MaxHealth = hum.MaxHealth * 2
                hum.Health = hum.MaxHealth
                hum.WalkSpeed = hum.WalkSpeed + 6
            end
            for _, part in ipairs(clone:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.Color = Color3.fromRGB(180, 30, 30)
                end
            end
            
            clone.Parent = Workspace
            table.insert(spawnedZombies, clone)
            
            task.spawn(function()
                while bloodActive and clone and clone.Parent do
                    task.wait(math.random(25, 45) / 10)
                    local root = clone:FindFirstChild("HumanoidRootPart")
                    local zHum = clone:FindFirstChildOfClass("Humanoid")
                    if root and zHum and zHum.Health > 0 then
                        root.AssemblyLinearVelocity = (root.CFrame.LookVector * 65) + Vector3.new(0, 18, 0)
                    end
                end
            end)
            
            task.wait(0.4)
        end
    end)
    
    runTimer("BLOOD NIGHT! Dashing zombies in the fog!", BLOOD_NIGHT_DURATION)
    
    bloodActive = false
    for _, z in ipairs(spawnedZombies) do
        if z and z.Parent then z:Destroy() end
    end
    
    Lighting.ClockTime = defaultClockTime
    Lighting.FogEnd = defaultFogEnd
    Lighting.FogStart = defaultFogStart
    Lighting.FogColor = defaultFogColor
    Lighting.Ambient = defaultAmbient
end

-- ==========================================
-- EVENT 5: INVISIBLE STALKERS
-- ==========================================
local function startInvisibleStalkers()
    lavaActive = false
    lavaPart.Transparency = 1
    local spawnedZombies = {}
    
    task.spawn(function()
        for i = 1, INVISIBLE_ZOMBIE_COUNT do
            local randomSpawn = zombieSpawns[math.random(1, #zombieSpawns)]
            local clone = zombieTemplate:Clone()
            clone:PivotTo(randomSpawn.CFrame + Vector3.new(0, 3, 0))
            
            -- Make all parts of the zombie completely invisible
            for _, part in ipairs(clone:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.Transparency = 1
                end
            end
            
            clone.Parent = Workspace
            table.insert(spawnedZombies, clone)
            task.wait(0.4)
        end
    end)
    
    runTimer("INVISIBLE STALKERS! The zombies have vanished!", INVISIBLE_DURATION)
    
    for _, z in ipairs(spawnedZombies) do
        if z and z.Parent then z:Destroy() end
    end
end

-- ==========================================
-- MAIN GAME LOOP (Anti-Repeat Randomizer for 5 Events)
-- ==========================================
local rng = Random.new()
local lastEvent = nil

while true do
    runTimer("Next disaster in", TIME_BETWEEN_EVENTS)
    
    local choice
    repeat
    choice = rng:NextInteger(1, 5) -- Now cycles between all 5 events!
    until choice ~= lastEvent
    
    lastEvent = choice
    
    if choice == 1 then
        startZombieRaid()
    elseif choice == 2 then
        startLavaRise()
    elseif choice == 3 then
        startWindstorm()
    elseif choice == 4 then
        startBloodNight()
    elseif choice == 5 then
        startInvisibleStalkers()
    end
end

]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8146500041fa</UniqueId>
