<ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local button = script.Parent
 
local ChangeCharacterEvent = ReplicatedStorage:WaitForChild("ChangeCharacterEvent2")
 
button.MouseButton1Click:Connect(function()
    -- Tells the server the player wants to morph
    ChangeCharacterEvent:FireServer()
end)

]]></ProtectedString>
