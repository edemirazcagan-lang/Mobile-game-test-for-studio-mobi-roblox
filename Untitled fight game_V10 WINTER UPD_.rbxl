<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local tool = script.Parent
local damageAmount = 10 -- How much damage to deal
local damageRadius = 15 -- How close enemies need to be (in studs)
local damageInterval = 0.5 -- How often to deal damage (in seconds)
 
local isActive = false
local lastDamageTime = 0
 
-- Function to check surroundings and deal damage
local function damageNearbyTargets(playerCharacter)
    local hrp = playerCharacter:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    -- Look through all objects in the workspace
    for _, object in ipairs(workspace:GetDescendants()) do
        -- Make sure it's a character with a Humanoid and not the player holding the tool
        if object:IsA("Model") and object ~= playerCharacter then
            local targetHumanoid = object:FindFirstChildOfClass("Humanoid")
            local targetHrp = object:FindFirstChild("HumanoidRootPart")
            
            if targetHumanoid and targetHrp and targetHumanoid.Health > 0 then
                -- Calculate the distance between the player and the target
                local distance = (hrp.Position - targetHrp.Position).Magnitude
                
                if distance <= damageRadius then
                    targetHumanoid:TakeDamage(damageAmount)
                end
            end
        end
    end
end
 
-- Triggered when the player equips the tool
tool.Equipped:Connect(function()
    isActive = true
    local character = tool.Parent
    
    -- Keep checking for targets while the tool is equipped
    task.spawn(function()
        while isActive do
            local currentTime = tick()
            if currentTime - lastDamageTime >= damageInterval then
                damageNearbyTargets(character)
                lastDamageTime = currentTime
            end
            task.wait(0.1) -- Frequent checks for responsive targeting
        end
    end)
end)
 
-- Triggered when the player unequips the tool
tool.Unequipped:Connect(function()
    isActive = false
end)

]]></ProtectedString>
