<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[Tool = script.Parent
Handle = Tool.Handle
 
function plant(pos)
    local vCharacter = Tool.Parent
    local vPlayer = game.Players:playerFromCharacter(vCharacter)
    
    local mine = Handle:Clone()
    mine.CanCollide = true
    mine.Transparency = 0
    mine.Position = pos
    mine.Size = Vector3.new(2,2,2)
    mine.Name = "SubspaceTripmine"
    mine.Locked = true
    mine.Parent = workspace
    mine.Bomb.Enabled = true
    mine:SetAttribute("IsImmune", Tool:GetAttribute("IsImmune"))
end
 
Tool.Enabled = true
 
function playSound(sound)
    sound:Play()
    
    for _, osound in pairs(sound:GetChildren()) do
        if osound:IsA("Sound") then
            local nsound = osound:Clone()
            nsound.Parent = sound.Parent
            nsound:Play()
            
            nsound.Ended:Connect(function()
                nsound:Destroy()
            end)
        end
    end
end
 
function onEquipped()
    Handle.Owner.Value = Tool.Parent
    playSound(Handle.Equip)
    playSound(Handle.Rumble)
end
 
function onUnequipped()
    Handle.Rumble:Stop()
end
 
function onActivated()
    if not Tool.Enabled then
        return
    end
    
    Tool.Enabled = false
    
    local character = Tool.Parent;
    local humanoid = character.Humanoid
    
    if humanoid == nil and humanoid.Health > 0 then
        return 
    end
    
    local targetPos = humanoid.TargetPoint
    Handle.Transparency = 1
    plant(Handle.Position)
    
    for _, fx in pairs(Handle:GetDescendants()) do
        if fx:IsA("ParticleEmitter") or fx:IsA("Light") then
            fx.Enabled = false
        end
    end
    
    playSound(Handle.Activate)
    Handle.Rumble.Volume = 0
    
    task.wait(1)
    
    Handle.Rumble.Volume = .5
    
    for _, fx in pairs(Handle:GetDescendants()) do
        if fx:IsA("ParticleEmitter") or fx:IsA("Light") then
            fx.Enabled = true
        end
    end
    
    Handle.Transparency = 0
    Tool.Enabled = true
end
 
Tool.Equipped:Connect(onEquipped)
Tool.Unequipped:Connect(onUnequipped)
Tool.Activated:Connect(onActivated)

]]></ProtectedString>
