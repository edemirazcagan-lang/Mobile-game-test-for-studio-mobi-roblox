<Item class="Script" referent="RBX66C1625455D04AC580D8112817513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">true</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script3</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local character = script.Parent
local humanoid = character:WaitForChild("Humanoid")

-- This loop runs forever
while true do
    -- Check if the character is missing health
    if humanoid.Health < humanoid.MaxHealth then
        humanoid.Health = humanoid.Health + 15 -- Adds 5 HP
    end
    
    task.wait(1) -- Wait 1 second before healing again
end


]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8128180041fa</UniqueId>
