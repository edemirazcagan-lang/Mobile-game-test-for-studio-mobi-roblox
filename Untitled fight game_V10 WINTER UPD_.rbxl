<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[-- Script inside SunRayGun
local Tool = script.Parent
local ShootEvent = Tool:WaitForChild("ShootEvent")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService") -- Used for low-overhead visual fading
 
-- Weapon Configurations
local BASE_DAMAGE = 15
local BASE_PULL_FORCE = 60
local BASE_RAY_COUNT = 3
local COOLDOWN = 0.6
 
-- Enrage Configurations
local ENRAGE_DAMAGE = 35
local ENRAGE_PULL_FORCE = 120
local ENRAGE_RAY_COUNT = 7
local ENRAGE_COOLDOWN = 0.2
local ENRAGE_DURATION = 8.0
 
-- States
local canShoot = true
local isEnraged = false
local ownerPlayer = nil
 
-- Optimized Visual effect generator using TweenService (Zero extra threads created)
local function drawSunRay(startPos, endPos)
    local rayPart = Instance.new("Part")
    rayPart.Size = Vector3.new(0.3, 0.3, (startPos - endPos).Magnitude)
    rayPart.CFrame = CFrame.new(startPos:Lerp(endPos, 0.5), endPos)
    rayPart.Anchored = true
    rayPart.CanCollide = false
    rayPart.Material = Enum.Material.Neon
    rayPart.Color = isEnraged and Color3.fromRGB(255, 65, 0) or Color3.fromRGB(255, 205, 55)
    rayPart.Parent = workspace
    
    -- Use TweenService to fade out. This handles animations internally without leaking threads.
    local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tween = TweenService:Create(rayPart, tweenInfo, {Transparency = 1, Size = Vector3.new(0, 0, rayPart.Size.Z)})
    
    tween:Play()
    
    -- Clean up the instance after the tween finishes
    tween.Completed:Connect(function()
        rayPart:Destroy()
        tween:Destroy()
    end)
end
 
-- Levitation Physics
local function applyLevitation(character)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local attachment = hrp:FindFirstChild("SunLevitateAttach") or Instance.new("Attachment")
    attachment.Name = "SunLevitateAttach"
    attachment.Parent = hrp
    
    local linearVelocity = Instance.new("LinearVelocity")
    linearVelocity.Name = "SunLevitationForce"
    linearVelocity.Attachment0 = attachment
    linearVelocity.MaxForce = 60000
    linearVelocity.VectorVelocity = Vector3.new(0, 6, 0)
    linearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    linearVelocity.Parent = hrp
    
    task.delay(0.4, function()
        if linearVelocity and linearVelocity.Parent then
            linearVelocity.VectorVelocity = Vector3.new(0, 0, 0)
        end
    end)
    
    task.delay(ENRAGE_DURATION, function()
        if linearVelocity then linearVelocity:Destroy() end
        if attachment then attachment:Destroy() end
    end)
end
 
-- Turns on Enrage Mode
local function triggerEnrage(character, player)
    if isEnraged then return end
    isEnraged = true
    applyLevitation(character)
    
    local highlight = Instance.new("Highlight")
    highlight.FillColor = Color3.fromRGB(255, 80, 0)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.Parent = character
    
    local pGui = player:FindFirstChild("PlayerGui")
    local btn = pGui and pGui:FindFirstChild("SunRayGui") and pGui.SunRayGui:FindFirstChild("EnrageButton")
    if btn then
        btn.Text = "ENRAGED active!"
        btn.TextColor3 = Color3.fromRGB(255, 50, 50)
    end
    
    task.delay(ENRAGE_DURATION, function()
        isEnraged = false
        if highlight then highlight:Destroy() end
        if btn then
            btn.Text = "ACTIVATE ENRAGE"
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        end
    end)
end
 
-- Automatically builds and displays the Enrage ScreenGui dynamically
local function createEnrageGui(player)
    local playerGui = player:WaitForChild("PlayerGui", 5)
    if not playerGui or playerGui:FindFirstChild("SunRayGui") then return end
    
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "SunRayGui"
    screenGui.ResetOnSpawn = false
    
    local textButton = Instance.new("TextButton")
    textButton.Name = "EnrageButton"
    textButton.Size = UDim2.new(0, 180, 0, 50)
    textButton.Position = UDim2.new(0.5, -90, 0.85, 0)
    textButton.BackgroundColor3 = Color3.fromRGB(255, 255, 0)
    textButton.Text = "ACTIVATE ENRAGE"
    textButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    textButton.TextSize = 16
    textButton.Font = Enum.Font.SourceSansBold
    textButton.Active = true
    
    local uiCorner = Instance.new("UICorner")
    uiCorner.CornerRadius = UDim.new(0, 8)
    uiCorner.Parent = textButton
    
    textButton.Parent = screenGui
    screenGui.Parent = playerGui
    
    textButton.MouseButton1Click:Connect(function()
        local char = player.Character
        if char and Tool.Parent == char then
            triggerEnrage(char, player)
        end
    end)
end
 
local function removeEnrageGui(player)
    local playerGui = player and player:FindFirstChild("PlayerGui")
    local existingGui = playerGui and playerGui:FindFirstChild("SunRayGui")
    if existingGui then existingGui:Destroy() end
end
 
Tool.Equipped:Connect(function()
    local player = Players:GetPlayerFromCharacter(Tool.Parent)
    if player then 
        ownerPlayer = player
        createEnrageGui(player) 
    end
end)
 
Tool.Unequipped:Connect(function()
    if ownerPlayer then 
        removeEnrageGui(ownerPlayer)
        ownerPlayer = nil
    end
end)
 
-- Central event network logic
ShootEvent.OnServerEvent:Connect(function(player, argument)
    local character = player.Character
    if not character or Tool.Parent ~= character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    if argument == "TriggerEnrage" then
        triggerEnrage(character, player)
        return
    end
    
    local targetPosition = argument
    if typeof(targetPosition) ~= "Vector3" or not canShoot then return end
    canShoot = false
    
    local currentRayCount = isEnraged and ENRAGE_RAY_COUNT or BASE_RAY_COUNT
    local currentDamage = isEnraged and ENRAGE_DAMAGE or BASE_DAMAGE
    local currentPull = isEnraged and ENRAGE_PULL_FORCE or BASE_PULL_FORCE
    local currentCooldown = isEnraged and ENRAGE_COOLDOWN or COOLDOWN
    
    local fireOrigin = Tool:FindFirstChild("Handle") and Tool.Handle.Position or hrp.Position
    
    -- Fire Multiple Rays
    for i = 1, currentRayCount do
        local spread = isEnraged and 9 or 4
        local spreadOffset = Vector3.new(
        math.random(-spread, spread),
        math.random(-spread, spread),
        math.random(-spread, spread)
        )
        local modifiedTarget = targetPosition + spreadOffset
        
        local raycastParams = RaycastParams.new()
        raycastParams.FilterDescendantsInstances = {character}
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude
        
        local result = workspace:Raycast(fireOrigin, (modifiedTarget - fireOrigin).Unit * 400, raycastParams)
        local hitPosition = modifiedTarget
        
        if result then
            hitPosition = result.Position
            local hitPart = result.Instance
            local enemyModel = hitPart.Parent:IsA("Model") and hitPart.Parent or hitPart.Parent.Parent:IsA("Model") and hitPart.Parent.Parent
            
            if enemyModel and enemyModel:FindFirstChild("Humanoid") and enemyModel ~= character then
                enemyModel.Humanoid:TakeDamage(currentDamage)
                
                local enemyHRP = enemyModel:FindFirstChild("HumanoidRootPart")
                if enemyHRP then
                    local pullDirection = (hrp.Position - enemyHRP.Position).Unit
                    enemyHRP.AssemblyLinearVelocity = pullDirection * currentPull
                end
            end
        end
        
        -- Renders visually without straining the thread scheduler
        drawSunRay(fireOrigin, hitPosition)
    end
    
    task.wait(currentCooldown)
    canShoot = true
end)
 

]]></ProtectedString>
