<string name="Name">WepColorScript</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Wep = script.Parent.Parent
local WepColor = script.Parent
function colorChange()
	for NO, wep in pairs(Wep:GetChildren()) do
		if wep.Name == "Color" or wep.Name == "HandleColor" then
			wep.BrickColor = WepColor.Value
		end
	end
end
colorChange()
WepColor.Changed:connect(function(color)
	colorChange()
end)
]]></ProtectedString>
