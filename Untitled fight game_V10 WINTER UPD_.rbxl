<ProtectedString name="Source"><![CDATA[--GuiHideLocal   --  This local script is typically placed inside a Close or Exit TextButton with text set to a red X.
--                   The button usually goes in the top-right corner of a Frame.  This script hides the frame when the button is clicked.
script.Parent.Activated:Connect(function()
	script.Parent.Parent.Visible = false
end)]]></ProtectedString>
