<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454114619AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">LocalScript</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

-- UI References
local screenGui = script.Parent
local mainFrame = screenGui:WaitForChild("MainFrame")
local playButton = mainFrame:WaitForChild("PlayButton")
local creditsButton = mainFrame:WaitForChild("CreditsButton")
local creditsFrame = screenGui:WaitForChild("CreditsFrame")
local closeCreditsButton = creditsFrame:WaitForChild("CloseCreditsButton")

-- Tween Settings
local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

-- 1. Hide all other gameplay GUIs initially
local function setGameplayGuiVisible(visible)
    for _, gui in ipairs(PlayerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui ~= screenGui then
            gui.Enabled = visible
        end
    end
end

setGameplayGuiVisible(false) -- Hide game UI on start

-- 2. Credits Logic (Smooth pull down from top)
local creditsOpenPos = UDim2.new(0.5, -200, 0.2, 0)   -- Center of the screen (Adjust anchor point to 0.5, 0)
local creditsClosePos = UDim2.new(0.5, -200, -0.6, 0) -- Safely above the screen

-- Set credits anchor point for easier centering
creditsFrame.AnchorPoint = Vector2.new(0.5, 0)

creditsButton.MouseButton1Click:Connect(function()
    local tween = TweenService:Create(creditsFrame, tweenInfo, {Position = creditsOpenPos})
    tween:Play()
end)

closeCreditsButton.MouseButton1Click:Connect(function()
    local tween = TweenService:Create(creditsFrame, tweenInfo, {Position = creditsClosePos})
    tween:Play()
end)

-- 3. Play Button Logic (Smooth Fade Out & Reveal Game)
if game.Lighting:FindFirstChild("MenuBlur") then
    TweenService:Create(game.Lighting.MenuBlur, tweenInfo, {Size = 0}):Play()
end
playButton.MouseButton1Click:Connect(function()
    -- Disable buttons immediately so they can't be clicked twice
    playButton.Active = false
    creditsButton.Active = false
    
    -- Fade out all elements inside MainFrame
    for _, child in ipairs(mainFrame:GetChildren()) do
        if child:IsA("TextLabel") or child:IsA("TextButton") then
            TweenService:Create(child, tweenInfo, {TextTransparency = 1, BackgroundTransparency = 1}):Play()
        elseif child:IsA("ImageLabel") then
            TweenService:Create(child, tweenInfo, {ImageTransparency = 1, BackgroundTransparency = 1}):Play()
        elseif child:IsA("Frame") then
            TweenService:Create(child, tweenInfo, {BackgroundTransparency = 1}):Play()
        end
    end
    
    -- If your MainFrame itself has a background color, fade it too
    local mainTween = TweenService:Create(mainFrame, tweenInfo, {BackgroundTransparency = 1})
    mainTween:Play()
    
    -- Wait for the fade animation to finish, then enable game UI and destroy menu
    mainTween.Completed:Connect(function()
        setGameplayGuiVisible(true) -- Show the rest of the game's UI
        screenGui:Destroy()         -- Delete the main menu
    end)
end)



]]></ProtectedString>
