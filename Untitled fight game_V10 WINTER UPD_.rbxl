<ProtectedString name="Source"><![CDATA[local BadgeService = game:GetService("BadgeService")
local badgeId = 2964078360840363 -- Replace this with your Badge ID

game.Players.PlayerAdded:Connect(function(player)
    -- Check if the player owns the badge
    local success, hasBadge = pcall(function()
        return BadgeService:UserHasBadgeAsync(player.UserId, badgeId)
    end)
    
    -- If they have it, copy the tool to their backpack
    if success and hasBadge then
        local tool = game.ServerStorage:WaitForChild("CheeseWand"):Clone()
        tool.Parent = player.StarterGear -- Gives it to them every time they respawn
        tool:Clone().Parent = player.Backpack -- Gives it to them right now
    end
end)

