<Item class="Script" referent="RBX66C1625455D04AC580D8100421513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">true</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
 
local bossModel = script.Parent
local bossRoot = bossModel:WaitForChild("HumanoidRootPart")
 
-- CONFIGURATION
local DETECTION_RADIUS = 15 -- How close the player gets to trigger the effect
local DAMAGE_PER_SECOND = 10
local BURN_DURATION = 5 -- How long they burn after leaving the radius
local CHECK_INTERVAL = 0.5 -- How often the server checks player distance
 
-- RemoteEvent to signal the client to reverse controls and blind the screen
local bossEvent = Instance.new("RemoteEvent")
bossEvent.Name = "BossAuraEvent"
bossEvent.Parent = game:GetService("ReplicatedStorage")
 
-- Track players currently burning to avoid duplicating the effect
local burningPlayers = {}
 
local function applyBurnEffect(character, player)
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not rootPart or burningPlayers[player] then return end
    
    burningPlayers[player] = true
    
    -- Create Fire Effect
    local fire = Instance.new("Fire")
    fire.Size = 5
    fire.Heat = 9
    fire.Parent = rootPart
    
    -- Burn loop
    task.spawn(function()
        -- Keep burning as long as they are close OR the cooldown duration hasn't finished
        while character and character.Parent and humanoid.Health > 0 do
            local distance = (rootPart.Position - bossRoot.Position).Magnitude
            
            if distance <= DETECTION_RADIUS then
                -- Inside zone: Damage them and reset/maintain burn timer
                humanoid:TakeDamage(DAMAGE_PER_SECOND * CHECK_INTERVAL)
                task.wait(CHECK_INTERVAL)
            else
                -- Left zone: Apply lingering damage
                for i = 1, BURN_DURATION do
                    if not character or not character.Parent or humanoid.Health <= 0 then break end
                    
                    -- Double check they didn't run back in
                    local currentDist = (rootPart.Position - bossRoot.Position).Magnitude
                    if currentDist <= DETECTION_RADIUS then break end 
                        
                        humanoid:TakeDamage(DAMAGE_PER_SECOND)
                        task.wait(1)
                    end
                    
                    -- If they stayed out, break the loop and clean up
                    local finalDist = (rootPart.Position - bossRoot.Position).Magnitude
                    if finalDist > DETECTION_RADIUS then
                        break
                    end
                end
            end
            
            -- Clean up once burning stops
            fire:Destroy()
            burningPlayers[player] = nil
            -- Tell client to stop the screen effects if they haven't already
            bossEvent:FireClient(player, false) 
        end)
    end
    
    -- Main loop to detect nearby players
    task.spawn(function()
        while true do
            for _, player in ipairs(Players:GetPlayers()) do
                local character = player.Character
                if character and character:FindFirstChild("HumanoidRootPart") then
                    local playerRoot = character.HumanoidRootPart
                    local distance = (playerRoot.Position - bossRoot.Position).Magnitude
                    
                    if distance <= DETECTION_RADIUS then
                        -- Tell client to activate blinding and reversed movement
                        bossEvent:FireClient(player, true)
                        -- Start the server-side burn and damage loop
                        applyBurnEffect(character, player)
                    else
                        -- If they are far away and not in the burning cycle, ensure effects are off
                        if not burningPlayers[player] then
                            bossEvent:FireClient(player, false)
                        end
                    end
                end
            end
            task.wait(CHECK_INTERVAL)
        end
    end)

]]></ProtectedString>
