<Item class="Script" referent="RBX66C1625455D04AC580D8115035513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[-- Server Script inside the Tool
local Tool = script.Parent
local Debris = game:GetService("Debris")

-- CONFIGURATION
local DAMAGE_AMOUNT = 65      -- How much damage the trail deals
local TRAIL_LIFETIME = 3     -- How many seconds a trail part lasts before disappearing
local SPAWN_RATE = 0.1        -- How often a new trail part spawns (Prevents script crash/lag)
local TRAIL_SIZE = Vector3.new(2, 0.2, 2) -- Size of the trail parts

local isHolding = false

-- Function to handle the passive trail creation
local function startTrail(character, player)
    local humanoidRootPart = character:WaitForChild("HumanoidRootPart")
    
    while isHolding and character and character:FindFirstChild("Humanoid") and character.Humanoid.Health > 0 do
        -- Create the trail part
        local trailPart = Instance.new("Part")
        trailPart.Size = TRAIL_SIZE
        trailPart.Anchored = true
        trailPart.CanCollide = false
        
        -- Position it slightly above the ground at the player's feet
        trailPart.CFrame = humanoidRootPart.CFrame * CFrame.new(0, -2, 0)
        
        -- Visuals: White (Blanco) Smooth Plastic
        trailPart.Material = Enum.Material.SmoothPlastic
        trailPart.Color = Color3.fromRGB(17, 17, 17) -- White
        trailPart.Transparency = 0.2
        
        -- Visuals: Red Outline
        local outline = Instance.new("SelectionBox")
        outline.Color3 = Color3.fromRGB(255, 0, 0) -- Red
        outline.LineThickness = 0.05
        outline.Adornee = trailPart
        outline.Parent = trailPart
        
        trailPart.Parent = workspace
        
        -- Automatically delete the part after its lifetime expires
        Debris:AddItem(trailPart, TRAIL_LIFETIME)
        
        -- Damage Logic
        trailPart.Touched:Connect(function(hit)
            local hitCharacter = hit.Parent
            if hitCharacter and hitCharacter:IsA("Model") then
                local hitHumanoid = hitCharacter:FindFirstChildOfClass("Humanoid")
                
                -- Check if it hit a humanoid and ensure it is NOT the player holding the tool
                if hitHumanoid and hitCharacter ~= character then
                    hitHumanoid:TakeDamage(DAMAGE_AMOUNT)
                end
            end
        end)
        
        -- The wait that prevents Roblox from freezing/force-ending the script
        task.wait(SPAWN_RATE)
    end
end

-- Detect when the player equips the tool
Tool.Equipped:Connect(function()
    local character = Tool.Parent
    local player = game.Players:GetPlayerFromCharacter(character)
    
    if character and player then
        isHolding = true
        startTrail(character, player)
    end
end)

-- Detect when the player unequips the tool
Tool.Unequipped:Connect(function()
    isHolding = false
end)

]]></ProtectedString>
