<Item class="Script" referent="RBX66C1625455D04AC580D8115185513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local tool = script.Parent
local handle = tool:WaitForChild("Handle")
 
-- Configurable Settings
local BASE_DAMAGE = 750
local CRIT_DAMAGE = 950
local CRIT_CHANCE = 0.70 -- 70% chance to do a powerful slash
local ATTACK_COOLDOWN = 0.8
 
local canAttack = true
local hasHitTable = {} -- Prevents damaging the same target multiple times *in one swing*
 
-- Function to handle dealing damage
local function onTouch(otherPart)
    local character = otherPart.Parent
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    -- Ensure it's a valid target, alive, and not the wielder of the sword
    if humanoid and humanoid.Health > 0 and character ~= tool.Parent then
        -- Check if we haven't hit this specific enemy during this swing yet
        if not hasHitTable[character] then
            hasHitTable[character] = true -- Lock this enemy out for the rest of THIS swing
            
            -- Roll for a random powerful slash
            local isCrit = math.random() <= CRIT_CHANCE
            
            if isCrit then
                humanoid:TakeDamage(CRIT_DAMAGE)
                print("Critical Slash on " .. character.Name .. "! Dealt " .. CRIT_DAMAGE .. " damage.")
                
                -- Visual cue (Spawned in a separate thread so it doesn't pause the swing cooldown)
                task.spawn(function()
                    local originalColor = handle.BrickColor
                    handle.BrickColor = BrickColor.new("Bright red")
                    task.wait(0.2)
                    handle.BrickColor = originalColor
                end)
            else
                humanoid:TakeDamage(BASE_DAMAGE)
                print("Normal Slash on " .. character.Name .. ". Dealt " .. BASE_DAMAGE .. " damage.")
            end
        end
    end
end
 
-- Function triggered when the player clicks/activates the tool
local function onActivated()
    if not canAttack then return end
    canAttack = false
    
    table.clear(hasHitTable) -- Clear the table so ALL enemies can be hit again for this new swing
    
    -- Connect the touch detection
    local touchConnection = handle.Touched:Connect(onTouch)
    
    task.wait(ATTACK_COOLDOWN) -- Duration of the hitbox/swing phase
    
    touchConnection:Disconnect() -- Turn off hitbox
    canAttack = true
end
 
tool.Activated:Connect(onActivated)
 

]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8151860041fa</UniqueId>
</Properties>
</Item>
<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454115187AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">LocalScript</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local tool = script.Parent
local damageAmount = 9000 -- How much damage to deal
local damageRadius = 45 -- How close enemies need to be (in studs)
local damageInterval = 0.5 -- How often to deal damage (in seconds)
 
local isActive = false
local lastDamageTime = 0
 
-- Function to check surroundings and deal damage
local function damageNearbyTargets(playerCharacter)
    local hrp = playerCharacter:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    -- Look through all objects in the workspace
    for _, object in ipairs(workspace:GetDescendants()) do
        -- Make sure it's a character with a Humanoid and not the player holding the tool
        if object:IsA("Model") and object ~= playerCharacter then
            local targetHumanoid = object:FindFirstChildOfClass("Humanoid")
            local targetHrp = object:FindFirstChild("HumanoidRootPart")
            
            if targetHumanoid and targetHrp and targetHumanoid.Health > 0 then
                -- Calculate the distance between the player and the target
                local distance = (hrp.Position - targetHrp.Position).Magnitude
                
                if distance <= damageRadius then
                    targetHumanoid:TakeDamage(damageAmount)
                end
            end
        end
    end
end
 
-- Triggered when the player equips the tool
tool.Equipped:Connect(function()
    isActive = true
    local character = tool.Parent
    
    -- Keep checking for targets while the tool is equipped
    task.spawn(function()
        while isActive do
            local currentTime = tick()
            if currentTime - lastDamageTime >= damageInterval then
                damageNearbyTargets(character)
                lastDamageTime = currentTime
            end
            task.wait(0.1) -- Frequent checks for responsive targeting
        end
    end)
end)
 
-- Triggered when the player unequips the tool
tool.Unequipped:Connect(function()
    isActive = false
end)

]]></ProtectedString>
<UniqueId name="UniqueId">7bdf20b295fbe64d068941518800437f</UniqueId>
</Properties>
</Item>
<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454115189AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">LocalScript3</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local tool = script.Parent

local ACTION_NAME = "TimeStopAction"
local IS_TIME_STOPPED = false
local COOLDOWN = false
local COOLDOWN_TIME = 5 -- Seconds before you can use it again
local DURATION = 15 -- How long the time stop lasts

-- Store anchors states to restore them properly later
local anchoredParts = {}

-- Function to apply visual effects (Color Correction)
local function applyVisualEffect(isStopping)
    local lighting = game:GetService("Lighting")
    local cc = lighting:FindFirstChild("TimeStopCC") or Instance.new("ColorCorrectionEffect")
    cc.Name = "TimeStopCC"
    cc.Parent = lighting
    
    local targetSaturation = isStopping and -1 or 0
    local targetContrast = isStopping and 0.5 or 0
    
    local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tween = TweenService:Create(cc, tweenInfo, {
    Saturation = targetSaturation,
    Contrast = targetContrast
    })
    tween:Play()
end

-- Core Time Stop Logic
local function toggleTimeStop()
    if COOLDOWN then return end
    COOLDOWN = true
    IS_TIME_STOPPED = true
    
    applyVisualEffect(true)
    
    -- Freeze all parts in the workspace except the local player
    for _, desc in ipairs(Workspace:GetDescendants()) do
        if desc:IsA("BasePart") and not desc:IsDescendantOf(player.Character) then
            -- Save original anchored state if not already saved
            if anchoredParts[desc] == nil then
                anchoredParts[desc] = desc.Anchored
            end
            desc.Anchored = true
        end
    end
    
    -- Wait for duration
    task.wait(DURATION)
    
    -- Resume Time
    IS_TIME_STOPPED = false
    applyVisualEffect(false)
    
    for part, originalAnchored in pairs(anchoredParts) do
        if part and part.Parent then
            part.Anchored = originalAnchored
        end
    end
    table.clear(anchoredParts)
    
    -- Cooldown period
    task.wait(COOLDOWN_TIME)
    COOLDOWN = false
end

-- Handle the input across all devices
local function handleAction(actionName, inputState, inputObject)
    if inputState == Enum.UserInputState.Begin then
        toggleTimeStop()
    end
end

-- Bind action when tool is equipped
tool.Equipped:Connect(function()
    -- This binds Key 'E', Controller Button 'B', and automatically creates a Mobile Button
    ContextActionService:BindAction(
    ACTION_NAME, 
    handleAction, 
    true, -- true creates an on-screen button for mobile users
    Enum.KeyCode.E, 
    Enum.KeyCode.ButtonB
    )
    
    -- Optional: Style the mobile button
    local button = ContextActionService:GetButton(ACTION_NAME)
    if button then
        button.Title = "Time Stop"
        button.Size = UDim2.new(0, 60, 0, 60)
    end
end)

-- Unbind action when tool is unequipped
tool.Unequipped:Connect(function()
    ContextActionService:UnbindAction(ACTION_NAME)
end)

]]></ProtectedString>
<UniqueId name="UniqueId">7bdf20b295fbe64d068941519000437f</UniqueId>
</Properties>
</Item>
<Item class="Script" referent="RBX66C1625455D04AC580D8115191513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script2</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local tool = script.Parent
local healingAmount = 35 -- How much health to restore each tick
local healInterval = 1 -- How often to heal (in seconds)

-- Enhanced stats
local bonusSpeed = 100 -- Default is 16
local bonusJump = 150 -- Default is 50

local healingCoroutine = nil
local isEquipped = false

-- Function to handle continuous healing
local function startHealing(humanoid)
    healingCoroutine = task.spawn(function()
        while isEquipped and humanoid and humanoid.Health > 0 do
            if humanoid.Health < humanoid.MaxHealth then
                humanoid.Health = math.min(humanoid.Health + healingAmount, humanoid.MaxHealth)
            end
            task.wait(healInterval)
        end
    end)
end

-- When the player holds the item
tool.Equipped:Connect(function()
    local character = tool.Parent
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    if humanoid then
        isEquipped = true
        
        -- Apply Speed and Jump boosts
        humanoid.WalkSpeed = bonusSpeed
        humanoid.UseJumpHeight = true -- Ensures JumpHeight is used instead of JumpPower
        humanoid.JumpHeight = bonusJump 
        
        -- Start the healing loop
        startHealing(humanoid)
    end
end)

-- When the player puts the item away
tool.Unequipped:Connect(function()
    isEquipped = false
    if healingCoroutine then
        healingCoroutine = nil -- Stops the healing loop
    end
    
    -- Find the character (it moves back to the player's backpack)
    local player = tool.Parent.Parent
    if player and player:IsA("Player") and player.Character then
        local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            -- Reset to default Roblox stats
            humanoid.WalkSpeed = 16
            humanoid.JumpHeight = 7.2 -- Default Roblox jump height
        end
    end
end)

]]></ProtectedString>
