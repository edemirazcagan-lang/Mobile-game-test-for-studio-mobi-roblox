<Item class="Script" referent="RBX66C1625455D04AC580D8100327513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script2</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local boss = script.Parent
local ServerStorage = game:GetService("ServerStorage")
local minionTemplate = ServerStorage:WaitForChild("Minion")

local hits = 0
local maxHits = 3
local isOnCooldown = false -- This tracks if the boss is waiting
local cooldownTime = 1.5 -- How many seconds to wait

boss.Humanoid.HealthChanged:Connect(function()
    -- If the boss is on cooldown, stop the function early
    if isOnCooldown then return end
    
    hits = hits + 1
    
    if hits >= maxHits then
        isOnCooldown = true -- Start the cooldown
        
        local newMinion = minionTemplate:Clone()
        newMinion.Parent = game.Workspace
        newMinion:MoveTo(boss.HumanoidRootPart.Position + Vector3.new(5, 0, 0))
        
        hits = 0 
        
        task.wait(cooldownTime) -- Wait for 5 seconds
        isOnCooldown = false -- Cooldown is over!
    end
end)


]]></ProtectedString>
