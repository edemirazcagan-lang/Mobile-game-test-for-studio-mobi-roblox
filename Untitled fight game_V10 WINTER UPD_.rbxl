<Item class="Script" referent="RBX66C1625455D04AC580D8100319513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script2</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local npc = script.Parent
local root = npc:WaitForChild("HumanoidRootPart")
 
-- Settings
local range = 65
local damage = 666  
function spawnMeteor(targetPos)
    local meteor = Instance.new("Part")
    meteor.Shape = Enum.PartType.Ball
    meteor.Size = Vector3.new(10,10, 10)
    meteor.Color = Color3.fromRGB(255, 100, 0)
    meteor.Material = Enum.Material.Neon
    meteor.Position = targetPos + Vector3.new(0, 40, 0) -- Start high up
    meteor.Parent = game.Workspace
    
    -- Make it fall fast
    meteor.Velocity = Vector3.new(0, -100, 0)
    
    -- Damage when it hits
    meteor.Touched:Connect(function(hit)
        local hum = hit.Parent:FindFirstChild("Humanoid")
        if hum then
            hum:TakeDamage(damage)
        end
        meteor:Destroy() -- Disappear after hitting
    end)
end
 
while true do
    task.wait(2) -- Wait 2 seconds between attacks
    for _, player in pairs(game.Players:GetPlayers()) do
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local dist = (root.Position - char.HumanoidRootPart.Position).Magnitude
            if dist < range then
                spawnMeteor(char.HumanoidRootPart.Position)
            end
        end
    end
end
 

]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8003200041fa</UniqueId>
</Properties>
</Item>
<Item class="Script" referent="RBX66C1625455D04AC580D8100321513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script2</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local boss = script.Parent
local body = boss:WaitForChild("HumanoidRootPart") -- The main part of the boss
local serverStorage = game:GetService("ServerStorage")
local minionTemplate = serverStorage:FindFirstChild("him")

local maxMinions = 5
local cooldown = 1
local lastSummonTime = 0
local activeMinions = {}

-- Function to handle the summoning
local function summon()
    local currentTime = tick()
    if (currentTime - lastSummonTime) > cooldown and #activeMinions < maxMinions then
        lastSummonTime = currentTime
        
        local newMinion = minionTemplate:Clone()
        newMinion.Parent = game.Workspace
        newMinion:MoveTo(body.Position + Vector3.new(math.random(-10, 10), 0, math.random(-10, 10)))
        
        table.insert(activeMinions, newMinion)
        
        -- Remove from list when minion is destroyed
        newMinion.Humanoid.Died:Connect(function()
            for i, v in ipairs(activeMinions) do
                if v == newMinion then
                    table.remove(activeMinions, i)
                end
            end
        end)
    end
end

-- Detect when something hits the boss
body.Touched:Connect(function(hit)
    -- Check if the thing hitting the boss belongs to a player's tool or character
    if hit.Parent:FindFirstChild("Humanoid") or hit.Parent.Parent:FindFirstChild("Humanoid") then
        summon()
    end
end)


]]></ProtectedString>
