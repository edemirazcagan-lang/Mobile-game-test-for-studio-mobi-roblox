<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local humanoid = script.Parent:WaitForChild("Humanoid")

while true do
    task.wait(1) -- Wait 1 second between heals
    
    local halfHealth = humanoid.MaxHealth / 2
    
    -- Only heal if health is ABOVE 50% and not already full
    if humanoid.Health > halfHealth and humanoid.Health < humanoid.MaxHealth then
        humanoid.Health = humanoid.Health + 100 -- Adds 1000 HP every second
    end
end


]]></ProtectedString>
