<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454114459AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">JetpackLocal</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[--JetpackLocal 		-- modified to be mobile compatible by ScottSpiritWalker, 11/20/2022.

local tool = script.Parent

local thrust = tool:WaitForChild("Handle"):WaitForChild("WEEE")			--Wait for parts to spawn and give them shorter names.
local flames1 = tool:WaitForChild("tube"):WaitForChild("Attachment"):WaitForChild("Fire")
local flames2 = tool:WaitForChild("tube2"):WaitForChild("Attachment"):WaitForChild("Fire")
local swooshSound = tool.Handle:WaitForChild("Swoosh")

function Up()		--Activate thrust, sound and flames.
	thrust.MaxForce = Vector3.new(0,math.huge,0)
	flames1.Enabled = true
	flames2.Enabled = true
	swooshSound:Play()
	game.Players.LocalPlayer.Character:WaitForChild("Humanoid").WalkSpeed = 80		--walkspeed can speed you up even in mid-air.
end

function Down()		--Stop thrust, sound and flames.
	thrust.MaxForce = Vector3.new(0,0,0)
	flames1.Enabled = false
	flames2.Enabled = false
	swooshSound:Stop()
	game.Players.LocalPlayer.Character:WaitForChild("Humanoid").WalkSpeed = 15 	--back to normal walkspeed.
end

local equipped = false

tool.Equipped:Connect(function()
	equipped = true
	local h = tool.Parent:WaitForChild("Humanoid")
	while equipped do
		if h.MoveDirection.X == 0 and h.MoveDirection.Y == 0 and h.MoveDirection.Z == 0 then
			if flames1.Enabled == true then
				Down()
			end
		elseif flames1.Enabled == false then
			Up()
		end
		wait(.1)
	end
end)

tool.Unequipped:Connect(function()
	Down()
	equipped = false
end)]]></ProtectedString>
