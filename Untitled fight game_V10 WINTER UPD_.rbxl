<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
 
-- Change "Part" to the actual name of your part in the Workspace
local PromptPart = workspace:WaitForChild("SpecialDonoUIPart") 
local ProximityPrompt = PromptPart:WaitForChild("ProximityPrompt")
 
-- Reference to the UI Frame you want to open
local Frame = script.Parent:WaitForChild("SpecialDonoFrame") 
 
-- Function to open the UI
local function onPromptActivated(player)
    -- Check if the player who triggered it is the local player
    if player == LocalPlayer then
        Frame.Visible = true
    end
end
 
-- Listen for the prompt activation
ProximityPrompt.Triggered:Connect(onPromptActivated)

]]></ProtectedString>
<UniqueId name="UniqueId">7bdf20b295fbe64d068941449200437f</UniqueId>
</Properties>
</Item>
