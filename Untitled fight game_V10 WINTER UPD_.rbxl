<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

-- Setting up the RemoteEvent
local remoteEvent = ReplicatedStorage:FindFirstChild("SummonCylinder")
end

-- Configuration Constants
local DAMAGE_AMOUNT = 99000
local SPEED = 500 -- Studs per second
local RANGE = 600 -- How far it travels before disappearing
local CYLINDER_SIZE = Vector3.new(6, 3, 3) -- Length, Height, Width

remoteEvent.OnServerEvent:Connect(function(player, lookDirection)
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local hrp = character.HumanoidRootPart
    
    -- 1. Create the Cylinder
    local cylinder = Instance.new("Part")
    cylinder.Shape = Enum.PartType.Cylinder
    cylinder.Size = CYLINDER_SIZE
    cylinder.Material = Enum.Material.Neon
    cylinder.BrickColor = BrickColor.new("Bright red")
    cylinder.CanCollide = false
    cylinder.Anchored = true
    
    -- Position the cylinder slightly in front of the player and rotate it to point forward
    -- (Cylinders in Roblox orient along the X-axis by default, so we rotate it)
    local spawnPosition = hrp.Position + (lookDirection * 4)
    cylinder.CFrame = CFrame.lookAt(spawnPosition, spawnPosition + lookDirection) * CFrame.Angles(0, math.rad(90), 0)
    cylinder.Parent = workspace
    
    -- Track hit humanoids so we don't damage the same person multiple times
    local damagedTargets = {}
    damagedTargets[character] = true -- Prevent damaging the creator
    
    -- 2. Damage Detection
    local connection
    connection = cylinder.Touched:Connect(function(hit)
        local targetCharacter = hit.Parent
        local humanoid = targetCharacter:FindFirstChildOfClass("Humanoid")
        
        if humanoid and not damagedTargets[targetCharacter] then
            damagedTargets[targetCharacter] = true
            humanoid:TakeDamage(DAMAGE_AMOUNT)
        end
    end)
    
    -- 3. Movement via TweenService
    local targetPosition = cylinder.Position + (lookDirection * RANGE)
    -- Readjust target CFrame to maintain the proper cylinder rotation
    local targetCFrame = CFrame.lookAt(targetPosition, targetPosition + lookDirection) * CFrame.Angles(0, math.rad(90), 0)
    
    local duration = RANGE / SPEED
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)
    local tween = TweenService:Create(cylinder, tweenInfo, {CFrame = targetCFrame})
    
    tween:Play()
    
    -- 4. Cleanup
    tween.Completed:Connect(function()
        connection:Disconnect()
        cylinder:Destroy()
    end)
end)

]]></ProtectedString>
