<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local tool = script.Parent

tool.Activated:Connect(function()
	local character = tool.Parent
	if not character or not character:IsA("Model") then return end
	
	local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
	if not humanoidRootPart then return end
	
	local snowFolder = workspace:FindFirstChild("AccumulatedSnow")
	if not snowFolder then return end
	
	local clearedCount = 0
	
	for _, snowCap in ipairs(snowFolder:GetChildren()) do
		if snowCap:IsA("BasePart") then
			local distance = (snowCap.Position - humanoidRootPart.Position).Magnitude
			if distance <= 15 then
				clearedCount = clearedCount + 1
				
				local tweenService = game:GetService("TweenService")
				local shrinkTween = tweenService:Create(snowCap, TweenInfo.new(0.2), {
					Size = Vector3.new(snowCap.Size.X, 0.01, snowCap.Size.Z)
				})
				shrinkTween:Play()
				
				task.delay(0.2, function()
					if snowCap and snowCap.Parent then
						snowCap:Destroy()
					end
				end)
			end
		end
	end
	
	if clearedCount > 0 then
		print("Shoveled away " .. clearedCount .. " snow layers!")
	end
end)

]]></ProtectedString>
