<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[-- References to the UI elements
local openButton = script.Parent
local screenGui = openButton.Parent
-- Finds the Frame inside the ScreenGui
local menuFrame = screenGui:WaitForChild("Frame") 

-- Make sure the frame is closed by default when the game starts
menuFrame.Visible = false

-- Function that runs when the button is clicked
local function onButtonClick()
    -- This toggles the visibility (if it's true, it becomes false; if false, it becomes true)
    menuFrame.Visible = not menuFrame.Visible
end

-- Connect the click event to our function
openButton.Activated:Connect(onButtonClick)

]]></ProtectedString>
