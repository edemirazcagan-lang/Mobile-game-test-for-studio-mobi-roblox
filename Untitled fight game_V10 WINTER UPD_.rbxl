<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[-- Services
local Players = game:GetService("Players")
local Debris = game:GetService("Debris")
 
-- Configuration
local BOSS = script.Parent
local ROOT = BOSS:WaitForChild("HumanoidRootPart")
local HUMANOID = BOSS:WaitForChild("Humanoid")
 
local MAX_DISTANCE = 20          -- Distance before triggering Sun Rays
local ATTACK_COOLDOWN = 3        -- Cooldown between standard attacks
 
-- Attack Configurations
local RAY_DAMAGE = 15
local RAY_SPEED = 25
local RAY_DURATION = 5
 
local BALL_DAMAGE = 35           -- Exact damage dealt (guaranteed not to one-shot)
local BALL_SPEED = 20
local BALL_SUMMON_DELAY = 1.5    -- How long the boss waits after being hit before shooting
local BALL_EXPLOSION_DELAY = 2.5 -- Time before the ball explodes after tagging the player
local BALL_BLAST_RADIUS = 12     -- How close players need to be to take damage from the explosion
 
-- State Variables
local lastAttackTime = 0
local isCounterAttacking = false
 
--------------------------------------------------------------------------------
-- Helper Functions
--------------------------------------------------------------------------------
 
-- Finds the closest living player
local function getClosestPlayer()
    local closestPlayer = nil
    local shortestDistance = math.huge
    
    for _, player in ipairs(Players:GetPlayers()) do
        local character = player.Character
        if character and character:FindFirstChild("Humanoid") and character.Humanoid.Health > 0 then
            local hrp = character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local distance = (ROOT.Position - hrp.Position).Magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    closestPlayer = player
                end
            end
        end
    end
    return closestPlayer, shortestDistance
end
 
-- Creates a base tracking projectile using physics forces
local function createTrackingProjectile(color, size, material)
    local p = Instance.new("Part")
    p.Size = size
    p.Color = color
    p.Material = material
    p.CanCollide = false
    p.Anchored = false
    p.Shape = Enum.PartType.Ball
    
    local attachment = Instance.new("Attachment", p)
    local linearVelocity = Instance.new("LinearVelocity", p)
    linearVelocity.Attachment0 = attachment
    linearVelocity.MaxForce = math.huge
    
    return p, linearVelocity
end
 
--------------------------------------------------------------------------------
-- Attack Logic
--------------------------------------------------------------------------------
 
-- Attack 1: Sun Rays (Triggered when player is too far)
local function shootSunRay(targetPart)
    local ray, velocity = createTrackingProjectile(Color3.fromRGB(255, 200, 50), Vector3.new(2, 2, 4), Enum.Material.Neon)
    ray.CFrame = ROOT.CFrame + Vector3.new(0, 4, 0)
    ray.Parent = workspace
    Debris:AddItem(ray, RAY_DURATION)
    
    -- Tracking Loop
    task.spawn(function()
        local startTime = os.clock()
        while ray and ray.Parent and targetPart and targetPart.Parent do
            if os.clock() - startTime > RAY_DURATION then break end
            
            local direction = (targetPart.Position - ray.Position).Unit
            velocity.VectorVelocity = direction * RAY_SPEED
            ray.CFrame = CFrame.lookAt(ray.Position, ray.Position + direction)
            
            task.wait(0.1)
        end
    end)
    
    -- Hit Detection
    ray.Touched:Connect(function(hit)
        local hum = hit.Parent:FindFirstChildOfClass("Humanoid")
        if hum and hit.Parent ~= BOSS then
            hum:TakeDamage(RAY_DAMAGE)
            ray:Destroy()
        end
    end)
end
 
-- Attack 2: Delayed Explosion Ball (Triggered after boss takes damage)
local function shootExplosiveBall(targetPart)
    local ball, velocity = createTrackingProjectile(Color3.fromRGB(255, 50, 50), Vector3.new(3, 3, 3), Enum.Material.ForceField)
    ball.CFrame = ROOT.CFrame + Vector3.new(0, 4, 0)
    ball.Parent = workspace
    Debris:AddItem(ball, 12) -- Safety cleanup
    
    -- Tracking Loop
    local tracking = true
    task.spawn(function()
        while tracking and ball and ball.Parent and targetPart and targetPart.Parent do
            local direction = (targetPart.Position - ball.Position).Unit
            velocity.VectorVelocity = direction * BALL_SPEED
            task.wait(0.1)
        end
    end)
    
    -- Hit Detection
    ball.Touched:Connect(function(hit)
        local char = hit.Parent
        local hum = char:FindFirstChildOfClass("Humanoid")
        
        if hum and char ~= BOSS and tracking then
            tracking = false -- Stop projectile movement
            velocity.VectorVelocity = Vector3.new(0, 0, 0)
            ball.Anchored = true
            
            -- Weld ball onto the player so they carry it during the countdown
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                ball.CanCollide = false
                ball.Position = hrp.Position + Vector3.new(0, 2, 0)
                local weld = Instance.new("WeldConstraint")
                weld.Part0 = ball
                weld.Part1 = hrp
                weld.Parent = ball
                ball.Anchored = false
            end
            
            -- Flash warning countdown
            task.spawn(function()
                local origColor = ball.Color
                for i = 1, 5 do
                    ball.Color = Color3.fromRGB(255, 255, 255)
                    task.wait(BALL_EXPLOSION_DELAY / 10)
                    ball.Color = origColor
                    task.wait(BALL_EXPLOSION_DELAY / 10)
                end
                
                -- Safe Explosion Execution
                if ball and ball.Parent then
                    local explosionPos = ball.Position
                    
                    -- 1. Create a visual-only explosion
                    local explosion = Instance.new("Explosion")
                    explosion.Position = explosionPos
                    explosion.BlastRadius = 0 -- Zero radius ensures Roblox physics damage completely disables
                    explosion.BlastPressure = 0 
                    explosion.Parent = workspace
                    
                    -- 2. Manually apply exact damage to nearby players via script loop (100% safe from one-shots)
                    for _, player in ipairs(Players:GetPlayers()) do
                        local pChar = player.Character
                        if pChar and pChar ~= BOSS then
                            local pHum = pChar:FindFirstChildOfClass("Humanoid")
                            local pHrp = pChar:FindFirstChild("HumanoidRootPart")
                            
                            if pHum and pHum.Health > 0 and pHrp then
                                local distance = (explosionPos - pHrp.Position).Magnitude
                                if distance <= BALL_BLAST_RADIUS then
                                    pHum:TakeDamage(BALL_DAMAGE) -- Deals exactly 35 damage
                                end
                            end
                        end
                    end
                    
                    ball:Destroy()
                end
            end)
        end
    end)
end
 
--------------------------------------------------------------------------------
-- Main Triggers
--------------------------------------------------------------------------------
 
-- Trigger when Boss takes damage
HUMANOID.HealthChanged:Connect(function(currentHealth)
    local maxHealth = HUMANOID.MaxHealth
    if currentHealth < maxHealth and currentHealth > 0 and not isCounterAttacking then
        isCounterAttacking = true
        
        -- Wait before summoning the attack
        task.wait(BALL_SUMMON_DELAY)
        
        -- Verify boss didn't die during the wait duration
        if HUMANOID.Health > 0 then
            local targetPlayer, _ = getClosestPlayer()
            if targetPlayer and targetPlayer.Character then
                local hrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    shootExplosiveBall(hrp)
                end
            end
        end
        
        -- Internal safety cooldown before boss can listen for damage counter-attacks again
        task.wait(ATTACK_COOLDOWN)
        isCounterAttacking = false
    end
end)
 
-- Loop check for distance (Sun Rays)
task.spawn(function()
    while task.wait(0.5) do
        if HUMANOID.Health <= 0 then break end
        
        local targetPlayer, distance = getClosestPlayer()
        
        if targetPlayer and distance > MAX_DISTANCE and not isCounterAttacking then
            local currentTime = os.clock()
            if currentTime - lastAttackTime >= ATTACK_COOLDOWN then
                lastAttackTime = currentTime
                local hrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    shootSunRay(hrp)
                end
            end
        end
    end
end)

]]></ProtectedString>
