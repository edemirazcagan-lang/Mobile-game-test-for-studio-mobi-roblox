<ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local statusValue = ReplicatedStorage:WaitForChild("EventStatus")
local banner = script.Parent
 
-- Set initial text
banner.Text = statusValue.Value
 
-- Update whenever the server changes the text
statusValue:GetPropertyChangedSignal("Value"):Connect(function()
    banner.Text = statusValue.Value
end)

]]></ProtectedString>
