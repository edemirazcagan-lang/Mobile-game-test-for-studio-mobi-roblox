<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local BadgeService = game:GetService("BadgeService")
local Players = game:GetService("Players")
 
local trashBinModel = script.Parent
-- Look for the prompt directly inside the Model
local prompt = trashBinModel:WaitForChild("ThrowPrompt")
 
-- CONFIGURATION
local BADGE_ID = 682542485804241 -- Replace with your actual Badge ID
local ITEMS_REQUIRED = 8  -- Number of items needed to get the badge
 
local playerTrashCounts = {}
 
prompt.Triggered:Connect(function(player)
    local character = player.Character
    if not character then return end
    
    local tool = character:FindFirstChildOfClass("Tool")
    if tool then
        -- Destroy the equipped item
        tool:Destroy()
        
        if not playerTrashCounts[player] then
            playerTrashCounts[player] = 0
        end
        
        playerTrashCounts[player] += 1
        print(player.Name .. " threw away an item. Total: " .. playerTrashCounts[player])
        
        -- Check goal and award badge
        if playerTrashCounts[player] >= ITEMS_REQUIRED then
            local success, hasBadge = pcall(function()
                return BadgeService:UserHasBadgeAsync(player.UserId, BADGE_ID)
            end)
            
            if success and not hasBadge then
                local awardSuccess, err = pcall(function()
                    BadgeService:AwardBadge(player.UserId, BADGE_ID)
                end)
                
                if awardSuccess then
                    print("Awarded badge to " .. player.Name)
                else
                    warn("Failed to award badge: " .. tostring(err))
                end
            end
        end
    else
        print(player.Name .. " tried to use the trash bin, but had no item equipped.")
    end
end)
 
Players.PlayerRemoving:Connect(function(player)
    playerTrashCounts[player] = nil
end)

]]></ProtectedString>
