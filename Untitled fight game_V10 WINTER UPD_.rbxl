<string name="Name">TeleportParts</string>
<UniqueId name="UniqueId">7bdf20b295fbe64d068940444600430e</UniqueId>
</Properties>
<Item class="Script" referent="RBX66C1625455D04AC580D8104447513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Ignore</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local TeleportPart1 = script.Parent.TeleportPart1		--Don't put the Destination on top of the TeleportPart or the player will teleport back and forth. 
local TeleportPart2 = script.Parent.TeleportPart2
local Destination1 = script.Parent.Destination1
local Destination2 = script.Parent.Destination2

TeleportPart1.Touched:Connect(function(hit)
	local w = hit.Parent:FindFirstChild("HumanoidRootPart")
	if w then
		w.CFrame = Destination2.CFrame + Vector3.new(0, 6, 0)
	end
end)

TeleportPart2.Touched:Connect(function(hit)
	local w = hit.Parent:FindFirstChild("HumanoidRootPart")
	if w then
		w.CFrame = Destination1.CFrame + Vector3.new(0, 6, 0)
	end
end)]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8044480041fa</UniqueId>
</Properties>
</Item>
