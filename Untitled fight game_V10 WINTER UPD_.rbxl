<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local Players = game:GetService("Players")
 
-- Create a RemoteEvent automatically for communication
local remoteEvent = Instance.new("RemoteEvent")
remoteEvent.Name = "ServerToPod"
remoteEvent.Parent = Tool
 
-- Helper function: Toggles invisibility for a character
local function setInvisibility(character, invisible)
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") or part:IsA("Decal") then
            if part.Name ~= "HumanoidRootPart" then
                part.Transparency = invisible and 1 or 0
            end
        end
    end
    if character:FindFirstChild("Head") and character.Head:FindFirstChildOfClass("BillboardGui") then
        character.Head:FindFirstChildOfClass("BillboardGui").Enabled = not invisible
    end
end
 
-- Helper function: Checks if any player/NPC is within 100 studs and looking
local function isBeingWatched(character)
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    
    for _, obj in ipairs(workspace:GetChildren()) do
        local hum = obj:FindFirstChildOfClass("Humanoid")
        local enemyRoot = obj:FindFirstChild("HumanoidRootPart")
        
        -- FIX: Removed the broken "prestige" typo here
        if hum and enemyRoot and obj ~= character and hum.Health > 0 then
            local distance = (root.Position - enemyRoot.Position).Magnitude
            
            if distance <= 100 then
                -- Line of sight check (makes sure there isn't a massive wall between you)
                local raycastParams = RaycastParams.new()
                raycastParams.FilterDescendantsInstances = {character, obj}
                raycastParams.FilterType = Enum.RaycastFilterType.Exclude
                
                local result = workspace:Raycast(enemyRoot.Position, (root.Position - enemyRoot.Position).Unit * distance, raycastParams)
                
                if not result then -- Clear line of sight
                    return true
                end
            end
        end
    end
    return false
end
 
-- Main logic handler
remoteEvent.OnServerEvent:Connect(function(player, action, data)
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local root = character.HumanoidRootPart
    
    if action == "Teleport" then
        local watched = isBeingWatched(character)
        
        -- Determine teleport distance (speeds up if being watched)
        local teleportDistance = watched and 25 or 12 
        
        -- Set invisibility state based on being watched
        setInvisibility(character, watched)
        
        -- Calculate forward direction vector
        local forwardVector = root.CFrame.LookVector
        local newPosition = root.Position + (forwardVector * teleportDistance)
        
        -- Keep the original orientation but update the position
        root.CFrame = CFrame.new(newPosition, newPosition + forwardVector)
        
    elseif action == "Shapeshift" and data then
        local targetChar = data
        
        -- Remove current clothes and accessories
        for _, item in ipairs(character:GetChildren()) do
            if item:IsA("Accessory") or item:IsA("Clothing") or item:IsA("BodyColors") or item:IsA("CharacterMesh") then
                item:Destroy()
            end
        end
        
        -- Copy target's look
        for _, item in ipairs(targetChar:GetChildren()) do
            if item:IsA("Accessory") or item:IsA("Clothing") or item:IsA("BodyColors") or item:IsA("CharacterMesh") then
                local clone = item:Clone()
                clone.Parent = character
            end
        end
        
        -- Match head scale and face if possible
        if targetChar:FindFirstChild("Head") and character:FindFirstChild("Head") then
            if targetChar.Head:FindFirstChild("Face") then
                if character.Head:FindFirstChild("Face") then character.Head.Face:Destroy() end
                targetChar.Head.Face:Clone().Parent = character.Head
            end
        end
    end
end)

]]></ProtectedString>
