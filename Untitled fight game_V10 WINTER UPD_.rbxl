<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454115075AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">LocalScript</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local tool = script.Parent
local handle = tool:WaitForChild("Handle")
local player = game.Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
 
local userInputService = game:GetService("UserInputService")
local replicatedStorage = game:GetService("ReplicatedStorage")
local gunEvent = replicatedStorage:WaitForChild("GunEvent")
local camera = workspace.CurrentCamera
 
local fireSound = handle:WaitForChild("FireSound")
local reloadSound = handle:WaitForChild("ReloadSound")
local emptySound = handle:WaitForChild("EmptySound")
 
local MAX_AMMO = 7
local currentAmmo = MAX_AMMO
local isReloading = false
local isZoomed = false
local normalFOV = 70
local zoomFOV = 30
local lastShotTime = 0
local FIRE_COOLDOWN = 0.25
 
local activeGui = nil
local ammoLabel = nil
local zoomButton = nil
 
-- Update the Ammo Text on screen
local function updateAmmoUI()
    if not ammoLabel then return end
    if isReloading then
        ammoLabel.Text = "RELOADING..."
        ammoLabel.TextColor3 = Color3.fromRGB(255, 200, 60)
    else
        ammoLabel.Text = string.format("AMMO: %d / %d", currentAmmo, MAX_AMMO)
        ammoLabel.TextColor3 = currentAmmo > 0 and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(255, 80, 80)
    end
end
 
-- Core Actions
local function triggerReload()
    if isReloading or currentAmmo >= MAX_AMMO then return end
    isReloading = true
    updateAmmoUI()
    reloadSound:Play()
    gunEvent:FireServer("Reload")
    
    task.wait(2)
    currentAmmo = MAX_AMMO
    isReloading = false
    updateAmmoUI()
end
 
local function triggerZoom()
    isZoomed = not isZoomed
    camera.FieldOfView = isZoomed and zoomFOV or normalFOV
    if zoomButton then
        zoomButton.BackgroundColor3 = isZoomed and Color3.fromRGB(60, 140, 255) or Color3.fromRGB(30, 30, 35)
    end
end
 
local function triggerShoot()
    if isReloading then return end
    
    local now = os.clock()
    if now - lastShotTime < FIRE_COOLDOWN then return end
    
    if currentAmmo <= 0 then
        emptySound:Play()
        return
    end
    
    lastShotTime = now
    currentAmmo -= 1
    updateAmmoUI()
    fireSound:Play()
    
    -- Aim at center crosshair on Mobile/Console, or mouse cursor on PC
    local unitRay
    if userInputService.TouchEnabled and not userInputService.MouseEnabled then
        local center = camera.ViewportSize / 2
        unitRay = camera:ViewportPointToRay(center.X, center.Y)
    else
        local mouseLocation = userInputService:GetMouseLocation()
        unitRay = camera:ViewportPointToRay(mouseLocation.X, mouseLocation.Y)
    end
    
    gunEvent:FireServer("Shoot", {
    Origin = unitRay.Origin,
    Direction = unitRay.Direction
    })
end
 
-- Helper to build styled mobile buttons
local function createButton(parent, name, text, position, size, color)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Text = text
    btn.Position = position
    btn.Size = size
    btn.BackgroundColor3 = color
    btn.BackgroundTransparency = 0.25
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextScaled = true
    btn.AutoButtonColor = true
    btn.Parent = parent
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0.25, 0)
    corner.Parent = btn
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(255, 255, 255)
    stroke.Thickness = 1.5
    stroke.Transparency = 0.6
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = btn
    
    return btn
end
 
-- Build the Custom GUI when Equipped
local function buildGunGui()
    if activeGui then activeGui:Destroy() end
    
    local gui = Instance.new("ScreenGui")
    gui.Name = "DesertEagleHUD"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.Parent = playerGui
    activeGui = gui
    
    -- 1. Ammo Counter (Bottom Center)
    local label = Instance.new("TextLabel")
    label.Name = "AmmoCounter"
    label.Size = UDim2.new(0, 180, 0, 36)
    label.Position = UDim2.new(0.5, -90, 0.85, 0)
    label.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    label.BackgroundTransparency = 0.35
    label.Font = Enum.Font.GothamBold
    label.TextSize = 18
    label.Parent = gui
    ammoLabel = label
    
    local labelCorner = Instance.new("UICorner")
    labelCorner.CornerRadius = UDim.new(0.25, 0)
    labelCorner.Parent = label
    updateAmmoUI()
    
    -- 2. Center Crosshair & Mobile Touch Buttons (Only shown on Touch devices)
    if userInputService.TouchEnabled then
        -- Center Dot Crosshair
        local crosshair = Instance.new("Frame")
        crosshair.Name = "Crosshair"
        crosshair.Size = UDim2.new(0, 8, 0, 8)
        crosshair.Position = UDim2.new(0.5, -4, 0.5, -4)
        crosshair.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        crosshair.BorderSizePixel = 0
        crosshair.Parent = gui
        
        local dotCorner = Instance.new("UICorner")
        dotCorner.CornerRadius = UDim.new(1, 0)
        dotCorner.Parent = crosshair
        
        -- Dedicated Shoot Button (Shifted up above the jump button)
        local shootBtn = createButton(
        gui,
        "ShootButton",
        "FIRE",
        UDim2.new(1, -110, 1, -260),
        UDim2.new(0, 85, 0, 85),
        Color3.fromRGB(200, 50, 50)
        )
        shootBtn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch then
                triggerShoot()
            end
        end)
        
        -- Zoom Button (To the left of the Fire button)
        zoomButton = createButton(
        gui,
        "ZoomButton",
        "ZOOM",
        UDim2.new(1, -195, 1, -245),
        UDim2.new(0, 70, 0, 65),
        Color3.fromRGB(30, 30, 35)
        )
        zoomButton.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch then
                triggerZoom()
            end
        end)
        
        -- Reload Button (Directly above the Fire button)
        local reloadBtn = createButton(
        gui,
        "ReloadButton",
        "RELOAD",
        UDim2.new(1, -102, 1, -340),
        UDim2.new(0, 70, 0, 65),
        Color3.fromRGB(30, 30, 35)
        )
        reloadBtn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch then
                triggerReload()
            end
        end)
    end
end
 
-- PC & Console Inputs
userInputService.InputBegan:Connect(function(input, gameProcessed)
    if not activeGui or gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.R or input.KeyCode == Enum.KeyCode.ButtonX then
        triggerReload()
    elseif input.UserInputType == Enum.UserInputType.MouseButton2 or input.KeyCode == Enum.KeyCode.ButtonL2 then
        triggerZoom()
    end
end)
 
-- PC Left-Click & Console Right-Trigger Shooting
tool.Activated:Connect(function()
    if userInputService.TouchEnabled and not userInputService.MouseEnabled then return end
    triggerShoot()
end)
 
-- Equip / Unequip Lifecycle
tool.Equipped:Connect(function()
    buildGunGui()
end)
 
tool.Unequipped:Connect(function()
    isZoomed = false
    camera.FieldOfView = normalFOV
    if activeGui then
        activeGui:Destroy()
        activeGui = nil
        ammoLabel = nil
        zoomButton = nil
    end
end)

]]></ProtectedString>
