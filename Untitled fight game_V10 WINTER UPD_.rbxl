<Item class="Script" referent="RBX66C1625455D04AC580D8116067513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">KilledScript</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[-- Put this script inside your NPC Model
local npc = script.Parent
local humanoid = npc:WaitForChild("Humanoid")
 
humanoid.Died:Connect(function()
    local creatorTag = humanoid:FindFirstChild("Creator")
    if creatorTag and creatorTag.Value then
        local player = creatorTag.Value
        if player:IsA("Player") then
            local leaderstats = player:FindFirstChild("leaderstats")
            if leaderstats then
                local npcKills = leaderstats:FindFirstChild("NPC Kills")
                if npcKills then
                    -- Dynamically fetch multiplier from server system
                    local ServerScript = game:GetService("ServerScriptService"):FindFirstChildOfClass("Script")
                    -- Since the main script is managing multipliers, we check it here
                    -- If you want to use the exact same calculation:
                    local multiplier = 1
                    local MarketplaceService = game:GetService("MarketplaceService")
                    
                    -- (Optional recalculation inside NPC for safety)
                    local successLow, hasLow = pcall(function() return MarketplaceService:UserOwnsGamePassAsync(player.UserId, 00000000) end) -- Low Gamepass ID
                        local successHigh, hasHigh = pcall(function() return MarketplaceService:UserOwnsGamePassAsync(player.UserId, 00000000) end) -- High Gamepass ID
                            
                            if successLow and hasLow then multiplier = multiplier + 1 end   -- adds 1 extra to mult
                                if successHigh and hasHigh then multiplier = multiplier + 2 end -- adds 2 extra to mult
                                    
                                    npcKills.Value = npcKills.Value + (1 * multiplier)
                                end
                            end
                        end
                    end
                end)

]]></ProtectedString>
