<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454115367AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">LocalScript</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[--[[
SwordClient.lua
Place as a LocalScript INSIDE the "Killstreak Sword" Tool.
 
Handles:
- Swing animation/sound on tool.Activated (works automatically for
mouse click, tap-to-use on mobile, and gamepad trigger — Roblox
fires Activated for all of these by default)
- Laser ability input: keyboard [Q], gamepad [ButtonX], and an
on-screen mobile button (auto-created only on touch devices)
- Listens for EffectFire remote to play kill feedback / laser beam
visuals sent by the server
]]
 
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
 
local player = Players.LocalPlayer
local tool = script.Parent
local handle = tool:WaitForChild("Handle")
 
local remotesFolder = ReplicatedStorage:WaitForChild("KillstreakSwordRemotes")
local LaserRequest = remotesFolder:WaitForChild("LaserRequest")
local EffectFire = remotesFolder:WaitForChild("EffectFire")
local FlyInput = remotesFolder:WaitForChild("FlyInput")
 
local ACTION_LASER = "KillstreakLaser"
local mobileButtonGui = nil
 
----------------------------------------------------------------------
-- FLIGHT (tier 250) -- horizontal movement is just the humanoid's normal
-- WalkSpeed-driven movement (keyboard/gamepad/mobile-joystick all already
-- work for that, no extra code needed). Vertical lift/descend is bound
-- here and only sent to the server when the input STATE CHANGES
-- (press/release), not every frame -- so it's naturally lightweight.
----------------------------------------------------------------------
local flyUpGui = nil
local flying = false
 
local ACTION_FLY_UP = "KillstreakFlyUp"
local ACTION_FLY_DOWN = "KillstreakFlyDown"
 
local function sendVertical(value)
    FlyInput:FireServer(value)
end
 
local function bindFlyVerticalActions()
    ContextActionService:BindAction(ACTION_FLY_UP, function(_, state)
        if state == Enum.UserInputState.Begin then
            sendVertical(1)
        elseif state == Enum.UserInputState.End then
            sendVertical(0)
        end
    end, false, Enum.KeyCode.Space, Enum.KeyCode.ButtonR2)
    
    ContextActionService:BindAction(ACTION_FLY_DOWN, function(_, state)
        if state == Enum.UserInputState.Begin then
            sendVertical(-1)
        elseif state == Enum.UserInputState.End then
            sendVertical(0)
        end
    end, false, Enum.KeyCode.LeftControl, Enum.KeyCode.ButtonL2)
end
 
local function unbindFlyVerticalActions()
    ContextActionService:UnbindAction(ACTION_FLY_UP)
    ContextActionService:UnbindAction(ACTION_FLY_DOWN)
    sendVertical(0)
end
 
local function createFlyTouchButtons()
    if flyUpGui or not UserInputService.TouchEnabled then return end
    local playerGui = player:WaitForChild("PlayerGui")
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "KillstreakFlyButtonsGui"
    screenGui.ResetOnSpawn = false
    
    local function makeButton(text, yOffset)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.fromOffset(70, 70)
        btn.Position = UDim2.new(1, -120, 1, yOffset)
        btn.BackgroundColor3 = Color3.fromRGB(60, 140, 255)
        btn.BackgroundTransparency = 0.25
        btn.Text = text
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.TextScaled = true
        btn.Font = Enum.Font.GothamBold
        btn.Parent = screenGui
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(1, 0)
        corner.Parent = btn
        return btn
    end
    
    local upBtn = makeButton("UP", -320)
    local downBtn = makeButton("DOWN", -230)
    
    upBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then sendVertical(1) end
    end)
    upBtn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then sendVertical(0) end
    end)
    downBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then sendVertical(-1) end
    end)
    downBtn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then sendVertical(0) end
    end)
    
    flyUpGui = screenGui
    screenGui.Parent = playerGui
end
 
local function destroyFlyTouchButtons()
    if flyUpGui then
        flyUpGui:Destroy()
        flyUpGui = nil
    end
end
 
local function startFlying()
    if flying then return end
    flying = true
    bindFlyVerticalActions()
    createFlyTouchButtons()
end
 
local function stopFlying()
    if not flying then return end
    flying = false
    unbindFlyVerticalActions()
    destroyFlyTouchButtons()
end
 
player:GetAttributeChangedSignal("KillstreakFlying"):Connect(function()
    if player:GetAttribute("KillstreakFlying") then
        startFlying()
    else
        stopFlying()
    end
end)
 
if player:GetAttribute("KillstreakFlying") then
    startFlying()
end
 
----------------------------------------------------------------------
-- SWING (works for mouse click, tap, and gamepad trigger automatically)
----------------------------------------------------------------------
local swingSound = handle:FindFirstChild("SwingSound")
 
tool.Activated:Connect(function()
    if swingSound then
        swingSound:Play()
    end
    -- Simple swing animation via handle tween (replace with a real
    -- AnimationTrack if you have a sword-swing animation asset)
    local origCFrame = handle.CFrame
    local tween = TweenService:Create(
    handle,
    TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
    { CFrame = origCFrame * CFrame.Angles(0, 0, math.rad(-60)) }
    )
    tween:Play()
    tween.Completed:Connect(function()
        TweenService:Create(
        handle,
        TweenInfo.new(0.1),
        { CFrame = origCFrame }
        ):Play()
    end)
end)
 
----------------------------------------------------------------------
-- LASER ABILITY INPUT — keyboard, gamepad, and touch
----------------------------------------------------------------------
local function fireLaser()
    LaserRequest:FireServer()
end
 
local function bindLaserAction()
    ContextActionService:BindAction(
    ACTION_LASER,
    function(_, inputState)
        if inputState == Enum.UserInputState.Begin then
            fireLaser()
        end
    end,
    false, -- no default on-screen button; we make our own for touch below
    Enum.KeyCode.Q,
    Enum.KeyCode.ButtonX
    )
end
 
local function unbindLaserAction()
    ContextActionService:UnbindAction(ACTION_LASER)
end
 
local function createMobileButton()
    if mobileButtonGui or not UserInputService.TouchEnabled then return end
    
    local playerGui = player:WaitForChild("PlayerGui")
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "KillstreakLaserButtonGui"
    screenGui.ResetOnSpawn = false
    
    local button = Instance.new("TextButton")
    button.Name = "LaserButton"
    button.Size = UDim2.fromOffset(80, 80)
    button.Position = UDim2.new(1, -120, 1, -220)
    button.AnchorPoint = Vector2.new(0, 0)
    button.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
    button.BackgroundTransparency = 0.25
    button.Text = "LASER"
    button.TextColor3 = Color3.new(1, 1, 1)
    button.TextScaled = true
    button.Font = Enum.Font.GothamBold
    button.Parent = screenGui
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = button
    
    button.Activated:Connect(fireLaser)
    
    screenGui.Parent = playerGui
    mobileButtonGui = screenGui
end
 
local function destroyMobileButton()
    if mobileButtonGui then
        mobileButtonGui:Destroy()
        mobileButtonGui = nil
    end
end
 
tool.Equipped:Connect(function()
    bindLaserAction()
    createMobileButton()
end)
 
tool.Unequipped:Connect(function()
    unbindLaserAction()
    destroyMobileButton()
end)
 
----------------------------------------------------------------------
-- VISUAL / AUDIO FEEDBACK FROM SERVER
----------------------------------------------------------------------
EffectFire.OnClientEvent:Connect(function(kind, data)
    if kind == "KillFeedback" then
        local kills = data
        -- Simple screen flash / notification — swap for your own UI
        local playerGui = player:FindFirstChild("PlayerGui")
        if playerGui then
            local msg = Instance.new("Message")
            msg.Text = ("Killstreak: %d"):format(kills)
            msg.Parent = playerGui
            Debris:AddItem(msg, 1.2)
        end
        
    elseif kind == "LaserBeam" then
        local origin = data.origin
        local endPoint = data.endPoint
        local beamPart = Instance.new("Part")
        beamPart.Anchored = true
        beamPart.CanCollide = false
        beamPart.Material = Enum.Material.Neon
        beamPart.Color = Color3.fromRGB(255, 40, 40)
        local dist = (endPoint - origin).Magnitude
        beamPart.Size = Vector3.new(0.3, 0.3, dist)
        beamPart.CFrame = CFrame.new(origin, endPoint) * CFrame.new(0, 0, -dist / 2)
        beamPart.Parent = workspace
        Debris:AddItem(beamPart, 0.25)
    end
end)

]]></ProtectedString>
