<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454116911AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">LocalScript</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[-- Place inside Tool -> ActiveScript
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local tool = script.Parent
local remoteEvent = tool:WaitForChild("ToggleFlight")
local player = Players.LocalPlayer

local ACTION_NAME = "ToggleFlyNoclip"
local isFlying = false

local bodyVelocity, bodyGyro
local noclipConnection

local FLY_SPEED = 50

local function startFlight(character, humanoid, rootPart)
    isFlying = true
    remoteEvent:FireServer(true)
    
    -- Setup physics forces for flying
    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.Parent = rootPart
    
    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    bodyGyro.CFrame = rootPart.CFrame
    bodyGyro.Parent = rootPart
    
    humanoid.PlatformStand = true -- Prevents falling/running animations conflicting
    
    -- Noclip loop
    noclipConnection = RunService.Stepped:Connect(function()
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
        
        -- Movement direction based on camera angle
        local camera = workspace.CurrentCamera
        local moveDirection = humanoid.MoveDirection
        
        if moveDirection.Magnitude > 0 then
            -- Fly in the direction the camera faces
            bodyVelocity.Velocity = camera.CFrame.LookVector * FLY_SPEED * moveDirection.Magnitude
        else
            bodyVelocity.Velocity = Vector3.new(0, 0, 0)
        end
        
        bodyGyro.CFrame = camera.CFrame
    end)
end

local function stopFlight(character, humanoid)
    isFlying = false
    remoteEvent:FireServer(false)
    
    if noclipConnection then noclipConnection:Disconnect() end
    if bodyVelocity then bodyVelocity:Destroy() end
    if bodyGyro then bodyGyro:Destroy() end
    
    if humanoid then
        humanoid.PlatformStand = false
        -- Reset basic collision safely
        local root = character:FindFirstChild("HumanoidRootPart")
        if root then root.CanCollide = true end
    end
end

local function handleAction(actionName, inputState, inputObject)
    if inputState == Enum.UserInputState.Begin then
        local character = player.Character
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        
        if character and humanoid and rootPart then
            if isFlying then
                stopFlight(character, humanoid)
            else
                startFlight(character, humanoid, rootPart)
            end
        end
    end
end

tool.Equipped:Connect(function()
    -- Binds 'E' for PC, 'ButtonR2' for Console, and creates an on-screen button for Mobile
    ContextActionService:BindAction(
    ACTION_NAME, 
    handleAction, 
    true, -- Creates a touchscreen button automatically
    Enum.KeyCode.E, 
    Enum.KeyCode.ButtonR2
    )
    -- Customize the mobile button text
    ContextActionService:SetTitle(ACTION_NAME, "Fly/Noclip")
end)

tool.Unequipped:Connect(function()
    ContextActionService:UnbindAction(ACTION_NAME)
    
    local character = player.Character
    if character then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        stopFlight(character, humanoid)
    end
end)

]]></ProtectedString>
<UniqueId name="UniqueId">7bdf20b295fbe64d068941691200437f</UniqueId>
