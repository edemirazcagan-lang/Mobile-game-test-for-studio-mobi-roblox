<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454116791AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">LocalScript</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local LaserEvent = ReplicatedStorage:WaitForChild("LaserEvent")

local equipped = false

Tool.Equipped:Connect(function()
    equipped = true
end)

Tool.Unequipped:Connect(function()
    equipped = false
    LaserEvent:FireServer("Stop")
end)

-- Fixed Function to handle activation across all devices
Tool.Activated:Connect(function()
    if not equipped then return end
    
    local mousePosition = nil
    
    -- Works for Touch (Mobile) and Mouse (PC)
    if UserInputService.TouchEnabled or UserInputService.MouseEnabled then
        local mouse = LocalPlayer:GetMouse()
        mousePosition = mouse.Hit.Position
    else
        -- Fallback for Console / Controller direction
        local character = LocalPlayer.Character
        if character and character:FindFirstChild("HumanoidRootPart") then
            mousePosition = character.HumanoidRootPart.Position + (character.HumanoidRootPart.CFrame.LookVector * 50)
        end
    end
    
    if mousePosition then
        LaserEvent:FireServer("Fire", mousePosition)
    end
end)

-- Stop the laser when the player stops holding/clicking
UserInputService.InputEnded:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if not equipped then return end
    
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        LaserEvent:FireServer("Stop")
    end
end)

]]></ProtectedString>
<UniqueId name="UniqueId">7bdf20b295fbe64d068941679200437f</UniqueId>
</Properties>
</Item>
<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454116793AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">LocalScript2</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SpawnBombEvent = ReplicatedStorage:WaitForChild("SpawnBombEvent")
 
local cooldown = 5 -- Seconds between uses
local onCooldown = false
 
local function onActivated()
    local character = Tool.Parent
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    -- Check if the player is alive and the ability isn't on cooldown
    if humanoid and humanoid.Health > 0 and not onCooldown then
        onCooldown = true
        
        -- Tell the server to drop the bomb at the player's feet
        SpawnBombEvent:FireServer()
        
        -- Cooldown visual effect (optional: disables tool temporarily)
        Tool.Enabled = false
        task.wait(cooldown)
        Tool.Enabled = true
        onCooldown = false
    end
end
 
Tool.Activated:Connect(onActivated)

]]></ProtectedString>
