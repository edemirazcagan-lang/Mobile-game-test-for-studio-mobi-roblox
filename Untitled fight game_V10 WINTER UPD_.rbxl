<Item class="Script" referent="RBX66C1625455D04AC580D8112709513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">true</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script2</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local npc = script.Parent
local humanoid = npc:WaitForChild("Humanoid")
local rootPart = npc:WaitForChild("HumanoidRootPart")

local function findTarget()
    local maxDistance = 70 -- How far the NPC can see
    local target = nil
    
    for _, object in pairs(game.Workspace:GetChildren()) do
        local otherHumanoid = object:FindFirstChild("Humanoid")
        local medicalRoot = object:FindFirstChild("HumanoidRootPart")
        
        -- Check if it's a living thing and NOT a player
        if otherHumanoid and medicalRoot and object ~= npc then
            if not game.Players:GetPlayerFromCharacter(object) then
                local distance = (rootPart.Position - medicalRoot.Position).Magnitude
                if distance < maxDistance then
                    target = medicalRoot
                end
            end
        end
    end
    return target
end

while true do
    local targetPart = findTarget()
    if targetPart then
        humanoid:MoveTo(targetPart.Position)
        -- Attack if close enough
        if (rootPart.Position - targetPart.Position).Magnitude < 5 then
            targetPart.Parent.Humanoid:TakeDamage(50)
            task.wait(1) -- Cool down between hits
        end
    end
    task.wait(0.5)
end


]]></ProtectedString>
