<Item class="Script" referent="RBX66C1625455D04AC580D8115209513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script2</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local tool = script.Parent
local handle = tool:WaitForChild("Handle")

-- Configurable Settings
local BASE_DAMAGE = 7500
local CRIT_DAMAGE = 15590

local CRIT_CHANCE = 0.70 -- 70% chance to do a powerful slash
local ATTACK_COOLDOWN = 0.8

local canAttack = true
local hasHitTable = {} -- Prevents damaging the same target multiple times *in one swing*

-- Function to handle dealing damage
local function onTouch(otherPart)
    local character = otherPart.Parent
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    -- Ensure it's a valid target, alive, and not the wielder of the sword
    if humanoid and humanoid.Health > 0 and character ~= tool.Parent then
        -- Check if we haven't hit this specific enemy during this swing yet
        if not hasHitTable[character] then
            hasHitTable[character] = true -- Lock this enemy out for the rest of THIS swing
            
            -- Roll for a random powerful slash
            local isCrit = math.random() <= CRIT_CHANCE
            
            if isCrit then
                humanoid:TakeDamage(CRIT_DAMAGE)
                print("Critical Slash on " .. character.Name .. "! Dealt " .. CRIT_DAMAGE .. " damage.")
                
                -- Visual cue (Spawned in a separate thread so it doesn't pause the swing cooldown)
                task.spawn(function()
                    local originalColor = handle.BrickColor
                    handle.BrickColor = BrickColor.new("Bright red")
                    task.wait(0.2)
                    handle.BrickColor = originalColor
                end)
            else
                humanoid:TakeDamage(BASE_DAMAGE)
                print("Normal Slash on " .. character.Name .. ". Dealt " .. BASE_DAMAGE .. " damage.")
            end
        end
    end
end

-- Function triggered when the player clicks/activates the tool
local function onActivated()
    if not canAttack then return end
    canAttack = false
    
    table.clear(hasHitTable) -- Clear the table so ALL enemies can be hit again for this new swing
    
    -- Connect the touch detection
    local touchConnection = handle.Touched:Connect(onTouch)
    
    task.wait(ATTACK_COOLDOWN) -- Duration of the hitbox/swing phase
    
    touchConnection:Disconnect() -- Turn off hitbox
    canAttack = true
end

tool.Activated:Connect(onActivated)


]]></ProtectedString>
