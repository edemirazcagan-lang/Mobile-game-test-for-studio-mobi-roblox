<Item class="Script" referent="RBX66C1625455D04AC580D8116913513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[-- Place inside Tool -> PassiveScript
local tool = script.Parent
local remoteEvent = tool:WaitForChild("ToggleFlight")

local WALK_SPEED = 45 -- Default is 16
local JUMP_POWER = 85 -- Default is 50
local HEAL_AMOUNT = 65 -- Health regained per second
local HEAL_INTERVAL = 0.5

local healingConnection = nil
local originalTransparencies = {}

-- Helper function to change player visibility
local function setInvisibility(character, invisible)
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            if invisible then
                originalTransparencies[part] = part.Transparency
                part.Transparency = 0.8
            else
                part.Transparency = originalTransparencies[part] or 0
            end
        elseif part:IsA("Decal") then
            if invisible then
                originalTransparencies[part] = part.Transparency
                part.Transparency = 0.8
            else
                part.Transparency = originalTransparencies[part] or 0
            end
        end
    end
    
    local head = character:FindFirstChild("Head")
    if head then
        local face = head:FindFirstChildOfClass("Decal")
        if face then face.Enabled = not invisible end
    end
end

tool.Equipped:Connect(function()
    local character = tool.Parent
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    if humanoid then
        -- Apply Stats
        humanoid.WalkSpeed = WALK_SPEED
        humanoid.JumpPower = JUMP_POWER
        humanoid.UseJumpPower = true -- Ensures JumpPower is used instead of JumpHeight
        
        -- Passive Healing
        healingConnection = task.spawn(function()
            while true do
                task.wait(HEAL_INTERVAL)
                if humanoid.Health < humanoid.MaxHealth then
                    humanoid.Health = math.min(humanoid.Health + HEAL_AMOUNT, humanoid.MaxHealth)
                end
            end
        end)
        
        -- Invisibility
        setInvisibility(character, true)
    end
end)

tool.Unequipped:Connect(function()
    -- Find character via player since tool goes to Backpack on unequip
    local player = tool.Parent.Parent
    local character = player.Character
    
    if character then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.WalkSpeed = 16
            humanoid.JumpPower = 50
        end
        setInvisibility(character, false)
    end
    
    if healingConnection then
        task.cancel(healingConnection)
        healingConnection = nil
    end
    table.clear(originalTransparencies)
end)

-- Security check for flight requests
remoteEvent.OnServerEvent:Connect(function(player, isFlying)
    local character = player.Character
    if not character or not tool:IsDescendantOf(character) then return end
    
    -- Server-side anti-die/noclip logic can be added here if needed, 
    -- but physics manipulation must happen on the client for responsiveness.
end)

]]></ProtectedString>
