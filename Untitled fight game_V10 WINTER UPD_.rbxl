<Item class="Script" referent="RBX66C1625455D04AC580D8112395513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local boss = script.Parent
local human = boss:FindFirstChild("Humanoid")
 
local cooldown = 4.5
local damage = 35
local canUse = true
local lastHealth = human.Health
 
human.HealthChanged:Connect(function(currentHealth)
    -- Check if the boss actually lost health and isn't on cooldown
    if currentHealth < lastHealth and canUse then
        lastHealth = currentHealth
        
        -- Trigger the Dash
        canUse = false
        print("Boss is angry! Dashing!")
        
        -- Create a function to hurt whatever the boss touches
        local function dealDamage(hit)
            local playerHuman = hit.Parent:FindFirstChild("Humanoid")
            
            -- If it's a humanoid and not the boss itself, deal damage
            if playerHuman and hit.Parent ~= boss then
                playerHuman:TakeDamage(damage)
            end
        end
        
        -- Connect the touch event to the boss's main part
        local hitConnection = boss.HumanoidRootPart.Touched:Connect(dealDamage)
        
        -- Wait for the dash to end, then stop the damage
        task.wait(0.5) 
        hitConnection:Disconnect()
        local root = boss:FindFirstChild("HumanoidRootPart")
        local dashVelocity = Instance.new("BodyVelocity")
        
        dashVelocity.MaxForce = Vector3.new(100000, 0, 100000) -- High power
        dashVelocity.Velocity = root.CFrame.LookVector * 50 -- Speed of 50
        dashVelocity.Parent = root
        
        task.wait(0.5) -- How long the dash lasts
        dashVelocity:Destroy()
        
        
        task.wait(cooldown)
        canUse = true
    else
        lastHealth = currentHealth
    end
end)
 
 

]]></ProtectedString>
