<Item class="Script" referent="RBX66C1625455D04AC580D8104559513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script2</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local part = script.Parent
local toolName = "Venomshank2" -- Change this to the exact name of your tool
local ServerStorage = game:GetService("ServerStorage")
 
part.Touched:Connect(function(hit)
    local character = hit.Parent
    local player = game.Players:GetPlayerFromCharacter(character)
    
    -- Check if a player touched it and if they don't already have the tool
    if player and not player.Backpack:FindFirstChild(toolName) and not character:FindFirstChild(toolName) then
        local toolCopy = ServerStorage:FindFirstChild(toolName):Clone()
        toolCopy.Parent = player.Backpack
    end
end)
 

]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8045600041fa</UniqueId>
