<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454115023AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">LocalScript</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local Player = Players.LocalPlayer
local Mouse = Player:GetMouse()
 
local lastShiftTime = 0
local SHIFT_COOLDOWN = 3
local equipped = false
 
-- Function to process the actual action
local function activateAbility()
    if not equipped then return end
    
    local target = Mouse.Target
    
    -- Shapeshift check
    if target and target.Parent:FindFirstChildOfClass("Humanoid") and (tick() - lastShiftTime > SHIFT_COOLDOWN) then
        local targetCharacter = target.Parent
        local remote = Tool:WaitForChild("ServerToPod", 5)
        if remote then
            remote:FireServer("Shapeshift", targetCharacter)
        end
        lastShiftTime = tick()
    else
        -- Teleport forward check
        local targetPos = Mouse.Hit.Position
        local remote = Tool:WaitForChild("ServerToPod", 5)
        if remote then
            remote:FireServer("Teleport", targetPos)
        end
    end
end
 
-- Universal Tool Activation (Works on Mobile/PC out of the box)
Tool.Activated:Connect(activateAbility)
 
-- Tool Tracking
Tool.Equipped:Connect(function()
    equipped = true
end)
 
Tool.Unequipped:Connect(function()
    equipped = false
end)
 
-- Console Support Fallback (Button X)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if equipped and input.KeyCode == Enum.KeyCode.ButtonX then
        activateAbility()
    end
end)

]]></ProtectedString>
