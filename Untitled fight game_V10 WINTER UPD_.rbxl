<Item class="Script" referent="RBX66C1625455D04AC580D8114661513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Snow</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local TweenService = game:GetService("TweenService")
 
local MAX_SNOW_THICKNESS = 2.5
local RESPAWN_COOLDOWN = 10 -- Time in seconds before shoveled snow grows back
 
local spawnerPart = workspace:WaitForChild("SnowSpawner", 5)
if not spawnerPart then
    warn("❌ SnowSpawner part not found in Workspace!")
    return
end
 
local snowFolder = workspace:FindFirstChild("AccumulatedSnow") or Instance.new("Folder")
snowFolder.Name = "AccumulatedSnow"
snowFolder.Parent = workspace
 
local snowCoveredParts = {} -- Tracks part -> snowCap instance
 
-- Instantly forget the snow cap when deleted by a shovel so it can respawn
snowFolder.ChildRemoved:Connect(function(child)
    for part, snowCap in pairs(snowCoveredParts) do
        if snowCap == child then
            snowCoveredParts[part] = nil
            break
        end
    end
end)
 
local blacklist = {
"button", "log", "donate", "boss", "enrage", "kick", "dash", 
"tree", "jetpack", "cheese", "ui", "sign", "wand", "crowbar", 
"gui", "update", "text", "spawn", "player"
}
 
local function shouldSkipPart(part)
    local current = part
    while current and current ~= workspace do
        local lowerName = current.Name:lower()
        if lowerName == "nosnow" then return true end
        if current:FindFirstChild("NoSnow") then return true end
        for _, badWord in ipairs(blacklist) do
            if lowerName:find(badWord) then return true end
        end
        current = current.Parent
    end
    return false
end
 
local function applySnowToPart(part)
    if not part:IsA("BasePart") or not part.Anchored then return end
    if part.Transparency >= 0.9 or part.Name:match("SnowCap") or part.Name == "SnowSpawner" then return end
    if part.Parent and part.Parent:FindFirstChildOfClass("Humanoid") then return end
    
    -- If it already has an active snow cap, skip
    if snowCoveredParts[part] and snowCoveredParts[part].Parent == snowFolder then 
        return 
    end
    
    if part.Size.X < 2 or part.Size.Z < 2 then return end
    if shouldSkipPart(part) then return end
    
    local topVector = part.CFrame.UpVector
    if topVector.Y < 0.6 then return end
    
    -- Create the snow layer safely on top
    local snowCap = Instance.new("Part")
    snowCap.Name = part.Name .. "_SnowCap"
    snowCap.Anchored = true
    snowCap.CanCollide = false
    snowCap.Material = Enum.Material.Snow
    snowCap.Color = Color3.fromRGB(245, 248, 255)
    snowCap.TopSurface = Enum.SurfaceType.Smooth
    snowCap.BottomSurface = Enum.SurfaceType.Smooth
    
    local startHeight = 0.05
    snowCap.CFrame = part.CFrame * CFrame.new(0, (part.Size.Y / 2) + (startHeight / 2), 0)
    snowCap.Size = Vector3.new(part.Size.X, startHeight, part.Size.Z)
    snowCap.Parent = snowFolder
    
    snowCoveredParts[part] = snowCap
    
    local targetCFrame = part.CFrame * CFrame.new(0, (part.Size.Y / 2) + (MAX_SNOW_THICKNESS / 2), 0)
    local targetSize = Vector3.new(part.Size.X, MAX_SNOW_THICKNESS, part.Size.Z)
    
    local growTween = TweenService:Create(snowCap, TweenInfo.new(1.0, Enum.EasingStyle.Linear), {
    Size = targetSize,
    CFrame = targetCFrame
    })
    growTween:Play()
end
 
local function scanSpawnerArea()
    local partsInBox = workspace:GetPartBoundsInBox(spawnerPart.CFrame, spawnerPart.Size)
    for _, part in ipairs(partsInBox) do
        applySnowToPart(part)
    end
end
 
-- Initial scan
scanSpawnerArea()
 
-- Continuous loop to respawn snow on shoveled parts after cooldown
task.spawn(function()
    while true do
        task.wait(RESPAWN_COOLDOWN)
        scanSpawnerArea()
    end
end)

]]></ProtectedString>
