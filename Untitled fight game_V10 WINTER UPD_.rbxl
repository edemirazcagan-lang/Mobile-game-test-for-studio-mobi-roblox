<ProtectedString name="Source"><![CDATA[local ChatService = game:GetService("Chat")
local boss = script.Parent
local head = boss:WaitForChild("Head")
local humanoid = boss:WaitForChild("Humanoid")

local isBribed = false
local startHealth = humanoid.Health

-- This function finds all other scripts and turns them off
local function disableOtherScripts()
    for _, child in pairs(boss:GetDescendants()) do
        if child:IsA("Script") and child ~= script then
            child.Enabled = false
        end
    end
end

while true do
    task.wait(1)
    
    if humanoid.Health < startHealth then
        if isBribed == true then
            ChatService:Chat(head, "WHAAT ILL KILL YOU")
        end
        isBribed = false
        startHealth = humanoid.Health
    end
    
    for _, player in pairs(game.Players:GetPlayers()) do
        local character = player.Character
        if character and character:FindFirstChild("Cheese") and not isBribed then
            isBribed = true
            ChatService:Chat(head, "OMG THSTS CHEZ OK ILL EAT IT YUM.")
            disableOtherScripts() -- This calls the function to stop the boss
        end
    end
end

]]></ProtectedString>
