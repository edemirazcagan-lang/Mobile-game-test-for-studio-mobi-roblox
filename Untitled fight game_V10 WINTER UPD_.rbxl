<Item class="Script" referent="RBX66C1625455D04AC580D8114629513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Face</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
 
local HURT_DURATION = 1.0   -- How long the hurt face shows (seconds)
local CORPSE_DESPAWN = 10.0 -- How long corpse stays on death (seconds)
 
-- Grab face templates from ReplicatedStorage
local facesFolder = ReplicatedStorage:WaitForChild("Faces", 5)
 
local function setupCustomCharacter(character)
    if not facesFolder then
        warn("Missing 'Faces' folder in ReplicatedStorage!")
        return
    end
    
    local faceNormal = facesFolder:FindFirstChild("FaceNormal")
    local faceHurt   = facesFolder:FindFirstChild("FaceHurt")
    local faceLow    = facesFolder:FindFirstChild("FaceLow")
    local faceDead   = facesFolder:FindFirstChild("FaceDead")
    
    if not (faceNormal and faceHurt and faceLow and faceDead) then
        warn("Missing one or more face Decals inside ReplicatedStorage.Faces!")
        return
    end
    
    local humanoid = character:WaitForChild("Humanoid")
    local head = character:WaitForChild("Head")
    
    -- Active face decal on the player's head
    local activeFace = head:FindFirstChild("face") or head:FindFirstChildOfClass("Decal")
    if not activeFace then
        activeFace = Instance.new("Decal")
        activeFace.Name = "face"
        activeFace.Parent = head
    end
    
    local lastHealth = humanoid.Health
    local isHurtShowing = false
    
    local function updateFace()
        if not activeFace or not activeFace.Parent then return end
        
        if humanoid.Health <= 0 then
            activeFace.Texture = faceDead.Texture
        elseif isHurtShowing then
            activeFace.Texture = faceHurt.Texture
        elseif humanoid.Health < (humanoid.MaxHealth / 2) then
            activeFace.Texture = faceLow.Texture
        else
            activeFace.Texture = faceNormal.Texture
        end
    end
    
    -- Set initial face
    updateFace()
    
    -- Health changes
    humanoid.HealthChanged:Connect(function(newHealth)
        if newHealth < lastHealth and newHealth > 0 then
            lastHealth = newHealth
            isHurtShowing = true
            updateFace()
            
            task.delay(HURT_DURATION, function()
                isHurtShowing = false
                updateFace()
            end)
        else
            lastHealth = newHealth
            updateFace()
        end
    end)
    
    -- Death handler
    humanoid.Died:Connect(function()
        updateFace()
        character:BreakJoints()
        
        task.delay(CORPSE_DESPAWN, function()
            if character and character.Parent then
                character:Destroy()
            end
        end)
    end)
end
 
Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(setupCustomCharacter)
end)

]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8146300041fa</UniqueId>
