<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[-- Place this script inside the Boss Model
local Boss = script.Parent
local Humanoid = Boss:WaitForChild("Humanoid")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

-- Configuration
local COOLDOWN = 6 -- Cooldown before the boss can trigger this ability again
local FREEZE_DURATION = 0.6 -- How long the player is frozen
local MINION_NAME = "cheeseman" -- Name of the minion template in ReplicatedStorage

local canTrigger = true

-- Function to handle freezing a player
local function freezePlayer(playerCharacter)
    local playerHumanoid = playerCharacter:FindFirstChildOfClass("Humanoid")
    local rootPart = playerCharacter:FindFirstChild("HumanoidRootPart")
    
    if playerHumanoid and rootPart then
        -- Anchor the root part to freeze them physically
        rootPart.Anchored = true
        
        -- Optional visual effect: Change color slightly to show they are frozen
        for _, part in ipairs(playerCharacter:GetChildren()) do
            if part:IsA("BasePart") then
                part.LocalTransparencyModifier = 0.3 -- Make slightly translucent
            end
        end
        
        task.wait(FREEZE_DURATION)
        
        -- Unfreeze
        if rootPart then rootPart.Anchored = false end
        for _, part in ipairs(playerCharacter:GetChildren()) do
            if part:IsA("BasePart") then
                part.LocalTransparencyModifier = 0
            end
        end
    end
end

-- Function to summon the minion
local function summonMinion(targetCharacter)
    local minionTemplate = ReplicatedStorage:FindFirstChild(MINION_NAME)
    if not minionTemplate then
        warn("Minion template missing from ReplicatedStorage!")
        return
    end
    
    local minionClone = minionTemplate:Clone()
    -- Spawn minion slightly offset from the boss
    minionClone:SetPrimaryPartCFrame(Boss.PrimaryPart.CFrame * CFrame.new(math.random(-5, 5), 2, math.random(-5, 5)))
    minionClone.Parent = workspace
    
    -- Pass the target to the minion if it has an AI script
    local targetValue = Instance.new("ObjectValue")
    targetValue.Name = "Target"
    targetValue.Value = targetCharacter
    targetValue.Parent = minionClone
end

-- Trigger logic when boss takes damage
Humanoid.HealthChanged:Connect(function(currentHealth)
    local maxHealth = Humanoid.MaxHealth
    
    -- Example condition: Triggers when hit if cooldown is active
    if canTrigger and currentHealth < maxHealth then
        canTrigger = false
        
        -- Find the closest player who likely attacked the boss
        local closestPlayer = nil
        local shortestDistance = math.huge
        
        for _, player in ipairs(Players:GetPlayers()) do
            if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local distance = (Boss.PrimaryPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    closestPlayer = player
                end
            end
        end
        
        if closestPlayer and closestPlayer.Character then
            -- Execute mechanics concurrently
            task.spawn(freezePlayer, closestPlayer.Character)
            summonMinion(closestPlayer.Character)
        end
        
        -- Cooldown management
        task.wait(COOLDOWN)
        canTrigger = true
    end
end)

]]></ProtectedString>
