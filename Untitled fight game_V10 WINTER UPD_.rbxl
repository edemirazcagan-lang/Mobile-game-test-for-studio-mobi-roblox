<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454115407AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">LocalScript</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local rootPart = character:WaitForChild("HumanoidRootPart")

--// Configuration
local ENRAGE_KEY = Enum.KeyCode.E -- PC Toggle Key
local NORMAL_SPEED = 16
local ENRAGE_SPEED = 50
local HEAL_AMOUNT = 5 -- Health recovered per second
local FLY_SPEED = 60

--// State Variables
local isEnraged = false
local bodyVelocity = nil
local bodyGyro = nil
local camera = workspace.CurrentCamera

--// Mobile Support: Create a Screen Button
local playerGui = player:WaitForChild("PlayerGui")
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "EnrageGui"
screenGui.ResetOnSpawn = true

local mobileButton = Instance.new("TextButton")
mobileButton.Size = UDim2.new(0, 100, 0, 50)
mobileButton.Position = UDim2.new(0.75, 0, 0.4, 0) -- Positioned on the right side for thumbs
mobileButton.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
mobileButton.TextColor3 = Color3.fromRGB(255, 255, 255)
mobileButton.TextSize = 18
mobileButton.Font = Enum.Font.SourceSansBold
mobileButton.Text = "ENRAGE"
mobileButton.Parent = screenGui

-- Only show the mobile button if the player is on a touch device
if UserInputService.TouchEnabled then
    screenGui.Parent = playerGui
else
    screenGui:Destroy()
end

--// Flight Mechanics
local function startFlight()
    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.Parent = rootPart
    
    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bodyGyro.CFrame = rootPart.CFrame
    bodyGyro.Parent = rootPart
    
    humanoid.PlatformStand = true -- Prevents running animations from interfering
end

local function stopFlight()
    if bodyVelocity then bodyVelocity:Destroy() end
    if bodyGyro then bodyGyro:Destroy() end
    humanoid.PlatformStand = false
end

--// Toggle Enrage Mode
local function toggleEnrage()
    isEnraged = not isEnraged
    
    if isEnraged then
        -- Activate Enraged Effects
        humanoid.WalkSpeed = ENRAGE_SPEED
        mobileButton.Text = "CALM"
        mobileButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        startFlight()
    else
        -- Deactivate Enraged Effects
        humanoid.WalkSpeed = NORMAL_SPEED
        mobileButton.Text = "ENRAGE"
        mobileButton.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
        stopFlight()
    end
end

--// Flying & Healing Loop
RunService.RenderStepped:Connect(function(deltaTime)
    if isEnraged and rootPart and humanoid.Health > 0 then
        -- 1. Passive Healing
        if humanoid.Health < humanoid.MaxHealth then
            humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + (HEAL_AMOUNT * deltaTime))
        end
        
        -- 2. Flight Movement Direction
        local moveDirection = humanoid.MoveDirection
        
        -- Look where the camera looks
        bodyGyro.CFrame = camera.CFrame
        
        -- Fly in the direction the player is aiming/moving
        if moveDirection.Magnitude > 0 then
            -- Calculate forward/backward/sideways direction relative to camera pitch
            local flyDir = camera.CFrame:VectorToWorldSpace(Vector3.new(
            moveDirection.X, 
            moveDirection.Y, 
            -moveDirection.Z
            ))
            bodyVelocity.Velocity = camera.CFrame.LookVector * FLY_SPEED * (moveDirection.Z > 0 and -1 or 1) 
            + camera.CFrame.RightVector * FLY_SPEED * moveDirection.X
        else
            bodyVelocity.Velocity = Vector3.new(0, 0, 0)
        end
    end
end)

--// Input Listeners
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == ENRAGE_KEY then
        toggleEnrage()
    end
end)

mobileButton.MouseButton1Click:Connect(function()
    toggleEnrage()
end)

-- Clean up if player dies
humanoid.Died:Connect(function()
    stopFlight()
    screenGui:Destroy()
end)

]]></ProtectedString>
<UniqueId name="UniqueId">7bdf20b295fbe64d068941540800437f</UniqueId>
</Properties>
</Item>
<Item class="Script" referent="RBX66C1625455D04AC580D8115409513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script2</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local tool = script.Parent
local handle = tool:WaitForChild("Handle")
 
-- Configurable Settings
local BASE_DAMAGE = 750
local CRIT_DAMAGE = 950
local CRIT_CHANCE = 0.70 -- 20% chance to do a powerful slash
local ATTACK_COOLDOWN = 0.8
 
local canAttack = true
local hasHitTable = {} -- Prevents damaging the same target multiple times in one swing
 
-- Function to handle dealing damage
local function onTouch(otherPart)
    local character = otherPart.Parent
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    -- Ensure it's a valid target and not the wielder of the sword
    if humanoid and character ~= tool.Parent and not hasHitTable[character] then
        hasHitTable[character] = true -- Mark target as hit for this swing
        
        -- Roll for a random powerful slash
        local isCrit = math.random() <= CRIT_CHANCE
        
        if isCrit then
            humanoid:TakeDamage(CRIT_DAMAGE)
            print("Critical Slash! Dealt " .. CRIT_DAMAGE .. " damage.")
            
            -- Optional: Add a visual cue for the powerful slash (e.g., changing sword color briefly)
            local originalColor = handle.BrickColor
            handle.BrickColor = BrickColor.new("Bright red")
            task.wait(0.2)
            handle.BrickColor = originalColor
        else
            humanoid:TakeDamage(BASE_DAMAGE)
            print("Normal Slash. Dealt " .. BASE_DAMAGE .. " damage.")
        end
    end
end
 
-- Function triggered when the player clicks/activates the tool
local function onActivated()
    if not canAttack then return end
    canAttack = false
    table.clear(hasHitTable) -- Reset the hit targets for the new swing
    
    -- Connect the touch detection
    local touchConnection = handle.Touched:Connect(onTouch)
    
    -- Play animation here if you have one:
    -- local humanoid = tool.Parent:FindFirstChildOfClass("Humanoid")
    -- local animator = humanoid:FindFirstChildOfClass("Animator")
    -- if animator then ... end
    
    task.wait(ATTACK_COOLDOWN) -- Duration of the hitbox/swing phase
    touchConnection:Disconnect() -- Turn off hitbox
    
    canAttack = true
end
 
tool.Activated:Connect(onActivated)

]]></ProtectedString>
