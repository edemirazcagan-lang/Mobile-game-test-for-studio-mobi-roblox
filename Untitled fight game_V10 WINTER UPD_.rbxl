<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
 
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local button = script.Parent
 
-- Configuration
local OFF_COLOR = Color3.fromRGB(255, 255, 255)      -- Dark Gray when OFF
local ON_COLOR = Color3.fromRGB(0, 255, 255)      -- Bright Blue when ON
local CAMERA_OFFSET = Vector3.new(1.75, 0, 0)     -- Over-the-shoulder offset
 
local isShiftLocked = false
button.ImageColor3 = OFF_COLOR
 
-- Toggle function
local function toggleShiftLock()
    isShiftLocked = not isShiftLocked
    
    if isShiftLocked then
        button.ImageColor3 = ON_COLOR
        UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
    else
        button.ImageColor3 = OFF_COLOR
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    end
end
 
-- Button click event
button.MouseButton1Click:Connect(toggleShiftLock)
 
-- Update loop for character rotation and camera offset
RunService.RenderStepped:Connect(function()
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    
    if isShiftLocked and humanoid and rootPart and humanoid.Health > 0 then
        -- Keep mouse locked in center
        UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
        
        -- Apply over-the-shoulder camera offset
        humanoid.CameraOffset = humanoid.CameraOffset:Lerp(CAMERA_OFFSET, 0.25)
        
        -- Disable auto-rotate and smoothly face the camera's direction
        humanoid.AutoRotate = false
        local _, yAngle, _ = camera.CFrame:ToEulerAnglesYXZ()
        rootPart.CFrame = CFrame.new(rootPart.Position) * CFrame.Angles(0, yAngle, 0)
    else
        -- Reset camera offset and rotation back to normal
        if humanoid then
            humanoid.CameraOffset = humanoid.CameraOffset:Lerp(Vector3.new(0, 0, 0), 0.25)
            humanoid.AutoRotate = true
        end
    end
end)

]]></ProtectedString>
<UniqueId name="UniqueId">7bdf20b295fbe64d068941459600437f</UniqueId>
</Properties>
</Item>
