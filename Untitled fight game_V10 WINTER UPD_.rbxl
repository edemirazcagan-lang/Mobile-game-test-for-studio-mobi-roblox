<Item class="Script" referent="RBX66C1625455D04AC580D8114421513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local tool = script.Parent
local healingAmount = 35 -- How much health to restore each tick
local healInterval = 1 -- How often to heal (in seconds)

-- Enhanced stats
local bonusSpeed = 32 -- Default is 16
local bonusJump = 75 -- Default is 50

local healingCoroutine = nil
local isEquipped = false

-- Function to handle continuous healing
local function startHealing(humanoid)
    healingCoroutine = task.spawn(function()
        while isEquipped and humanoid and humanoid.Health > 0 do
            if humanoid.Health < humanoid.MaxHealth then
                humanoid.Health = math.min(humanoid.Health + healingAmount, humanoid.MaxHealth)
            end
            task.wait(healInterval)
        end
    end)
end

-- When the player holds the item
tool.Equipped:Connect(function()
    local character = tool.Parent
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    if humanoid then
        isEquipped = true
        
        -- Apply Speed and Jump boosts
        humanoid.WalkSpeed = bonusSpeed
        humanoid.UseJumpHeight = true -- Ensures JumpHeight is used instead of JumpPower
        humanoid.JumpHeight = bonusJump 
        
        -- Start the healing loop
        startHealing(humanoid)
    end
end)

-- When the player puts the item away
tool.Unequipped:Connect(function()
    isEquipped = false
    if healingCoroutine then
        healingCoroutine = nil -- Stops the healing loop
    end
    
    -- Find the character (it moves back to the player's backpack)
    local player = tool.Parent.Parent
    if player and player:IsA("Player") and player.Character then
        local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            -- Reset to default Roblox stats
            humanoid.WalkSpeed = 16
            humanoid.JumpHeight = 7.2 -- Default Roblox jump height
        end
    end
end)

]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8144220041fa</UniqueId>
</Properties>
</Item>
<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454114423AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">LocalScript</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
 
local tool = script.Parent
local player = Players.LocalPlayer
 
-- Change this to whatever controls or message you want to display
local controlsMessage = "Controls: [Left Click] to Attack | [E] to Dash"
 
local hasShownThisLife = false
 
local function showControls()
    -- Check if the message has already been shown during this life
    if hasShownThisLife then return end
    
    -- Send a message directly to the player's chat box
    StarterGui:SetCore("ChatMakeSystemMessage", {
    Text = controlsMessage;
    Color = Color3.fromRGB(255, 255, 100); -- Yellow text (change as you like)
    Font = Enum.Font.SourceSansBold;
    TextSize = 18;
    })
    
    -- Mark as shown so it won't trigger again until the player resets
    hasShownThisLife = true
end
 
-- Trigger when the tool is equipped
tool.Equipped:Connect(showControls)
 
-- Reset the tracker when the player dies/respawns
local function onCharacterAdded(character)
    hasShownThisLife = false
end
 
if player.Character then
    onCharacterAdded(player.Character)
end
player.CharacterAdded:Connect(onCharacterAdded)
 

]]></ProtectedString>
