<Item class="Script" referent="RBX66C1625455D04AC580D8100489513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">true</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script5</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local BadgeService = game:GetService("BadgeService")
local bossModel = script.Parent
local humanoid = bossModel:WaitForChild("Humanoid")
 
-- REPLACE THIS WITH YOUR ACTUAL BADGE ID
local BADGE_ID = 1137650227955060
 
local function awardBadge(player)
    -- Wrap web calls in pcall to prevent the entire script from crashing if Roblox servers lag
    local success, result = pcall(function()
        return BadgeService:AwardBadge(player.UserId, BADGE_ID)
    end)
    
    if success then
        print("Successfully awarded badge to: " .. player.Name)
    else
        warn("Failed to award badge: " .. tostring(result))
    end
end
 
-- Detect when the boss dies
humanoid.Died:Connect(function()
    -- Look for the creator tag inserted by the killing weapon
    local creatorTag = humanoid:FindFirstChild("creator")
    
    if creatorTag and creatorTag.Value then
        local killerPlayer = creatorTag.Value
        
        -- Ensure the killer is still a valid active player in the server
        if game.Players:FindFirstChild(killerPlayer.Name) then
            awardBadge(killerPlayer)
        end
    else
        warn("No creator tag found on the boss. Cannot determine who got the kill.")
    end
end)

]]></ProtectedString>
