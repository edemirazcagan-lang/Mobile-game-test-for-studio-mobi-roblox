<Item class="Script" referent="RBX66C1625455D04AC580D8100223513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Model Respawn Script</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[--how to setup
--1. put script into the character model
--you should be done, once the npc/character dies it respawns
--very easy to configure

local model = script.Parent
local humanoid = model.Humanoid
local resptime = 4
local modclone = model:Clone()

humanoid.Died:connect(function()
    wait(resptime)
    modclone:MakeJoints()
    modclone.Humanoid.Health = modclone.Humanoid.MaxHealth
    modclone.Parent = workspace
    script.Parent:Destroy()
end)


]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8002240041fa</UniqueId>
</Properties>
</Item>
<Item class="Script" referent="RBX66C1625455D04AC580D8100225513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script4</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local model = script.Parent
local humanoid = model:WaitForChild("Humanoid")
 
local function summonSpikes()
    -- Create 5 spikes in a row
    for i = 1, 5 do
        local spike = Instance.new("Part")
        spike.Size = Vector3.new(4, 1, 4)
        spike.BrickColor = BrickColor.new("Crimson")
        spike.Anchored = true
        spike.CanCollide = false -- So players don't get stuck
        
        -- Position the spike in front of the NPC
        local offset = model.PrimaryPart.CFrame.LookVector * (i * 6)
        spike.Position = model.PrimaryPart.Position + offset - Vector3.new(0, 2, 0)
        spike.Parent = game.Workspace
        
        -- Damage players who touch it
        spike.Touched:Connect(function(hit)
            local character = hit.Parent
            local enemyHumanoid = character:FindFirstChild("Humanoid")
            
            -- Only damage if it's NOT the NPC who summoned it
            if enemyHumanoid and character ~= model then
                enemyHumanoid:TakeDamage(100)
            end
        end)
        
        -- Remove the spike after 2 seconds
        game.Debris:AddItem(spike,70 )
        task.wait(10)
    end
end
 
-- Run the summon every 5 seconds
while true do
    task.wait(2.5)
    summonSpikes()
end
 

]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8002260041fa</UniqueId>
</Properties>
</Item>
<Item class="Script" referent="RBX66C1625455D04AC580D8100227513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script8</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local badgeService = game:GetService("BadgeService")
local humanoid = script.Parent:WaitForChild("Humanoid")
 
-- Change this to your actual Badge ID
local BADGE_ID = 2964078360840363
 
humanoid.Died:Connect(function()
    -- Find the player who tagged the boss (usually through a CreatorTag)
    local tag = humanoid:FindFirstChild("creator")
    
    if tag and tag.Value then
        local player = tag.Value
        
        -- Give the badge
        if not badgeService:UserHasBadgeAsync(player.UserId, BADGE_ID) then
            badgeService:AwardBadge(player.UserId, BADGE_ID)
        end
    end
end)
 

]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8002280041fa</UniqueId>
</Properties>
</Item>
<Item class="Script" referent="RBX66C1625455D04AC580D8100229513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script5</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local npc = script.Parent
local humanoid = npc:WaitForChild("Humanoid")
local hasUsedWall = false

humanoid.HealthChanged:Connect(function(currentHealth)
    if currentHealth < (humanoid.MaxHealth / 2) and not hasUsedWall then
        hasUsedWall = true
        
        -- A list of positions for the 4 walls
        local offsets = {
        Vector3.new(0, 0, 5),  -- Front
        Vector3.new(0, 0, -5), -- Back
        Vector3.new(5, 0, 0),  -- Right
        Vector3.new(-5, 0, 0)  -- Left
        }
        
        local createdWalls = {}
        
        for _, offset in pairs(offsets) do
            local wall = Instance.new("Part")
            wall.Size = Vector3.new(10, 10, 1)
            -- If the offset is for the sides, we swap the Size width and thickness
            if offset.X ~= 0 then
                wall.Size = Vector3.new(1, 10, 10)
            end
            
            wall.Position = npc.PrimaryPart.Position + offset
            wall.Anchored = true
            wall.Parent = game.Workspace
            table.insert(createdWalls, wall)
        end
        
        task.wait(5) -- Box stays for 5 seconds
        
        for _, wall in pairs(createdWalls) do
            wall:Destroy()
        end
        
        task.wait(10) -- Cooldown
        hasUsedWall = false
    end
end)


]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8002300041fa</UniqueId>
</Properties>
</Item>
<Item class="Script" referent="RBX66C1625455D04AC580D8100231513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script6</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local character = script.Parent
local humanoid = character:WaitForChild("Humanoid")
local rootPart = character:WaitForChild("HumanoidRootPart")
local Debris = game:GetService("Debris")
 
local lastHealth = humanoid.Health
local canFire = true 
local COOLDOWN_TIME = 1.5 
 
-- 1. MOD: Hasar Veren Fırlatıcı
local function fireDamagePart()
    local part = Instance.new("Part")
    part.Size = Vector3.new(2, 2, 4)
    part.BrickColor = BrickColor.new("Bright yellow")
    part.Material = Enum.Material.Neon
    part.CanCollide = false
    part.CFrame = rootPart.CFrame * CFrame.new(0, 0, -4)
    part.Parent = game.Workspace
    
    local attachment = Instance.new("Attachment", part)
    local velocity = Instance.new("LinearVelocity", attachment)
    velocity.MaxForce = math.huge
    velocity.VectorVelocity = rootPart.CFrame.LookVector * 180
    velocity.Attachment0 = attachment
    
    local hasHit = false 
    part.Touched:Connect(function(hit)
        if hasHit then return end 
            local enemyHumanoid = hit.Parent:FindFirstChild("Humanoid")
            if enemyHumanoid and hit.Parent ~= character then
                hasHit = true 
                enemyHumanoid:TakeDamage(450) 
                part:Destroy()
            end
        end)
        Debris:AddItem(part, 2)
    end
    
    -- 2. MOD: Kendine Çeken Fırlatıcı
    local function firePullPart()
        local part = Instance.new("Part")
        part.Size = Vector3.new(3, 3, 3)
        part.Shape = Enum.PartType.Ball -- Çeken mermi küre olsun
        part.BrickColor = BrickColor.new("Electric blue")
        part.Material = Enum.Material.ForceField
        part.CanCollide = false
        part.CFrame = rootPart.CFrame * CFrame.new(0, 0, -4)
        part.Parent = game.Workspace
        
        local attachment = Instance.new("Attachment", part)
        local velocity = Instance.new("LinearVelocity", attachment)
        velocity.MaxForce = math.huge
        velocity.VectorVelocity = rootPart.CFrame.LookVector * 120 -- Çekme mermisi biraz daha yavaş gitsin
        velocity.Attachment0 = attachment
        
        local hasHit = false 
        part.Touched:Connect(function(hit)
            if hasHit then return end 
                local enemyRoot = hit.Parent:FindFirstChild("HumanoidRootPart")
                if enemyRoot and hit.Parent ~= character then
                    hasHit = true 
                    -- Düşmanı karakterin yanına çeker
                    enemyRoot.CFrame = rootPart.CFrame * CFrame.new(0, 0, -5)
                    part:Destroy()
                end
            end)
            Debris:AddItem(part, 2)
        end
        
        -- Ana Tetikleyici
        humanoid.HealthChanged:Connect(function(currentHealth)
            if currentHealth < lastHealth and canFire then
                canFire = false
                
                -- Can kontrolü: %50'nin altı mı?
                if currentHealth < (humanoid.MaxHealth / 2) then
                    firePullPart() -- Çekme modu
                else
                    fireDamagePart() -- Hasar modu
                end
                
                task.wait(COOLDOWN_TIME)
                canFire = true
            end
            lastHealth = currentHealth
        end)
       
]]></ProtectedString>
