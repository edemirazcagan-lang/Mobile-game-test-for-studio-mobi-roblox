<Item class="Script" referent="RBX66C1625455D04AC580D8117371513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[-- Place this script inside the RocketMinion Model
local Minion = script.Parent
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")
 
-- Wait for the boss script to assign a target
local targetValue = Minion:WaitForChild("Target")
while not targetValue.Value do task.wait() end
local targetCharacter = targetValue.Value
local targetRoot = targetCharacter:WaitForChild("HumanoidRootPart")
 
-- Configuration
local FIRE_RATE = 3.5 -- Seconds between shots
local ROCKET_SPEED = 60
local DAMAGE = 65
local KNOCKBACK_FORCE = 50
 
local function shootRocket()
    if not targetRoot then return end
    
    -- 1. Create Rocket Instance
    local rocket = Instance.new("Part")
    rocket.Size = Vector3.new(1, 1, 3)
    rocket.BrickColor = BrickColor.new("Bright red")
    rocket.Shape = Enum.PartType.Cylinder
    rocket.CFrame = CFrame.lookAt(Minion.PrimaryPart.Position + Vector3.new(0, 2, 0), targetRoot.Position)
    rocket.CanCollide = false
    rocket.Parent = workspace
    
    -- 2. Add Velocity
    local linearVelocity = Instance.new("LinearVelocity")
    local attachment = Instance.new("Attachment")
    attachment.Parent = rocket
    
    linearVelocity.MaxForce = math.huge
    linearVelocity.VectorVelocity = rocket.CFrame.LookVector * ROCKET_SPEED
    linearVelocity.Attachment0 = attachment
    linearVelocity.Parent = rocket
    
    -- Clean up rocket automatically if it flies off into space
    Debris:AddItem(rocket, 5)
    
    -- 3. Hit Detection
    rocket.Touched:Connect(function(hit)
        if hit:IsDescendantOf(Minion) or hit:IsDescendantOf(workspace:FindFirstChild("Boss")) then 
            return -- Don't blow up on self or the boss
        end
        
        -- Create Explosion Effect
        local explosion = Instance.new("Explosion")
        explosion.Position = rocket.Position
        explosion.BlastRadius = 0 -- Disable default Roblox explosion damage/knockback to use custom math instead
        explosion.Parent = workspace
        
        -- Custom Damage and Knockback calculation
        local hitModel = hit.Parent
        local hitHumanoid = hitModel:FindFirstChildOfClass("Humanoid")
        local hitRoot = hitModel:FindFirstChild("HumanoidRootPart")
        
        if hitHumanoid and hitRoot and hitModel == targetCharacter then
            hitHumanoid:TakeDamage(DAMAGE)
            
            -- Calculate knockback direction (Away from the explosion point)
            local direction = (hitRoot.Position - rocket.Position).Unit
            direction = Vector3.new(direction.X, 0.5, direction.Z).Unit -- Pop them slightly up into the air
            
            -- Apply force
            hitRoot:ApplyImpulse(direction * KNOCKBACK_FORCE * hitRoot:GetMass())
        end
        
        rocket:Destroy()
    end)
end
 
-- Attack loop
while targetRoot and Minion:FindFirstChild("Humanoid") and Minion.Humanoid.Health > 0 do
    shootRocket()
    task.wait(FIRE_RATE)
end

]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8173720041fa</UniqueId>
</Properties>
