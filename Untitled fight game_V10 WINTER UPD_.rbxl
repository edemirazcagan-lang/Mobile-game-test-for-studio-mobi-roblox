<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Tag2Script</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ServerScriptService = game:GetService("ServerScriptService")

-- REPLACE THESE WITH YOUR ACTUAL GAMEPASS IDS
local LOW_TIER_ID = 1893245794 
local HIGH_TIER_ID = 1890851893

-- Function to handle tag assignment
local function assignChatTag(player)
    -- Wait for the Chat Service to load
    local ChatService = require(ServerScriptService:WaitForChild("ChatServiceRunner"):WaitForChild("ChatService"))
    local speaker = nil
    
    while speaker == nil do
        speaker = ChatService:GetSpeaker(player.Name)
        task.wait(0.1)
    end
    
    -- Check ownership and assign tags based on priority
    if MarketplaceService:UserOwnsGamePassAsync(player.UserId, HIGH_TIER_ID) then
        speaker:SetExtraData("Tags", {{TagText = "High Tier", TagColor = Color3.fromRGB(255, 215, 0)}})
    elseif MarketplaceService:UserOwnsGamePassAsync(player.UserId, LOW_TIER_ID) then
        speaker:SetExtraData("Tags", {{TagText = "Low Tier", TagColor = Color3.fromRGB(192, 192, 192)}})
    end
end

-- Run function when player joins
Players.PlayerAdded:Connect(assignChatTag)


]]></ProtectedString>
