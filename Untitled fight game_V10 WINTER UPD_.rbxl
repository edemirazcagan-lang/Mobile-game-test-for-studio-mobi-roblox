<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[-- Services
local Lighting = game:GetService("Lighting")
 
-- Configuration
local CYCLE_SPEED = 0.001 -- How fast the time changes (higher = faster days)
local START_TIME = 6     -- The hour the game starts at (6 = 6:00 AM)
 
-- Initialize
Lighting.ClockTime = START_TIME
 
-- Main Loop
while true do
    -- Increment the clock time
    Lighting.ClockTime = Lighting.ClockTime + CYCLE_SPEED
    
    -- Optional: If you want to change atmospheric properties based on time,
    -- you can check Lighting.ClockTime here (e.g., changing ambient light at night).
    
    -- Wait for the next physics frame to keep it smooth and prevent crashing
    task.wait()
end

]]></ProtectedString>
