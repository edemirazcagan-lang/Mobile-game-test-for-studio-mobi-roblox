<Item class="Script" referent="RBX66C1625455D04AC580D8101155513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script3</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local boss = script.Parent
local range = 65
local canAttack = true -- This is our "stoplight"
local cooldownTime = 3.5 -- How many seconds to wait between attacks

while true do
    task.wait(1) 
    
    for _, player in pairs(game.Players:GetPlayers()) do
        local char = player.Character
        -- Check if player is close AND the boss is ready to attack
        if char and canAttack then
            local distance = (char.HumanoidRootPart.Position - boss.HumanoidRootPart.Position).Magnitude
            
            if distance < range then
                canAttack = false -- Set to false so it doesn't spam spikes
                
                -- Summon Spike Logic
                local spike = Instance.new("Part")
                spike.Size = Vector3.new(2, 6, 2)
                spike.Position = char.HumanoidRootPart.Position
                spike.Anchored = true
                spike.Parent = game.Workspace
                
                spike.Touched:Connect(function(hit)
                    local hum = hit.Parent:FindFirstChild("Humanoid")
                    if hum then
                        hum.Health -= 35
                        hum.WalkSpeed = 0
                        task.wait(5)
                        hum.WalkSpeed = 16
                    end
                end)
                
                game.Debris:AddItem(spike, 3)
                
                -- Wait for the cooldown, then turn the light back to "true"
                task.wait(cooldownTime)
                canAttack = true 
            end
        end
    end
end


]]></ProtectedString>
