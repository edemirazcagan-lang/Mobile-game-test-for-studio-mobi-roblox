<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local npc = script.Parent
local root = npc:WaitForChild("HumanoidRootPart")
 
-- Settings
local range = 65
local damage = 200  
function spawnMeteor(targetPos)
    local meteor = Instance.new("Part")
    meteor.Shape = Enum.PartType.Ball
    meteor.Size = Vector3.new(10,10, 10)
    meteor.Color = Color3.fromRGB(255, 100, 0)
    meteor.Material = Enum.Material.Neon
    meteor.Position = targetPos + Vector3.new(0, 40, 0) -- Start high up
    meteor.Parent = game.Workspace
    
    -- Make it fall fast
    meteor.Velocity = Vector3.new(0, -100, 0)
    
    -- Damage when it hits
    meteor.Touched:Connect(function(hit)
        local hum = hit.Parent:FindFirstChild("Humanoid")
        if hum then
            hum:TakeDamage(damage)
        end
        meteor:Destroy() -- Disappear after hitting
    end)
end
 
while true do
    task.wait(12) -- Wait 2 seconds between attacks
    for _, player in pairs(game.Players:GetPlayers()) do
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local dist = (root.Position - char.HumanoidRootPart.Position).Magnitude
            if dist < range then
                spawnMeteor(char.HumanoidRootPart.Position)
            end
        end
    end
end
 

]]></ProtectedString>
