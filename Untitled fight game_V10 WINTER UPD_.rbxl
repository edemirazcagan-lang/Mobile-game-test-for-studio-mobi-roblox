<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454115335AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">LocalScript</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local camera = workspace.CurrentCamera
 
local tool = script.Parent
local castEvent = tool:WaitForChild("CastEvent", 10)
 
if not castEvent then
    warn("CastEvent not found inside the ThornRing tool!")
    return
end
 
local screenGui = nil
local DEBOUNCE = false
local COOLDOWN = 1.5
 
-- Universal target position: Casts a ray from the center of the screen (works on PC, Mobile, and Console)
local function getTargetPosition()
    local viewportSize = camera.ViewportSize
    local unitRay = camera:ViewportPointToRay(viewportSize.X / 2, viewportSize.Y / 2)
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    if player.Character then
        raycastParams.FilterDescendantsInstances = {player.Character}
    end
    
    local raycastResult = workspace:Raycast(unitRay.Origin, unitRay.Direction * 300, raycastParams)
    if raycastResult then
        return raycastResult.Position
    else
        -- Fallback if looking into the sky
        return unitRay.Origin + (unitRay.Direction * 100)
    end
end
 
local function castSpell(spellName, cooldownTime)
    if DEBOUNCE then return end
    DEBOUNCE = true
    castEvent:FireServer(spellName, getTargetPosition())
    task.wait(cooldownTime)
    DEBOUNCE = false
end
 
tool.Equipped:Connect(function()
    if screenGui then screenGui:Destroy() end
    
    screenGui = Instance.new("ScreenGui")
    screenGui.Name = "ThornRingGUI"
    screenGui.ResetOnSpawn = false
    screenGui.Parent = playerGui
    
    -- IceShock Button
    local iceShockBtn = Instance.new("TextButton")
    iceShockBtn.Name = "IceShockButton"
    iceShockBtn.Size = UDim2.new(0, 130, 0, 50)
    iceShockBtn.Position = UDim2.new(1, -150, 0.55, 0)
    iceShockBtn.BackgroundColor3 = Color3.fromRGB(40, 120, 220)
    iceShockBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    iceShockBtn.TextSize = 18
    iceShockBtn.Font = Enum.Font.GothamBold
    iceShockBtn.Text = "IceShock"
    iceShockBtn.Parent = screenGui
    
    local corner1 = Instance.new("UICorner")
    corner1.CornerRadius = UDim.new(0, 10)
    corner1.Parent = iceShockBtn
    
    iceShockBtn.MouseButton1Click:Connect(function()
        castSpell("IceShock", COOLDOWN)
    end)
    
    -- SnowGrave Button
    local snowGraveBtn = Instance.new("TextButton")
    snowGraveBtn.Name = "SnowGraveButton"
    snowGraveBtn.Size = UDim2.new(0, 130, 0, 50)
    snowGraveBtn.Position = UDim2.new(1, -150, 0.40, 0)
    snowGraveBtn.BackgroundColor3 = Color3.fromRGB(150, 210, 255)
    snowGraveBtn.TextColor3 = Color3.fromRGB(15, 30, 60)
    snowGraveBtn.TextSize = 18
    snowGraveBtn.Font = Enum.Font.GothamBold
    snowGraveBtn.Text = "SnowGrave"
    snowGraveBtn.Parent = screenGui
    
    local corner2 = Instance.new("UICorner")
    corner2.CornerRadius = UDim.new(0, 10)
    corner2.Parent = snowGraveBtn
    
    snowGraveBtn.MouseButton1Click:Connect(function()
        castSpell("SnowGrave", COOLDOWN * 2)
    end)
end)
 
tool.Unequipped:Connect(function()
    if screenGui then
        screenGui:Destroy()
        screenGui = nil
    end
end)

]]></ProtectedString>
