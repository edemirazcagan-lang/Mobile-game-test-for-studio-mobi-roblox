<Item class="Script" referent="RBX66C1625455D04AC580D8115337513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local tool = script.Parent
local castEvent = tool:WaitForChild("CastEvent")

-- Your Deltarune Sound IDs
local SOUND_SNOWGRAVE = "rbxassetid://91562523400233"
local SOUND_ICESHOCK = "rbxassetid://117308807424434"
local SOUND_ENEMY_FROZEN = "rbxassetid://116642736947887"

local permanentlyFrozenUsers = {}

-- Helper function to play a 3D sound effect on a specific part
local function playSoundAtPart(soundId, parentPart, volume)
    if not parentPart then return end
    local sound = Instance.new("Sound")
    sound.SoundId = soundId
    sound.Volume = volume or 1
    sound.RollOffMaxDistance = 150
    sound.Parent = parentPart
    sound:Play()
    
    sound.Ended:Connect(function()
        sound:Destroy()
    end)
end

local function freezeCharacterForever(character)
    if not character or character:GetAttribute("IsFrozenForever") then return end
    character:SetAttribute("IsFrozenForever", true)
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not rootPart then return end
    
    humanoid.WalkSpeed = 0
    humanoid.JumpPower = 0
    humanoid.JumpHeight = 0
    humanoid.AutoRotate = false
    
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored = true
        end
    end
    
    for _, desc in ipairs(character:GetDescendants()) do
        if desc:IsA("Script") or desc:IsA("LocalScript") then
            desc.Disabled = true
        end
    end
    
    local iceBlock = Instance.new("Part")
    iceBlock.Name = "DeltaruneIceTomb"
    iceBlock.Size = Vector3.new(5, 7, 5)
    iceBlock.CFrame = rootPart.CFrame
    iceBlock.Anchored = true
    iceBlock.CanCollide = true
    iceBlock.Material = Enum.Material.Ice
    iceBlock.Color = Color3.fromRGB(130, 220, 255)
    iceBlock.Transparency = 0.35
    iceBlock.Parent = character
    
    -- Play the Enemy Frozen sound right on the ice block
    playSoundAtPart(SOUND_ENEMY_FROZEN, iceBlock, 1.2)
    
    local attachment = Instance.new("Attachment")
    attachment.Parent = rootPart
    
    local emitter = Instance.new("ParticleEmitter")
    emitter.Name = "IceSparkles"
    emitter.Color = ColorSequence.new(Color3.fromRGB(200, 240, 255), Color3.fromRGB(100, 180, 255))
    emitter.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0)})
    emitter.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1)})
    emitter.Lifetime = NumberRange.new(0.5, 1.5)
    emitter.Rate = 35
    emitter.Speed = NumberRange.new(2, 5)
    emitter.SpreadAngle = Vector2.new(45, 45)
    emitter.Acceleration = Vector3.new(0, -2, 0)
    emitter.Parent = attachment
    
    local targetPlayer = Players:GetPlayerFromCharacter(character)
    if targetPlayer then
        permanentlyFrozenUsers[targetPlayer.UserId] = rootPart.CFrame
    end
end

Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function(character)
        local savedCFrame = permanentlyFrozenUsers[player.UserId]
        if savedCFrame then
            task.wait(0.2)
            local root = character:WaitForChild("HumanoidRootPart", 5)
            if root then
                root.CFrame = savedCFrame
            end
            freezeCharacterForever(character)
        end
    end)
end)

local function spawnSpellEffect(position, radius, isSnowGrave)
    if isSnowGrave then
        local snowBase = Instance.new("Part")
        snowBase.Name = "SnowGraveCylinderColumn"
        snowBase.Shape = Enum.PartType.Cylinder
        snowBase.Size = Vector3.new(15, radius * 2, radius * 2)
        snowBase.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
        snowBase.Anchored = true
        snowBase.CanCollide = false
        snowBase.Transparency = 1
        snowBase.Parent = workspace
        
        -- Play SnowGrave sound from the blizzard column
        playSoundAtPart(SOUND_SNOWGRAVE, snowBase, 1.5)
        
        local blizzard = Instance.new("ParticleEmitter")
        blizzard.Name = "SnowGraveBlizzard"
        blizzard.EmissionDirection = Enum.NormalId.Top
        blizzard.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(160, 225, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(90, 175, 255))
        })
        blizzard.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1.5),
        NumberSequenceKeypoint.new(0.5, 3),
        NumberSequenceKeypoint.new(1, 0)
        })
        blizzard.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.1),
        NumberSequenceKeypoint.new(0.7, 0.3),
        NumberSequenceKeypoint.new(1, 1)
        })
        blizzard.Lifetime = NumberRange.new(1.0, 1.8)
        blizzard.Rate = 800
        blizzard.Speed = NumberRange.new(45, 75)
        blizzard.SpreadAngle = Vector2.new(15, 15)
        blizzard.RotSpeed = NumberRange.new(-200, 200)
        blizzard.Rotation = NumberRange.new(0, 360)
        blizzard.LightEmission = 0.8
        blizzard.Parent = snowBase
        
        local shards = Instance.new("ParticleEmitter")
        shards.Name = "SnowGraveShards"
        shards.EmissionDirection = Enum.NormalId.Top
        shards.Color = ColorSequence.new(Color3.fromRGB(200, 245, 255))
        shards.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(1, 0.2)
        })
        shards.Lifetime = NumberRange.new(0.8, 1.5)
        shards.Rate = 300
        shards.Speed = NumberRange.new(60, 95)
        shards.SpreadAngle = Vector2.new(10, 10)
        shards.LightEmission = 1
        shards.Parent = snowBase
        
        task.delay(1.5, function()
            blizzard.Enabled = false
            shards.Enabled = false
            task.wait(4) -- Extra buffer so the SnowGrave sound finishes before destroying the part
            snowBase:Destroy()
        end)
    else
        local ring = Instance.new("Part")
        ring.Shape = Enum.PartType.Ball
        ring.Size = Vector3.new(1, 1, 1)
        ring.Position = position
        ring.Anchored = true
        ring.CanCollide = false
        ring.Material = Enum.Material.Neon
        ring.Color = Color3.fromRGB(80, 190, 255)
        ring.Transparency = 0.2
        ring.Parent = workspace
        
        -- Play IceShock sound at the burst location
        playSoundAtPart(SOUND_ICESHOCK, ring, 1.2)
        
        local targetSize = Vector3.new(radius * 2, radius * 2, radius * 2)
        local tween = TweenService:Create(ring, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = targetSize,
        Transparency = 1
        })
        tween:Play()
        tween.Completed:Connect(function()
            -- Keep the invisible part alive briefly if the sound is still playing
            ring.Transparency = 1
            task.wait(2)
            ring:Destroy()
        end)
    end
end

castEvent.OnServerEvent:Connect(function(player, spellName, targetPos)
    local casterChar = player.Character
    if not casterChar or typeof(targetPos) ~= "Vector3" then return end
    
    if spellName == "IceShock" then
        local radius = 8
        spawnSpellEffect(targetPos, radius, false)
        
        for _, model in ipairs(workspace:GetDescendants()) do
            if model:IsA("Model") and model ~= casterChar and model:FindFirstChildOfClass("Humanoid") then
                local root = model:FindFirstChild("HumanoidRootPart")
                if root and (root.Position - targetPos).Magnitude <= radius then
                    freezeCharacterForever(model)
                    break
                end
            end
        end
        
    elseif spellName == "SnowGrave" then
        local radius = 30
        spawnSpellEffect(targetPos, radius, true)
        
        for _, model in ipairs(workspace:GetDescendants()) do
            if model:IsA("Model") and model ~= casterChar and model:FindFirstChildOfClass("Humanoid") then
                local root = model:FindFirstChild("HumanoidRootPart")
                if root and (root.Position - targetPos).Magnitude <= radius then
                    freezeCharacterForever(model)
                end
            end
        end
    end
end)

]]></ProtectedString>
