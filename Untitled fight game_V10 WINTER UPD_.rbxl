<Item class="Script" referent="RBX66C1625455D04AC580D8117141513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">true</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Bomb</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Mine = script.Parent
local Center = Mine.Center
local Light = Center.PointLight

local SettledIn = false

local Run = game:GetService("RunService")
local Tween = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local NumSeq = NumberSequence.new
local NSKey = NumberSequenceKeypoint.new

local RunCo
local OnMoveCo
local Tick = 0

function Play(Sound)
    local N = Sound:Clone()
    N.Parent = Mine
    N:Play()
    N.Ended:Connect(function()
        N:Destroy()
    end)
end

function ShowState(t, tr, b, p)
    if t then
        Tween:Create(Mine, TweenInfo.new(t, Enum.EasingStyle.Sine), {Transparency = tr}):Play()
        Tween:Create(Light, TweenInfo.new(t, Enum.EasingStyle.Sine), {Brightness = b}):Play()
    end
    
    if p then
        for _, FX in Center:GetChildren() do
            if FX:IsA("ParticleEmitter") then
                FX.Enabled = p[1]
                FX.Size = p[2] or FX.Size
                FX.Transparency = p[3] or FX.Transparency
            end
        end
    end
end

RunCo = Run.Heartbeat:Connect(function(Delta)
    if not SettledIn then
        if Mine.AssemblyAngularVelocity.Magnitude < 0.2 then
            Tick += Delta 
            
            if Tick > 3 then
                ShowState(.5, 1, 0, {false})
                Mine.Reveal:Play()
                Mine.Rumble.Volume = 0
                
                SettledIn = true
            end
        else
            Tick = 0
        end
    else
        local DidHit = false
        local TillReappearance = math.random(4, 24)
        local LocalSeconds = 0
        
        local function Activate()
            DidHit = true
            
            ShowState(.2, 0, 5, {true})
            Mine.CanCollide = false
            Mine.Anchored = true
            Tween:Create(Mine, TweenInfo.new(.2, Enum.EasingStyle.Sine), {Size = Mine.Size * 2.5}):Play()
            
            task.wait(.2)
            
            ShowState(.1, 1, 0, {true, NumSeq(25), NumSeq(.85)})
            
            local Explosion = Instance.new("Explosion")
            Explosion:SetAttribute("Color", Color3.new(1, 0, 1))
            Explosion.BlastRadius = 25
            Explosion.Position = Mine.Position
            Explosion.Parent = workspace
            Explosion.DestroyJointRadiusPercent = 0
            
            Explosion.Hit:Connect(function(Hit)
                local Humanoid = Hit.Parent:FindFirstChildOfClass("Humanoid")
                
                if Humanoid then
                    if Humanoid == Mine.Owner.Value.Humanoid and Mine:GetAttribute("IsImmune") then
                        return
                    else
                        Humanoid:TakeDamage(250)
                    end
                end
                
                if not Hit:GetAttribute("OColor") then
                    Hit:SetAttribute("OColor", Hit.Color)
                end
                
                Tween:Create(Hit, TweenInfo.new(0.1), {Color = Color3.new(1, 0, 1)}):Play()
                
                delay(11, function()
                    Tween:Create(Hit, TweenInfo.new(20), {Color = Hit:GetAttribute("OColor")}):Play()
                end)
            end)
            
            for _, Sound in Mine.Explosions:GetChildren() do
                if Sound:IsA("Sound") then
                    Play(Sound)
                end
            end
            
            task.wait(12)
            
            ShowState(.5, 1, 0, {false})
            Debris:AddItem(Mine, 1)
        end
        
        Mine.Touched:Connect(function(Hit)
            local Humanoid = Hit.Parent:FindFirstChildOfClass("Humanoid")
            
            if (Humanoid or Hit:IsA("Explosion")) and not DidHit then
                Activate()
            end
        end)
        
        OnMoveCo = Run.Heartbeat:Connect(function(dt)
            if not DidHit then
                LocalSeconds += dt
                
                if LocalSeconds >= TillReappearance then
                    LocalSeconds = 0
                    Mine.Reveal:Play()
                    ShowState(.3, 0, 5, {true})
                    
                    task.wait(.3)
                    
                    ShowState(.3, 1, 0, {false})
                end
                
                if (Mine.AssemblyLinearVelocity.Magnitude > 10) then
                    Activate()
                end
            end
        end)
        
        RunCo:Disconnect()
    end
end)

]]></ProtectedString>
