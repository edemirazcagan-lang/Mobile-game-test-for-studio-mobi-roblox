<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local TeleportService = game:GetService("TeleportService")
local proximityPrompt = script.Parent:WaitForChild("ProximityPrompt")

-- REPLACE THIS WITH YOUR TARGET PLACE ID
local TARGET_PLACE_ID =   139487655508948

local function onPromptTriggered(player)
    -- Ensure the object triggering the prompt is a valid player
    if player then
        print("Teleporting " .. player.Name .. " to place " .. TARGET_PLACE_ID)
        
        local success, result = pcall(function()
            TeleportService:Teleport(TARGET_PLACE_ID, player)
        end)
        
        if not success then
            warn("Teleport failed: " .. tostring(result))
        end
    end
end

-- Listen for the player finishing the proximity prompt
proximityPrompt.Triggered:Connect(onPromptTriggered)

]]></ProtectedString>
