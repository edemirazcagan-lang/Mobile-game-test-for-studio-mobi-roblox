<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local tool = script.Parent
local Debris = game:GetService("Debris")
 
-- --- CONFIGURATION ---
local CLONE_DURATION = 15 -- How long the clone lasts (seconds)
local COOLDOWN = 10       -- Cooldown between uses (seconds)
local ATTACK_RANGE = 50   -- How far the clone looks for targets
local ATTACK_DAMAGE = 250  -- Damage dealt per hit
local ATTACK_SPEED = 0.8  -- Time between hits (seconds)
-- ---------------------
 
local onCooldown = false
 
-- Function to find the nearest valid target (NPC or other player)
local function findNearestTarget(clone, creator)
    local cloneRoot = clone:FindFirstChild("HumanoidRootPart")
    if not cloneRoot then return nil end
    
    local nearestTarget = nil
    local minDistance = ATTACK_RANGE
    
    -- Scan workspace for potential targets
    for _, desc in ipairs(workspace:GetDescendants()) do
        if desc:IsA("Humanoid") and desc.Parent ~= clone and desc.Parent ~= creator then
            local targetRoot = desc.Parent:FindFirstChild("HumanoidRootPart")
            if targetRoot and desc.Health > 0 then
                local distance = (cloneRoot.Position - targetRoot.Position).Magnitude
                if distance < minDistance then
                    minDistance = distance
                    nearestTarget = desc.Parent
                end
            end
        end
    end
    return nearestTarget
end
 
-- AI Behavior Logic for the Clone
local function controlClone(clone, creator)
    local humanoid = clone:FindFirstChildOfClass("Humanoid")
    local rootPart = clone:FindFirstChild("HumanoidRootPart")
    if not humanoid or not rootPart then return end
    
    local lastAttackTime = 0
    
    -- Loop to constantly track and attack targets
    task.spawn(function()
        while clone and clone:IsDescendantOf(workspace) and humanoid.Health > 0 do
            local target = findNearestTarget(clone, creator)
            
            if target then
                local targetHumanoid = target:FindFirstChildOfClass("Humanoid")
                local targetRoot = target:FindFirstChild("HumanoidRootPart")
                
                if targetHumanoid and targetRoot and targetHumanoid.Health > 0 then
                    -- Move clone toward target
                    humanoid:MoveTo(targetRoot.Position)
                    
                    -- Check if close enough to attack
                    local distance = (rootPart.Position - targetRoot.Position).Magnitude
                    if distance <= 5 then
                        if os.clock() - lastAttackTime >= ATTACK_SPEED then
                            targetHumanoid:TakeDamage(ATTACK_DAMAGE)
                            lastAttackTime = os.clock()
                            
                            -- Simple visual feedback: tilt clone slightly forward on attack
                            task.spawn(function()
                                rootPart.CFrame = rootPart.CFrame * CFrame.Angles(0.2, 0, 0)
                                task.wait(0.1)
                            end)
                        end
                    end
                end
            else
                -- No targets nearby, stand still or wander near creator
                local creatorRoot = creator:FindFirstChild("HumanoidRootPart")
                if creatorRoot then
                    humanoid:MoveTo(creatorRoot.Position + Vector3.new(math.random(-5, 5), 0, math.random(-5, 5)))
                end
            end
            task.wait(0.2) -- Loop frequency (optimized for performance)
        end
    end)
end
 
-- Activation Event
tool.Activated:Connect(function()
    local character = tool.Parent
    local player = game.Players:GetPlayerFromCharacter(character)
    if not player or onCooldown then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
    
    onCooldown = true
    
    -- 1. Create the Clone
    character.Archivable = true
    local clone = character:Clone()
    character.Archivable = false
    
    -- 2. Clean up clone properties
    if clone:FindFirstChild("CloneTool") then clone.CloneTool:Destroy() end -- Remove tool from clone
        
        local cloneHumanoid = clone:FindFirstChildOfClass("Humanoid")
        local cloneRoot = clone:FindFirstChild("HumanoidRootPart")
        
        if cloneHumanoid and cloneRoot then
            -- Differentiate clone visually (Optional: Semi-transparent/tinted)
            for _, part in ipairs(clone:GetChildren()) do
                if part:IsA("BasePart") then
                    part.CollisionGroup = "Debris" -- Optional: Prevents clone bumping into creator
                    -- Optional visual indicator:
                    part.Color = Color3.fromRGB(100, 200, 255) 
                end
            end
            
            -- Setup clone health/nametag
            cloneHumanoid.MaxHealth = humanoid.MaxHealth
            cloneHumanoid.Health = humanoid.Health
            clone.Name = player.Name .. "'s Clone"
            
            -- Position the clone slightly to the side of the player
            cloneRoot.CFrame = character.HumanoidRootPart.CFrame * CFrame.new(3, 0, 0)
            
            -- Spawn clone into workspace
            clone.Parent = workspace
            Debris:AddItem(clone, CLONE_DURATION) -- Auto-delete after duration
            
            -- 3. Start AI logic
            controlClone(clone, character)
        end
        
        -- 4. Cooldown management
        task.wait(COOLDOWN)
        onCooldown = false
    end)

]]></ProtectedString>
