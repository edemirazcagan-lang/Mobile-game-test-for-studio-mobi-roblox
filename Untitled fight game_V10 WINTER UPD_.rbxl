<Content name="LinkedSource"><null></null></Content>
<string name="Name">RespawnAndDestroyScript</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[------------------------------------------------------------------------------------------------------------------
--RespawnAndDestroyScript  -  This script's parent model/part will respawn in its original position             --
--                            if it moves a given distance, or is destroyed. It can also destroy it's parent    -- 
--                            if it stops moving for a given number of seconds, or it dies, or moves past       --
--                            the DestroyDistance child value.                                                  --
--   Child Values: RespawnDistance - Spawn a new object (script's parent) if the current object moves this      --
--                                   many studs from it's original position.  (Default is 20, size of a car).   --
--                 DestroyStopped  - Destroy the parent if it did move, but has stopped moving for this many    --
--                                   seconds.  (Default is 60).                                                 --
--                 DestroyDistance - Destroy the parent if it moves this many studs away from its original      --
--                                   position.  (Default is 3000, off the map).                                 --
--   Example 1: If a player drives a car away from it original position by more than 20 studs, spawn a new car  --
--              so other players can drive too.  In this case set the script child value RespawnDistance to 20. --
--              Also, cleanup abandoned cars if they stop moving for 60 seconds.  DestroyStopped = 60.          --
--   Example 2: You want zombies to respawn only when killed.  Set RespawnDistance to 3000.  This script        --
--              automatically destroys and respawns if the parent dies.                                         --
--   Example 3: You want multiple rising helix tornado parts to continuously spawn. See the CircleTweenScript.  --
--              Set RespawnDistance = 8, and DestroyDistance = 100.                                             --
--   Example 4: You want a tool to respawn in the workspace whenever someone picks it up.  Parent this script   --
--              inside the tool.  The script will use the tools Handle to determine it's position.              --
--              Set DestroyDistance = 99999, DestroyStopped = 99999, RespawnDistance = 10.                      --
--   You can put this script inside a model or a part.  Note, if you put it inside a part, only the part will   --
--   be respawned/destroyed, not other parts that might be welded to it.  So you should group all the welded    --
--   parts into a model and put this script inside the model.         --By ScottSpiritWalker, 12/20/2022.       --
------------------------------------------------------------------------------------------------------------------

local model = script.Parent	        --This refers to the parent model, tool or part that will respawn.
local modelParent = model.Parent
local backupCopy = model:Clone()    --Make a backup copy of the model for cloning a new copy.  The backup will also contain this script in it.
if model.ClassName == "Tool" and model:FindFirstChild("Handle") then   --In case it is a tool, use the Handle for position info.
	model = model.Handle
end
local originalPosition = model:GetPivot().Position        --Original position for distance comparison.
local previousPosition = originalPosition
script.Parent = modelParent			--Move this script out of the model, so if the model is destroyed, this script will keep running to spawn a new model before deleting itself.

--Get the children values that you can edit to control this script.
local RespawnDistance = script:WaitForChild("RespawnDistance").Value        --Spawn a copy if the original moves this far.
local DestroyStopped = script:WaitForChild("DestroyStopped").Value          --Destroy it if it moved, but has been stopped for this many seconds.
local DestroyDistance = script:WaitForChild("DestroyDistance").Value        --Destroy if it wanders off this many studs from its original postion.

local DestroyStoppedCountdown = DestroyStopped
local RespawnDistanceReached = false     --Only clone once.  The clone will make more.

while true do 				--Repeat the indented statements listed below over and over until the script is disabled or destroyed or the parent is destroyed. 
	task.wait(1)
	if model and model.Parent then          --model didn't get destroyed yet.
		if not RespawnDistanceReached and (model:GetPivot().Position - originalPosition).magnitude > RespawnDistance then  --model moved far enough away to spawn a new one in it's original locaction.
			backupCopy:Clone().Parent = modelParent
			RespawnDistanceReached = true    --This model's clone is out there making more clones.  So stop this script from making more every seconds.
		elseif (model:GetPivot().Position - originalPosition).magnitude > DestroyDistance then  --model moved past DestroyDistance.  Destroy it and don't respawn.  
			break                                                                               --If you did want it to respawn, set RespawnDistance slightly less.
		elseif model:FindFirstChild("Humanoid") and model.Humanoid.Health < 1 then    --Model is an NPC and health is < 0, so spawn new and destroy old.
			backupCopy:Clone().Parent = modelParent
			break
		elseif RespawnDistanceReached then		--moved far enough to spawn a replacement.
			if (model:GetPivot().Position - previousPosition).magnitude < .001 then  --but hasn't moved in the past one second.
				DestroyStoppedCountdown = DestroyStoppedCountdown - 1
				if DestroyStoppedCountdown <= 0 then      --It hasn't moved in the DestroyStopped time alloted.  Like a car that was abandoned for too long, clean it up. 
					break
				end
			else   
				DestroyStoppedCountdown = DestroyStopped    --It did move so reset the count down.
			end
		end
		previousPosition = model:GetPivot().Position    --Update previous position, and continue checking.
	else
		break		--model doen't exist, so destroy this script.
	end
end

if model and model.Parent then
	if model.Name == "Handle" and model.Parent.ClassName == "Tool" then
		model.Parent:Destroy()    --Destroy the tool.
	else
		model:Destroy()           --Destroy the model or part.
	end
end
script:Destroy()]]></ProtectedString>
