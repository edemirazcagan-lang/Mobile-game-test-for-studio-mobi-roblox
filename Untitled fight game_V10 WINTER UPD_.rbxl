<ProtectedString name="Source"><![CDATA[-- Made by SAGETHEGAMER Only customize the green text if you want to ;) Everything else is already done for you so its ready to go!
 
 
local tool = script.Parent
 
 
local event = tool:WaitForChild("RemoteEvent")
 
 
 
event.OnClientEvent:connect(function(...)
    local tuple = {...}
    if tuple[1] == "RunAnimation" then
        local anim = tool:FindFirstChild(tuple[2])
        if anim and humanoid then
            local loadedanim = humanoid:LoadAnimation(anim)
            if loadedanim then
                loadedanim:Play()
                if themouse then
                    themouse.Icon = "rbxasset://textures\\GunWaitCursor.png"  -- Change the Purple Writing to the mouse wait icon you want
                    wait(1) -- The number of seconds it takes to reload
                    themouse.Icon = "rbxasset://textures\\GunCursor.png" -- Change the Purple writing to the mouse icon you want (Must be the same as line 53)
                end
            end
        end
    end
end)
 
 
tool.Equipped:connect(function(mouse)
    themouse = mouse
    humanoid = tool.Parent:FindFirstChild("Humanoid")
    if humanoid then
        local anim = tool:FindFirstChild("IdleAnim3")
        if anim and humanoid then
            loadedidleanim = humanoid:LoadAnimation(anim)
            if loadedidleanim then
                loadedidleanim:Stop()
            end
            if loadedidleanim then
                loadedidleanim:Play()
            end
        end
        local anim = tool:FindFirstChild("EquipAnim5") -- Change EquipAnim5 to the animation that you want it to do when you equip the sword, or leave it like this
        if anim and humanoid then
            local loadedanim = humanoid:LoadAnimation(anim)
            if loadedanim then
                loadedanim:Play()
            end
        end
    end
    if themouse then
        themouse.Icon = "rbxasset://textures\\GunCursor.png" -- Change the Purple Writing to the mouse icon you want (Must be the same as line 22)
    end
end)
 
tool.Unequipped:connect(function()
    if loadedidleanim then
        loadedidleanim:Stop()
    end
    themouse.Icon = ""
end)

]]></ProtectedString>
