<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">LocalScript</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[-- LocalScript inside your Tool
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local tool = script.Parent
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Locate the custom UI button
local parryGui = playerGui:WaitForChild("ParryGui")
local parryButton = parryGui:WaitForChild("ParryButton")

-- RemoteEvent to communicate with the server
local ParryEvent = ReplicatedStorage:WaitForChild("ParryEvent")

local isParrying = false
local parryDuration = 10.4 -- How long the parry window lasts (in seconds)
local toolEquipped = false

-- The core function that triggers the parry action
local function triggerParry()
    if not isParrying and toolEquipped then
        isParrying = true
        
        -- Tell the server the player started parrying
        ParryEvent:FireServer("StartParry")
        
        -- Visual button press feedback (Changes background color of TextButton)
        parryButton.BackgroundColor3 = Color3.fromRGB(150, 150, 150) 
        
        task.wait(parryDuration)
        
        -- Reset button color and close window
        parryButton.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        ParryEvent:FireServer("StopParry")
        isParrying = false
    end -- <-- This closes the "if not isParrying and toolEquipped then" statement
end -- <-- This closes the "local function triggerParry()"

-- Listen for PC and Console inputs
UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
    if gameProcessedEvent then return end 
        
        if input.KeyCode == Enum.KeyCode.F or input.KeyCode == Enum.KeyCode.ButtonX then
            triggerParry()
        end
    end)
    
    -- Listen for the custom UI button press (Mobile/Mouse Click)
    parryButton.MouseButton1Down:Connect(function()
        triggerParry()
    end)
    
    -- Show the button when tool is equipped
    tool.Equipped:Connect(function()
        toolEquipped = true
        parryButton.Visible = true
    end)
    
    -- Hide the button when tool is unequipped
    tool.Unequipped:Connect(function()
        toolEquipped = false
        parryButton.Visible = false
        ParryEvent:FireServer("StopParry")
        isParrying = false
    end)

]]></ProtectedString>
