<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454115207AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">LocalScript</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local tool = script.Parent
local TextChatService = game:GetService("TextChatService")

local larpLines = {
"Exuse me sir! You cannot pierce my legendary larp!",
"Hah! Your powerless attacks barely hit my aura",
"By the power of the larp, I deny your blow!",
"An impressive strike... i screamed at the angels while being pushed through the door!",
"Foolish mortal! You cannot harm a  aura larper!"
}

local currentForceField = nil
local lastSpeechTime = 0
local SPEECH_COOLDOWN = 1 -- Prevents chat spam if they get hit rapidly

local function onEquipped()
    local character = tool.Parent
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    if character and humanoid then
        -- 1. Create an invisible ForceField for total damage immunity
        currentForceField = Instance.new("ForceField")
        currentForceField.Visible = false 
        currentForceField.Parent = character
        
        -- 2. Backup health monitor just in case
        local lastHealth = humanoid.Health
        _G.HealthConnection = humanoid.HealthChanged:Connect(function(currentHealth)
            if currentHealth < lastHealth then
                humanoid.Health = lastHealth -- Instantly restore health
                
                local now = os.clock()
                if now - lastSpeechTime > SPEECH_COOLDOWN then
                    lastSpeechTime = now
                    local player = game.Players:GetPlayerFromCharacter(character)
                    if player then
                        local randomLine = larpLines[math.random(1, #larpLines)]
                        local textChannel = TextChatService.TextChannels.RBXGeneral
                        textChannel:DisplaySystemMessage(string.format("[%s]: %s", player.Name, randomLine))
                    end
                end
            else
                lastHealth = currentHealth
            end
        end)
        
        -- 3. Detect physical hits to trigger LARP text when someone swings at them
        for _, part in ipairs(character:GetChildren()) do
            if part:IsA("BasePart") then
                part.Touched:Connect(function(otherPart)
                    if otherPart.Parent and otherPart.Parent:FindFirstChildOfClass("Humanoid") and otherPart.Parent ~= character then
                        local now = os.clock()
                        if now - lastSpeechTime > SPEECH_COOLDOWN then
                            lastSpeechTime = now
                            local player = game.Players:GetPlayerFromCharacter(character)
                            if player then
                                local randomLine = larpLines[math.random(1, #larpLines)]
                                local textChannel = TextChatService.TextChannels.RBXGeneral
                                textChannel:DisplaySystemMessage(string.format("[%s]: %s", player.Name, randomLine))
                            end
                        end
                    end
                end)
            end
        end -- Fixed loop closure
    end -- Fixed if closure
end

local function onUnequipped()
    -- Clean up ForceField
    if currentForceField then
        currentForceField:Destroy()
        currentForceField = nil
    end
    
    -- Clean up connections
    if _G.HealthConnection then
        _G.HealthConnection:Disconnect()
        _G.HealthConnection = nil
    end
end

tool.Equipped:Connect(onEquipped)
tool.Unequipped:Connect(onUnequipped)

]]></ProtectedString>
