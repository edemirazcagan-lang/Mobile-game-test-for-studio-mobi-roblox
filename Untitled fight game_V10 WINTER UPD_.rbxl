<Item class="Script" referent="RBX66C1625455D04AC580D8112405513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script4</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[-- Services
local Players = game:GetService("Players")

-- Variables
local humanoid = script.Parent
local rootPart = humanoid.Parent:WaitForChild("HumanoidRootPart")

-- Configuration
local PHASE_TWO_THRESHOLD = 0.5 -- 50% HP
local NEW_SPEED = 24            -- Normal default is 16
local AURA_RADIUS = 35         -- How close players need to be to take damage
local AURA_DAMAGE = 200          -- Damage dealt per second
local TICK_RATE = 1.0           -- How often damage is applied (in seconds)

-- State tracking
local phaseTwoActive = false

-- Function to handle the area-of-effect (AoE) damage
local function doAuraDamage()
    while phaseTwoActive do
        task.wait(TICK_RATE)
        
        -- Find all players in the server
        for _, player in ipairs(Players:GetPlayers()) do
            local character = player.Character
            if character and character:FindFirstChild("HumanoidRootPart") and character:FindFirstChild("Humanoid") then
                local targetHumanoid = character.Humanoid
                
                -- Check if the player is alive
                if targetHumanoid.Health > 0 then
                    -- Calculate distance between boss and player
                    local distance = (rootPart.Position - character.HumanoidRootPart.Position).Magnitude
                    
                    -- If within range, deal damage
                    if distance <= AURA_RADIUS then
                        targetHumanoid:TakeDamage(AURA_DAMAGE)
                    end
                end
            end
        end
    end
end

-- Function that checks health changes
local function onHealthChanged(currentHealth)
    local maxHealth = humanoid.MaxHealth
    
    -- Check if health is below 50% and phase 2 hasn't started yet
    if currentHealth <= (maxHealth * PHASE_TWO_THRESHOLD) and not phaseTwoActive then
        phaseTwoActive = true
        
        -- 1. Increase Speed
        humanoid.WalkSpeed = NEW_SPEED
        
        -- Optional: Add a visual indicator or sound here (e.g., boss turns red)
        if rootPart:FindFirstChildOfClass("ColorCorrectionEffect") == nil then
            -- You could trigger particles or animations here
            print(humanoid.Parent.Name .. " has entered Phase 2!")
        end
        
        -- 2. Start the passive damage aura in a separate thread so it doesn't block the game
        task.spawn(doAuraDamage)
    end
end

-- Connect the health changed event
humanoid.HealthChanged:Connect(onHealthChanged)

]]></ProtectedString>
