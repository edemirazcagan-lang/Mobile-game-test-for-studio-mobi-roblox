<Item class="Script" referent="RBX66C1625455D04AC580D8114687513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">PremiumScript</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local MarketPlaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

-- CONFIGURATION
local GAMEPASS_ID = 1890851893 -- Replace with your GamePass ID
local CUSTOM_CHARACTER_NAME = "VIP2Character" -- Name of the model in ReplicatedStorage

local TOOLS_TO_GIVE = {
"SubspaceTripmine",
"BloxyAward",
"Cloner"
"TimeAnchor"
} 
-- RemoteEvent for the button press
local ChangeCharacterEvent = ReplicatedStorage:FindFirstChild("ChangeCharacter2Event") or Instance.new("RemoteEvent")
ChangeCharacterEvent.Name = "ChangeCharacter2Event"
ChangeCharacterEvent.Parent = ReplicatedStorage

-- Function to create the overhead VIP Tag
local function createOverheadTag(character)
    local head = character:WaitForChild("Head", 5)
    if not head then return end
    
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "VIPTag"
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    
    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = "[ VIP ]"
    textLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
    textLabel.TextSize = 24
    textLabel.Font = Enum.Font.SourceSansBold
    textLabel.TextStrokeTransparency = 0
    
    textLabel.Parent = billboard
    billboard.Parent = head
end
 
-- Handle the character change request
ChangeCharacterEvent.OnServerEvent:Connect(function(player)
    local hasPass = false
    local success, err = pcall(function()
        hasPass = MarketPlaceService:UserOwnsGamePassAsync(player.UserId, GAMEPASS_ID)
    end)
    
    if success and hasPass then
        local customModel = ReplicatedStorage:FindFirstChild(CUSTOM_CHARACTER_NAME)
        
        if customModel and player.Character then
            local oldCharacter = player.Character
            local oldCFrame = oldCharacter:GetPivot()
            
            -- Find the default Roblox animation script from the old character
            local defaultAnimateScript = oldCharacter:FindFirstChild("Animate")
            
            -- Clone and setup new character
            local newCharacter = customModel:Clone()
            newCharacter.Name = player.Name
            
            -- Fix animations by transferring the Animate script
            if defaultAnimateScript then
                local animateClone = defaultAnimateScript:Clone()
                animateClone.Parent = newCharacter
            end
            
            player.Character = newCharacter
            newCharacter.Parent = workspace
            newCharacter:PivotTo(oldCFrame)
            
            oldCharacter:Destroy()
            
            -- Give VIP Overhead Tag
            createOverheadTag(newCharacter)
            
            -- Loop through the list and give every tool
            for _, toolName in ipairs(TOOLS_TO_GIVE) do
                local tool = ReplicatedStorage:FindFirstChild(toolName)
                if tool and tool:IsA("Tool") then
                    local toolClone = tool:Clone()
                    toolClone.Parent = player.Backpack
                else
                    warn("Could not find tool named: " .. toolName .. " in ReplicatedStorage")
                end
            end
        end
    else
        warn("Player does not own the GamePass or an error occurred.")
    end
end)

]]></ProtectedString>
