<Item class="Script" referent="RBX66C1625455D04AC580D8101067513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script2</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local boss = script.Parent
local body = boss:WaitForChild("HumanoidRootPart") -- The main part of the boss
local serverStorage = game:GetService("ServerStorage")
local minionTemplate = serverStorage:FindFirstChild("Minion2")
 
local maxMinions = 5
local cooldown = 3
local lastSummonTime = 0
local activeMinions = {}
 
-- Function to handle the summoning
local function summon()
    local currentTime = tick()
    if (currentTime - lastSummonTime) > cooldown and #activeMinions < maxMinions then
        lastSummonTime = currentTime
        
        local newMinion = minionTemplate:Clone()
        newMinion.Parent = game.Workspace
        newMinion:MoveTo(body.Position + Vector3.new(math.random(-10, 10), 0, math.random(-10, 10)))
        
        table.insert(activeMinions, newMinion)
        
        -- Remove from list when minion is destroyed
        newMinion.Humanoid.Died:Connect(function()
            for i, v in ipairs(activeMinions) do
                if v == newMinion then
                    table.remove(activeMinions, i)
                end
            end
        end)
    end
end
 
-- Detect when something hits the boss
body.Touched:Connect(function(hit)
    -- Check if the thing hitting the boss belongs to a player's tool or character
    if hit.Parent:FindFirstChild("Humanoid") or hit.Parent.Parent:FindFirstChild("Humanoid") then
        summon()
    end
end)
 

]]></ProtectedString>
