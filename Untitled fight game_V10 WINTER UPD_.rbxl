<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local tool = script.Parent
local healingAmount = 500    -- How much HP to restore per second
local maxHpIncrease = 652    -- How much MaxHealth to add per second
local checkRate = 1        -- Time interval in seconds
 
local isEquipped = false
 
-- Function that runs continuously while the tool is equipped
local function startIncrementing(character)
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    while isEquipped and humanoid.Health > 0 do
        -- Increase Max Health
        humanoid.MaxHealth = humanoid.MaxHealth + maxHpIncrease
        
        -- Heal the player (min ensures it doesn't accidentally exceed the new MaxHealth)
        humanoid.Health = math.min(humanoid.Health + healingAmount, humanoid.MaxHealth)
        
        task.wait(checkRate)
    end
end
 
-- Triggered when the player equips the tool
tool.Equipped:Connect(function()
    isEquipped = true
    local character = tool.Parent
    -- Run the loop in a separate thread so it doesn't freeze the script
    task.spawn(startIncrementing, character)
end)
 
-- Triggered when the player unqueips or drops the tool
tool.Unequipped:Connect(function()
    isEquipped = false
end)

]]></ProtectedString>
