<Item class="Script" referent="RBX66C1625455D04AC580D8114681513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">KScript</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[--[[
KillstreakSwordServer.lua
Place as a Script inside ServerScriptService.
 
Expects a Tool named "Killstreak Sword" with a "Handle" (Part) somewhere
the player can obtain it (StarterPack / ServerStorage clone, etc).
 
Creates two RemoteEvents under ReplicatedStorage/KillstreakSwordRemotes:
- LaserRequest   (client -> server, fired when player uses laser ability)
- EffectFire     (server -> client, tells client to play a visual/sound effect)
 
All combat math, kill validation, and buffs are computed SERVER SIDE.
Client never decides damage/kills — only sends input requests.
]]
 
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")
 
----------------------------------------------------------------------
-- CONFIG
----------------------------------------------------------------------
local CFG = {
ToolName = "Killstreak Sword",
BaseDamage = 25,
BaseKnockback = 29,          -- studs/sec impulse applied to victim
HitDebounce = 0.9,           -- per-victim debounce so one swing doesn't multi-hit
AuraTickRate = 0.25,         -- how often the "aura" (slow nearby enemies) updates
LaserRange = 126,
LaserCooldown = 6,
 
-- Ordered ascending. GetTier() picks the highest threshold <= kills.
Tiers = {
[0] = {
dmgMult = 1,   kbMult = 1,
},
[10] = {
dmgMult = 1.35, kbMult = 1.4,
},
[25] = {
dmgMult = 1.7,  kbMult = 1.7,  walkAdd = 4,
},
[50] = {
dmgMult = 2.1,  kbMult = 2.1,  walkAdd = 6,
aura = { radius = 10, slowFactor = 0.5 },  -- victims speed is multiplied by slowFactor
sparkles = true, burn = true,
},
[100] = {
dmgMult = 4,    kbMult = 4,    walkAdd = 14, jumpAdd = 20,
aura = { radius = 12, slowFactor = 0.25 },
highlight = true,
laser = { enabled = true, dmg = 40 },
},
[150] = {
-- less damage but same knockback as 100, wielder is slowed a bit,
-- jumps slightly lower than 100, aura can't slow as much, laser buffed
dmgMult = 3,    kbMult = 4,    walkAdd = 9,  jumpAdd = 15,
aura = { radius = 12, slowFactor = 0.45 },
highlight = true,
laser = { enabled = true, dmg = 65 },
},
[200] = {
-- same as 100 but buffed further
dmgMult = 6,    kbMult = 6,    walkAdd = 20, jumpAdd = 26,
aura = { radius = 14, slowFactor = 0.15 },
highlight = true,
sparkles = true, burn = true,
laser = { enabled = true, dmg = 90 },
},
[250] = {
oneShot = true, kbMult = 10,   walkAdd = 40, jumpAdd = 40,
aura = { radius = 18, forceWalkSpeed = 6 }, -- nearby enemies forced to 6 walkspeed
highlight = true,
sparkles = true, burn = true,
fly = true, noWalk = true,
laser = { enabled = true, dmg = 120 },
},
},
}
 
----------------------------------------------------------------------
-- REMOTES
----------------------------------------------------------------------
local remotesFolder = ReplicatedStorage:FindFirstChild("KillstreakSwordRemotes")
if not remotesFolder then
    remotesFolder = Instance.new("Folder")
    remotesFolder.Name = "KillstreakSwordRemotes"
    remotesFolder.Parent = ReplicatedStorage
end
 
local function getOrCreateRemote(name)
    local r = remotesFolder:FindFirstChild(name)
    if not r then
        r = Instance.new("RemoteEvent")
        r.Name = name
        r.Parent = remotesFolder
    end
    return r
end
 
local LaserRequest = getOrCreateRemote("LaserRequest")
local EffectFire = getOrCreateRemote("EffectFire")
local FlyInput = getOrCreateRemote("FlyInput")
 
----------------------------------------------------------------------
-- HELPERS
----------------------------------------------------------------------
 
-- Returns the tier table for the highest threshold <= kills, plus threshold number
local function getTier(kills)
    local best, bestKey = CFG.Tiers[0], 0
    for threshold, data in pairs(CFG.Tiers) do
        if kills >= threshold and threshold >= bestKey then
            best, bestKey = data, threshold
        end
    end
    return best, bestKey
end
 
local function getKillstreak(player)
    return player:GetAttribute("Killstreak") or 0
end
 
local function setKillstreak(player, value)
    player:SetAttribute("Killstreak", value)
end
 
-- Apply movement / jump / fly buffs for the wielder based on their current tier
local function applyWielderBuffs(player)
    local char = player.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    local kills = getKillstreak(player)
    local tier = getTier(kills)
    
    humanoid.WalkSpeed = 16 + (tier.walkAdd or 0)
    humanoid.JumpPower = 50 + (tier.jumpAdd or 0)
    
    -- Fly (tier 250): horizontal movement comes from the humanoid's own
    -- WalkSpeed (kept high, not zeroed) so normal WASD/joystick/stick input
    -- still works while airborne -- that's what makes it feel like flying
    -- instead of "anchored." Only vertical hold/lift/descend is handled by
    -- a Y-axis-only BodyVelocity, driven by simple up/down key events.
    local existingFlyVel = char:FindFirstChild("KillstreakFlightVelocity")
    if tier.fly then
        humanoid.WalkSpeed = math.max(humanoid.WalkSpeed, 45) -- fast horizontal glide
        local root = char:FindFirstChild("HumanoidRootPart")
        if root and not existingFlyVel then
            local bodyVel = Instance.new("BodyVelocity")
            bodyVel.Name = "KillstreakFlightVelocity"
            bodyVel.MaxForce = Vector3.new(0, math.huge, 0) -- Y axis only; X/Z stay under humanoid control
            bodyVel.Velocity = Vector3.new(0, 0, 0) -- hover in place vertically until player presses up/down
            bodyVel.P = 1250
            bodyVel.Parent = root
        end
        humanoid.PlatformStand = false
        player:SetAttribute("KillstreakFlying", true)
    else
        if existingFlyVel then existingFlyVel:Destroy() end
        humanoid.PlatformStand = false
        player:SetAttribute("KillstreakFlying", false)
    end
    
    -- Sparkles / burn cosmetic loop on the wielder
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        local sparkle = root:FindFirstChild("KillstreakSparkle")
        if tier.sparkles then
            if not sparkle then
                sparkle = Instance.new("Sparkles")
                sparkle.Name = "KillstreakSparkle"
                sparkle.Parent = root
            end
        elseif sparkle then
            sparkle:Destroy()
        end
        
        local fire = root:FindFirstChild("KillstreakBurn")
        if tier.burn then
            if not fire then
                fire = Instance.new("Fire")
                fire.Name = "KillstreakBurn"
                fire.Heat = 8
                fire.Size = 6
                fire.Parent = root
            end
        elseif fire then
            fire:Destroy()
        end
        
        -- Highlight
        local highlight = root:FindFirstChild("KillstreakHighlight")
        if tier.highlight then
            if not highlight then
                highlight = Instance.new("Highlight")
                highlight.Name = "KillstreakHighlight"
                highlight.FillTransparency = 0.6
                highlight.OutlineColor = Color3.fromRGB(255, 60, 60)
                highlight.Parent = char
            end
        elseif highlight then
            highlight:Destroy()
        end
    end
end
 
-- Reset wielder to default state (called on death / dropping the tool)
local function resetWielderState(player)
    local char = player.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.WalkSpeed = 16
        humanoid.JumpPower = 50
        humanoid.PlatformStand = false
    end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        for _, n in ipairs({"KillstreakFlightVelocity", "KillstreakSparkle", "KillstreakBurn"}) do
            local inst = root:FindFirstChild(n)
            if inst then inst:Destroy() end
        end
    end
    player:SetAttribute("KillstreakFlying", false)
    local hl = char:FindFirstChild("KillstreakHighlight")
    if hl then hl:Destroy() end
end
 
----------------------------------------------------------------------
-- PER-TOOL SETUP
----------------------------------------------------------------------
local function setupTool(tool)
    if tool.Name ~= CFG.ToolName then return end
    -- GUARD: tools re-enter workspace every time they're equipped (Backpack -> Character).
    -- Without this, setupTool would run again each equip and stack duplicate
    -- Touched/Equipped/Unequipped connections, which is what caused the
    -- slowdown/"script dies after a while" behavior.
    if tool:GetAttribute("KSSetupDone") then return end
    tool:SetAttribute("KSSetupDone", true)
    
    local handle = tool:WaitForChild("Handle")
    
    local debounceTable = {} -- [victimHumanoid] = true while on cooldown
    local equippedPlayer = nil
    local auraConnection = nil
    local lastLaser = 0
    local lastGlobalHitCheck = 0
    local GLOBAL_HIT_THROTTLE = 0.05 -- max ~20 hit-checks/sec regardless of how many parts touch
    
    local function getWielder()
        local char = tool.Parent
        if char and Players:GetPlayerFromCharacter(char) then
            return Players:GetPlayerFromCharacter(char)
        end
        return nil
    end
    
    -- Melee hit detection
    local function onTouched(hit)
        local now = os.clock()
        if now - lastGlobalHitCheck < GLOBAL_HIT_THROTTLE then return end
        lastGlobalHitCheck = now
        
        local wielder = getWielder()
        if not wielder then return end
        local victimChar = hit:FindFirstAncestorOfClass("Model")
        if not victimChar then return end
        local victimHumanoid = victimChar:FindFirstChildOfClass("Humanoid")
        if not victimHumanoid or victimHumanoid.Health <= 0 then return end
        if victimChar == wielder.Character then return end -- no self hit
            if debounceTable[victimHumanoid] then return end
            
            debounceTable[victimHumanoid] = true
            task.delay(CFG.HitDebounce, function()
                debounceTable[victimHumanoid] = nil
            end)
            
            local kills = getKillstreak(wielder)
            local tier = getTier(kills)
            
            local damage = tier.oneShot and math.huge or (CFG.BaseDamage * (tier.dmgMult or 1))
            local kbForce = CFG.BaseKnockback * (tier.kbMult or 1)
            
            -- Determine kill BEFORE damaging (so we know if this hit finishes them)
            local willKill = victimHumanoid.Health - damage <= 0
            
            victimHumanoid:TakeDamage(damage)
            
            -- Knockback
            local victimRoot = victimChar:FindFirstChild("HumanoidRootPart")
            local wielderRoot = wielder.Character and wielder.Character:FindFirstChild("HumanoidRootPart")
            if victimRoot and wielderRoot then
                local dir = (victimRoot.Position - wielderRoot.Position)
                dir = (dir.Magnitude > 0) and dir.Unit or Vector3.new(0, 0, 1)
                local bodyVel = Instance.new("BodyVelocity")
                bodyVel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bodyVel.Velocity = (dir * kbForce) + Vector3.new(0, kbForce * 0.35, 0)
                bodyVel.Parent = victimRoot
                Debris:AddItem(bodyVel, 0.25)
            end
            
            if willKill then
                local newKills = kills + 1
                setKillstreak(wielder, newKills)
                applyWielderBuffs(wielder)
                EffectFire:FireClient(wielder, "KillFeedback", newKills)
            end
        end
        handle.Touched:Connect(onTouched)
        
        -- Equip: track wielder, start aura loop
        tool.Equipped:Connect(function()
            local wielder = getWielder()
            equippedPlayer = wielder
            if not wielder then return end
            
            applyWielderBuffs(wielder)
            
            auraConnection = task.spawn(function()
                while tool.Parent and tool:IsDescendantOf(game) and equippedPlayer == wielder do
                    local kills = getKillstreak(wielder)
                    local tier = getTier(kills)
                    if tier.aura then
                        local root = wielder.Character and wielder.Character:FindFirstChild("HumanoidRootPart")
                        if root then
                            for _, otherPlayer in ipairs(Players:GetPlayers()) do
                                if otherPlayer ~= wielder and otherPlayer.Character then
                                    local otherHum = otherPlayer.Character:FindFirstChildOfClass("Humanoid")
                                    local otherRoot = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
                                    if otherHum and otherRoot and otherHum.Health > 0 then
                                        local dist = (otherRoot.Position - root.Position).Magnitude
                                        if dist <= tier.aura.radius then
                                            if tier.aura.forceWalkSpeed then
                                                otherHum.WalkSpeed = tier.aura.forceWalkSpeed
                                            elseif tier.aura.slowFactor then
                                                otherHum.WalkSpeed = 16 * tier.aura.slowFactor
                                            end
                                            otherHum:SetAttribute("KillstreakSlowed", true)
                                        elseif otherHum:GetAttribute("KillstreakSlowed") then
                                            otherHum.WalkSpeed = 16
                                            otherHum:SetAttribute("KillstreakSlowed", false)
                                        end
                                    end
                                end
                            end
                        end
                    end
                    task.wait(CFG.AuraTickRate)
                end
            end)
        end)
        
        tool.Unequipped:Connect(function()
            local wielder = equippedPlayer
            equippedPlayer = nil
            if wielder then
                resetWielderState(wielder)
            end
        end)
    end
    
    for _, tool in ipairs(workspace:GetDescendants()) do
        if tool:IsA("Tool") then
            setupTool(tool)
        end
    end
    workspace.DescendantAdded:Connect(function(inst)
        if inst:IsA("Tool") then
            setupTool(inst)
        end
    end)
    Players.PlayerAdded:Connect(function(player)
        player.CharacterAdded:Connect(function(char)
            for _, tool in ipairs(char:GetChildren()) do
                if tool:IsA("Tool") then
                    setupTool(tool)
                end
            end
        end)
    end)
    
    ----------------------------------------------------------------------
    -- LASER ABILITY (server-validated)
    ----------------------------------------------------------------------
    LaserRequest.OnServerEvent:Connect(function(player)
        local ok, err = pcall(function()
            local char = player.Character
            if not char then return end
            local tool = char:FindFirstChild(CFG.ToolName)
            if not tool then return end -- must be holding the sword
                local root = char:FindFirstChild("HumanoidRootPart")
                if not root then return end
                
                local kills = getKillstreak(player)
                local tier = getTier(kills)
                if not (tier.laser and tier.laser.enabled) then
                    EffectFire:FireClient(player, "LaserDenied", "Reach a killstreak with laser unlocked (100+).")
                    return
                end
                
                local now = os.clock()
                local lastFire = player:GetAttribute("_LastLaserFire") or 0
                if now - lastFire < CFG.LaserCooldown then
                    EffectFire:FireClient(player, "LaserDenied", "Laser on cooldown.")
                    return
                end
                -- Set attribute AFTER all validation passes so a failed/denied attempt
                -- never locks out the real cooldown timer (this was the "one time use" bug).
                player:SetAttribute("_LastLaserFire", now)
                
                local origin = root.Position
                local direction = root.CFrame.LookVector * CFG.LaserRange
                
                local params = RaycastParams.new()
                params.FilterType = Enum.RaycastFilterType.Exclude
                params.FilterDescendantsInstances = { char }
                
                local result = workspace:Raycast(origin, direction, params)
                local endPoint = result and result.Position or (origin + direction)
                
                -- Damage ANY humanoid in the corridor (players AND NPCs/dummies),
                -- not just Players:GetPlayers() -- that was why it "didn't damage" anything.
                local hitSomething = false
                for _, model in ipairs(workspace:GetDescendants()) do
                    if model:IsA("Model") and model ~= char then
                        local otherHum = model:FindFirstChildOfClass("Humanoid")
                        local otherRoot = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                        if otherHum and otherRoot and otherHum.Health > 0 then
                            local toOther = otherRoot.Position - origin
                            local along = toOther:Dot(root.CFrame.LookVector)
                            if along > 0 and along <= CFG.LaserRange then
                                local closestPoint = origin + root.CFrame.LookVector * along
                                local perpDist = (otherRoot.Position - closestPoint).Magnitude
                                if perpDist <= 5 then
                                    hitSomething = true
                                    local dmg = tier.oneShot and math.huge or tier.laser.dmg
                                    local willKill = otherHum.Health - dmg <= 0
                                    otherHum:TakeDamage(dmg)
                                    if willKill then
                                        local otherPlayer = Players:GetPlayerFromCharacter(model)
                                        local newKills = kills + 1
                                        setKillstreak(player, newKills)
                                        applyWielderBuffs(player)
                                    end
                                end
                            end
                        end
                    end
                end
                
                EffectFire:FireAllClients("LaserBeam", { origin = origin, endPoint = endPoint })
            end)
            
            if not ok then
                warn("[KillstreakSword] Laser error:", err)
                -- Do NOT leave the cooldown attribute in a bad state on error
                player:SetAttribute("_LastLaserFire", 0)
            end
        end)
        
        ----------------------------------------------------------------------
        -- FLY VERTICAL CONTROL (tier 250) -- client fires this only when the
        -- up/down input state CHANGES (key pressed/released), not every frame,
        -- so there's no per-frame remote spam to throttle in the first place.
        ----------------------------------------------------------------------
        local FLY_LIFT_SPEED = 45
        
        FlyInput.OnServerEvent:Connect(function(player, verticalValue)
            if not player:GetAttribute("KillstreakFlying") then return end
            if typeof(verticalValue) ~= "number" then return end
            verticalValue = math.clamp(verticalValue, -1, 1)
            
            local char = player.Character
            if not char then return end
            local root = char:FindFirstChild("HumanoidRootPart")
            if not root then return end
            
            local bodyVel = root:FindFirstChild("KillstreakFlightVelocity")
            if bodyVel then
                bodyVel.Velocity = Vector3.new(0, verticalValue * FLY_LIFT_SPEED, 0)
            end
        end)
        
        
        Players.PlayerAdded:Connect(function(player)
            setKillstreak(player, 0)
            player.CharacterAdded:Connect(function(char)
                local humanoid = char:WaitForChild("Humanoid")
                humanoid.Died:Connect(function()
                    setKillstreak(player, 0)
                end)
            end)
        end)

]]></ProtectedString>
