<Item class="Script" referent="RBX66C1625455D04AC580D8115345513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script3</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local tool = script.Parent

-- CONFIGURATION
local COOLDOWN_TIME = 15
local INVINCIBLE_TIME = 3
local PC_KEY = Enum.KeyCode.E
local CONSOLE_KEY = Enum.KeyCode.ButtonX

local isCooldown = false
local isEquipped = false
local screenGui = nil
local inputConnection = nil

-- Function to handle the invincibility logic
local function triggerInvincibility()
    local character = player.Character
    if not character then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
    
    isCooldown = true
    
    -- 1. Create a ForceField visual effect
    local forceField = Instance.new("ForceField")
    forceField.Visible = true
        forceField.Parent = character
            
            -- 2. Lock health locally to prevent damage
            local currentHealth = humanoid.Health
            local healthConnection
            healthConnection = humanoid.HealthChanged:Connect(function(newHealth)
                if newHealth < currentHealth then
                    humanoid.Health = currentHealth
                else
                    currentHealth = newHealth -- Allow healing
                end
            end)
            
            -- Character fading effect
            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    TweenService:Create(part, TweenInfo.new(0.3), {LocalTransparencyModifier = 0.4}):Play()
                end
            end
            
            -- Update UI button visibility if it exists to indicate it's active
            if screenGui and screenGui:FindFirstChild("AbilityButton") then
                screenGui.AbilityButton.ImageColor3 = Color3.fromRGB(100, 100, 100)
            end
            
            task.wait(INVINCIBLE_TIME)
            
            -- Clean up invincibility locks
            if healthConnection then healthConnection:Disconnect() end
            if forceField then forceField:Destroy() end
            
            -- Restore original visibility
            if character and character.Parent then
                for _, part in ipairs(character:GetDescendants()) do
                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                        TweenService:Create(part, TweenInfo.new(0.3), {LocalTransparencyModifier = 0}):Play()
                    end
                end
            end
            
            -- Cooldown visual state change
            if screenGui and screenGui:FindFirstChild("AbilityButton") then
                screenGui.AbilityButton.ImageColor3 = Color3.fromRGB(255, 50, 50) -- Red for cooldown
            end
            
            task.wait(COOLDOWN_TIME - INVINCIBLE_TIME)
            
            -- Restore button appearance when ready
            if screenGui and screenGui:FindFirstChild("AbilityButton") then
                screenGui.AbilityButton.ImageColor3 = Color3.fromRGB(255, 255, 255)
            end
            isCooldown = false
        end
        
        -- Core input validation
        local function attemptActivation()
            if not isCooldown and isEquipped then
                triggerInvincibility()
            end
        end
        
        -- Creates a dynamic, modern Mobile Action Button
        local function createMobileUI()
            -- Clean up any rogue UI copies first
            if player.PlayerGui:FindFirstChild("ToolAbilityGui") then
                player.PlayerGui.ToolAbilityGui:Destroy()
            end
            
            screenGui = Instance.new("ScreenGui")
            screenGui.Name = "ToolAbilityGui"
            screenGui.ResetOnSpawn = false
            
            local button = Instance.new("ImageButton")
            button.Name = "AbilityButton"
            button.Size = UDim2.new(0, 70, 0, 70)
            -- Placed safely on the bottom right side of mobile viewports
            button.Position = UDim2.new(0.75, 0, 0.6, 0) 
            button.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
            button.BackgroundTransparency = 0.3
            button.Image = "rbxassetid://122709214741369" -- Clean modern action icon asset
            button.ImageColor3 = isCooldown and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(255, 255, 255)
            
            -- Round the corners out beautifully
            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0.5, 0)
            corner.Parent = button
            
            -- Add text label
            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, 0, 1, 0)
            label.BackgroundTransparency = 1
            label.Text = "Block"
            label.TextColor3 = Color3.fromRGB(255, 255, 255)
            label.TextSize = 14
            label.Font = Enum.Font.SourceSansBold
            label.Parent = button
            
            button.MouseButton1Click:Connect(attemptActivation)
            button.Parent = screenGui
            screenGui.Parent = player.PlayerGui
        end
        
        -- Completely destroys the UI layer when dropping/switching tools
        local function destroyMobileUI()
            if screenGui then
                screenGui:Destroy()
                screenGui = nil
            end
        end
        
        -- Equip Handler
        tool.Equipped:Connect(function()
            isEquipped = true
            
            -- Setup PC / Console listeners manually 
            inputConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
                if gameProcessed then return end
                if input.KeyCode == PC_KEY or input.KeyCode == CONSOLE_KEY then
                    attemptActivation()
                end
            end)
            
            -- Setup Mobile UI layer only if a touch screen is present
            if UserInputService.TouchEnabled then
                createMobileUI()
            end
        end)
        
        -- Unequip Handler
        tool.Unequipped:Connect(function()
            isEquipped = false
            if inputConnection then
                inputConnection:Disconnect()
                inputConnection = nil
            end
            destroyMobileUI()
        end)
        
        -- Destructor hooks to safeguard tool deletion errors
        tool.Destroying:Connect(function()
            isEquipped = false
            if inputConnection then inputConnection:Disconnect() end
            destroyMobileUI()
        end)
        
        script.Destroying:Connect(function()
            isEquipped = false
            if inputConnection then inputConnection:Disconnect() end
            destroyMobileUI()
        end)

]]></ProtectedString>
