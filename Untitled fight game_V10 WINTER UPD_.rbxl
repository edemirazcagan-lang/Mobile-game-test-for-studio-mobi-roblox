<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454115435AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">LocalScript</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ContextActionService = game:GetService("ContextActionService")

local player = Players.LocalPlayer
local tool = script.Parent

-- Configuration
local DASH_FORCE = 90
local DASH_DURATION = 3
local DASH_COOLDOWN = 1.5
local DASH_DAMAGE = 1000
local DASH_KNOCKBACK = 200

local SLIDE_SPEED = 90
local SLIDE_DURATION = 0.5
local SLIDE_COOLDOWN = 2
local SLIDE_HEIGHT = 3

-- State variables
local canDash = true
local canSlide = true
local isSliding = false
local toolEquipped = false

local DASH_ACTION = "ToolDashAction"
local SLIDE_ACTION = "ToolSlideAction"

-- --- Helper Functions ---

local function checkDashHit(character, rootPart)
    local overlapParams = OverlapParams.new()
    overlapParams.FilterDescendantsInstances = {character}
    overlapParams.FilterType = Enum.RaycastFilterType.Exclude
    
    local hitBoxSize = Vector3.new(6, 5, 6)
    local hitBoxCFrame = rootPart.CFrame * CFrame.new(0, 0, -3)
    
    local hitParts = workspace:GetPartBoundsInBox(hitBoxCFrame, hitBoxSize, overlapParams)
    local hitHumanoids = {}
    
    for _, part in ipairs(hitParts) do
        local model = part.Parent
        local targetHumanoid = model:FindFirstChildOfClass("Humanoid")
        local targetRoot = model:FindFirstChild("HumanoidRootPart")
        
        if targetHumanoid and targetRoot and not hitHumanoids[targetHumanoid] then
            hitHumanoids[targetHumanoid] = true
            
            targetHumanoid:TakeDamage(DASH_DAMAGE)
            
            local knockbackDirection = (targetRoot.Position - rootPart.Position).Unit
            knockbackDirection = Vector3.new(knockbackDirection.X, 0.2, knockbackDirection.Z).Unit
            
            local bv = Instance.new("LinearVelocity")
            bv.MaxForce = math.huge
            bv.VectorVelocity = knockbackDirection * DASH_KNOCKBACK
            
            local attachment = Instance.new("Attachment")
            attachment.Parent = targetRoot
            bv.Attachment0 = attachment
            bv.Parent = targetRoot
            
            game:GetService("Debris"):AddItem(bv, 0.25)
            game:GetService("Debris"):AddItem(attachment, 0.25)
        end
    end
end

-- --- Core Actions ---

local function performDash()
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not character or not humanoid or not rootPart then return end
    
    if not canDash or isSliding then return end
    canDash = false
    
    local moveDirection = humanoid.MoveDirection
    if moveDirection.Magnitude == 0 then
        moveDirection = rootPart.CFrame.LookVector
    end
    
    local bv = Instance.new("LinearVelocity")
    bv.MaxForce = math.huge
    bv.VectorVelocity = Vector3.new(moveDirection.X, 0, moveDirection.Z).Unit * DASH_FORCE
    
    local attachment = Instance.new("Attachment")
    attachment.Parent = rootPart
    bv.Attachment0 = attachment
    bv.Parent = rootPart
    
    local startTime = os.clock()
    local hitConnection
    hitConnection = game:GetService("RunService").Heartbeat:Connect(function()
        if os.clock() - startTime < DASH_DURATION then
            checkDashHit(character, rootPart)
        else
            hitConnection:Disconnect()
        end
    end)
    
    task.wait(DASH_DURATION)
    bv:Destroy()
    attachment:Destroy()
    
    task.wait(DASH_COOLDOWN)
    canDash = true
end

local function performSlide()
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not character or not humanoid or not rootPart then return end
    
    if not canSlide or isSliding or humanoid.MoveDirection.Magnitude == 0 then return end 
        
        canSlide = false
        isSliding = true
        
        local slideDirection = humanoid.MoveDirection
        local originalHipHeight = humanoid.HipHeight
        humanoid.HipHeight = SLIDE_HEIGHT
        
        local bv = Instance.new("LinearVelocity")
        bv.MaxForce = math.huge
        bv.VectorVelocity = Vector3.new(slideDirection.X, 0, slideDirection.Z).Unit * SLIDE_SPEED
        
        local attachment = Instance.new("Attachment")
        attachment.Parent = rootPart
        bv.Attachment0 = attachment
        bv.Parent = rootPart
        
        task.wait(SLIDE_DURATION)
        
        bv:Destroy()
        attachment:Destroy()
        humanoid.HipHeight = originalHipHeight
        isSliding = false
        
        task.wait(SLIDE_COOLDOWN)
        canSlide = true
    end
    
    local function handleAction(actionName, inputState, inputObject)
        if inputState ~= Enum.UserInputState.Begin then return end
        if not toolEquipped then return end
        
        if actionName == DASH_ACTION then
            performDash()
        elseif actionName == SLIDE_ACTION then
            performSlide()
        end
    end
    
    -- --- Tool Bindings ---
    
    tool.Equipped:Connect(function()
        toolEquipped = true
        
        -- Bind controls dynamically (PC, Console, and Mobile setup)
        ContextActionService:BindAction(DASH_ACTION, handleAction, true, Enum.KeyCode.R, Enum.KeyCode.ButtonX)
        ContextActionService:BindAction(SLIDE_ACTION, handleAction, true, Enum.KeyCode.C, Enum.KeyCode.ButtonY)
        
        ContextActionService:SetTitle(DASH_ACTION, "Dash")
        ContextActionService:SetTitle(SLIDE_ACTION, "Slide")
    end)
    
    tool.Unequipped:Connect(function()
        toolEquipped = false
        ContextActionService:UnbindAction(DASH_ACTION)
        ContextActionService:UnbindAction(SLIDE_ACTION)
    end)

]]></ProtectedString>
